/**
 * 全局样式与设计令牌。
 * 岭南红与校徽金沿用项目确定的品牌色；纸白底、清晰分区和方正轮廓构成本次全模块改版。
 * 令牌引用必须带相同字面回退值，见 tests/wxss.test.cjs。
 */
page {
  --brand: #c41c23;
  --brand-deep: #8c1614;
  --brand-ink: #7a1a12;
  --gold: #c69a28;
  --gold-deep: #a67f1c;
  --paper: #fdf7f5;
  --paper-shade: #faeee9;

  --text: #2b2422;
  --text-2: #6b5d57;
  --text-3: #746760;

  /* Legacy design tokens remain available to the archived timetable mockups; active page styles do not use glass. */
  --glass: rgba(255,255,255,0.52);
  --glass-strong: rgba(255,255,255,0.72);
  --glass-edge: rgba(255,255,255,0.92);
  --glass-line: rgba(255,255,255,0.62);
  --glass-divide: rgba(255,255,255,0.70);
  --glass-drop: rgba(92,28,26,0.13);
  --glass-drop-strong: rgba(140,22,20,0.26);
  --glass-blur: 16px;
  --r-chip: 12rpx;
  --r-control: 20rpx;
  --r-card: 24rpx;
  --r-panel: 32rpx;
  --r-pill: 999rpx;

  --warn: #9a5b1e;
  --warn-soft: rgba(255,244,228,0.86);
  --warn-line: rgba(214,160,90,0.55);

  /* 课程颜色由 services/timetable/palette.ts 提供，以下仅为内联槽失效时的兜底。 */
  --blk-tint: rgba(255,255,255,0.72);
  --blk-line: rgba(255,255,255,0.62);
  --blk-solid: rgba(148,134,127,0.55);

  background: var(--paper, #fdf7f5);
  color: var(--text, #2b2422);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view, button { box-sizing: border-box; }
button { margin: 0; padding: 0; font: inherit; color: inherit; background: transparent; }
button::after { border: 0; }
.page { padding: 42rpx 36rpx 70rpx; padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: var(--text-3, #746760); font-size: 23rpx; line-height: 1.45; }
.section-title { font-size: 32rpx; line-height: 1.4; font-weight: 700; color: var(--brand-deep, #8c1614); }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 0 14rpx; }
.section-bar { width: 6rpx; height: 30rpx; flex:none; background: var(--gold, #c69a28); margin-right: 16rpx; }
.section-head .section-title { flex: 1; }
.pressed { opacity: 0.72; }

.status-page { padding-top: 100rpx; }
.status-icon {
  width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center;
  margin-bottom: 36rpx; border-radius: 10rpx; background: var(--paper-shade, #faeee9);
}
.status-icon image { width: 52rpx; height: 52rpx; }
.status-title { margin-bottom: 18rpx; color: var(--brand-deep, #8c1614); font-size: 42rpx; line-height: 1.35; font-weight: 700; }
.status-copy { color: var(--text-2, #6b5d57); font-size: 28rpx; line-height: 1.8; }
.status-note { margin-top: 40rpx; padding-left: 24rpx; border-left: 6rpx solid var(--gold, #c69a28); color: var(--text-2, #6b5d57); }
.home-button {
  width: 100%; min-height: 88rpx; margin: 28rpx 0 0; padding: 20rpx 24rpx;
  border-radius: 10rpx; background: var(--brand, #c41c23);
  color: #fff; line-height: 1.5; font-weight: 700;
}
.home-button.secondary {
  border: 1rpx solid rgba(122,26,18,0.38); background: transparent;
  color: var(--brand-ink, #7a1a12); font-weight: 600;
}
