@import "styles/ui.wxss";
/**
 * 全局样式与设计令牌。
 * 岭南红与校徽金沿用项目确定的品牌色；纸白底、清晰分区和方正轮廓构成本次全模块改版。
 * 令牌引用必须带相同字面回退值，见 tests/wxss.test.cjs。
 */
page {
  --brand: #c41c23;
  --brand-deep: #8c1614;
  --brand-ink: #7a1a12;
  --gold: #c69a28;
  --gold-deep: #a67f1c;
  --paper: #fdf7f5;
  --paper-shade: #faeee9;

  --text: #2b2422;
  --text-2: #6b5d57;
  --text-3: #746760;
  --surface: #ffffff;
  --line: #ded4cf;
  --control-line: #aa9990;
  --success: #147a70;
  --success-soft: #e8f3f0;

  /* Legacy design tokens remain available to the archived timetable mockups; active page styles do not use glass. */
  --glass: rgba(255,255,255,0.52);
  --glass-strong: rgba(255,255,255,0.72);
  --glass-edge: rgba(255,255,255,0.92);
  --glass-line: rgba(255,255,255,0.62);
  --glass-divide: rgba(255,255,255,0.70);
  --glass-drop: rgba(92,28,26,0.13);
  --glass-drop-strong: rgba(140,22,20,0.26);
  --glass-blur: 16px;
  --r-chip: 12rpx;
  --r-control: 20rpx;
  --r-card: 24rpx;
  --r-panel: 32rpx;
  --r-pill: 999rpx;

  --warn: #9a5b1e;
  --warn-soft: rgba(255,244,228,0.86);
  --warn-line: rgba(214,160,90,0.55);

  /* AI 语义色（设计图 04）：金 = AI 的产出，一律「待确认或可追溯」；红仍是学生要做的动作。
     值与 --gold-deep 相同但语义不同：改品牌金不该连带改 AI 产出色，反之亦然。 */
  --ai: #a67f1c;
  --ai-soft: #fbf4e2;
  --ai-line: #e7d3a0;

  /* 岭南红重设计（2026-11-13 定稿）新增的灰白表面与圆角：
     设计稿里这些值写在 _mockup.css，属于「提案」；本轮随实现一起落成生产令牌。
     旧令牌名与值一律保留——B/C 页面仍在引用它们，改名会让别人的页面静默失色。 */
  --canvas: #f5f6f8;
  --canvas-2: #eceef1;
  --line-soft: #ececef;
  --chip: #f0f1f4;
  --brand-soft: #fff0ef;
  --brand-line: #e8a5a8;
  --danger-soft: #fff0ef;
  --r-hub: 36rpx;
  --r-tile: 32rpx;
  --r-hero: 44rpx;

  /* 课程颜色由 services/timetable/palette.ts 提供，以下仅为内联槽失效时的兜底。 */
  --blk-tint: rgba(255,255,255,0.72);
  --blk-line: rgba(255,255,255,0.62);
  --blk-solid: rgba(148,134,127,0.55);

  /* 画布底色：四个主入口与任务页统一用灰白底（设计稿 body 的 #f5f6f8），
     卡片落在白面上。--paper 保留给仍在用的旧页面。 */
  background: var(--canvas, #f5f6f8);
  color: var(--text, #2b2422);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  line-height: 1.65;
}

view,button { box-sizing:border-box; }
button { margin:0; padding:0; font:inherit; color:inherit; background:transparent; }
button::after { border:0; }
.status-icon { width:52px; height:52px; display:flex; align-items:center; justify-content:center; margin-bottom:18px; background:#faeee9; border-radius:8px; }
.status-icon image { width:28px; height:28px; }