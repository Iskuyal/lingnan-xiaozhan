.fit-title { display:none; }
.fit-copy { margin:12px 0 20px; padding:14px 15px; border-left:3px solid #ded4cf; background:#fff; color:#6b5d57; font-size:13px; line-height:1.8; }
.fit-field { margin-top:18px; }
.fit-label { margin-bottom:8px; font-size:13px; font-weight:600; }
.fit-pills { display:flex; gap:8px; }
.fit-pill { flex:1; min-height:44px; padding:10px 12px; border:1px solid #aa9990; border-radius:8px; background:#fff; font-size:13px; text-align:center; }
.fit-pill-on { color:#fff; background:#8c1614; border-color:#8c1614; }
.fit-input { width:100%; height:48px; padding:12px 13px; background:#fff; border:1px solid #aa9990; border-radius:7px; font-size:14px; }
.fit-hint { margin-top:7px; color:#746760; font-size:11px; line-height:1.8; }
.fit-row { display:flex; gap:12px; }
.fit-row .fit-field { flex:1; min-width:0; }
.fit-warn { margin-top:20px; padding:14px 15px; border-left:3px solid #9a5b1e; background:#fff4e4; color:#78420e; font-size:13px; line-height:1.8; }
.fit-summary { margin-top:20px; padding:22px 18px; border-radius:12px; background:#8c1614; color:#fff; }
.fit-summary-top { display:flex; align-items:baseline; gap:12px; }
.fit-total { font-size:48px; font-weight:700; line-height:1.2; }
.fit-total-partial { font-size:32px; font-weight:700; }
.fit-grade { font-size:16px; }
.fit-summary-line { margin-top:12px; font-size:12px; line-height:1.8; }
.fit-em { font-weight:700; }
.fit-table { margin-top:20px; background:#fff; }
.fit-table-row { display:flex; gap:8px; padding:13px 10px; border-bottom:1px solid #ded4cf; align-items:center; }
.fit-item-main { flex:1; min-width:0; }
.fit-item-name { font-size:12px; }
.fit-item-note { margin-top:5px; font-size:11px; color:#746760; line-height:1.7; }
.fit-item-value { flex:none; max-width:112px; font-size:11px; color:#6b5d57; text-align:right; }
.fit-item-score { flex:none; width:35px; text-align:right; font-size:13px; font-weight:600; }
.fit-item-score-null { font-size:11px; color:#9a5b1e; }
.fit-bonus,.fit-notes { margin-top:16px; font-size:11px; color:#746760; line-height:1.9; }
.fit-foot { margin-top:18px; }
.fit-back { margin-top:16px; min-height:44px; padding:12px; color:#8c1614; font-size:13px; text-align:center; }
