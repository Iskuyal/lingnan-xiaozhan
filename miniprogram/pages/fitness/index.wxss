/* 体测估算（设计图 fitness-calc/01、02、03）。 */
.fit-title { margin:8rpx 0 0; color:var(--brand-deep, #8c1614); font-size:52rpx; line-height:1.25; font-weight:700; }
.fit-copy { margin-top:12rpx; color:var(--text-2, #6b5d57); font-size:25rpx; line-height:1.8; }

.fit-field { margin-top:27rpx; padding:23rpx; border:1rpx solid rgba(43,36,34,0.14); background:rgba(255,255,255,0.62); }
.fit-label { color:var(--text-3, #746760); font-size:21rpx; }
.fit-pills { margin-top:13rpx; display:flex; gap:13rpx; }
.fit-pill { flex:1; min-height:85rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(43,36,34,0.2); color:var(--text-2, #6b5d57); font-size:23rpx; }
.fit-pill-on { border-color:var(--brand, #c41c23); background:var(--brand, #c41c23); color:#fff; font-weight:700; }
.fit-input { margin-top:13rpx; min-height:85rpx; padding:19rpx 21rpx; border:1rpx solid rgba(43,36,34,0.18); background:#fff; font-size:29rpx; }
.fit-hint { margin-top:12rpx; color:var(--text-3, #746760); font-size:21rpx; line-height:1.7; }
.fit-row { display:flex; gap:17rpx; }
.fit-row .fit-field { flex:1; min-width:0; }
.fit-calc { margin-top:38rpx; font-size:29rpx; }

.fit-warn { margin-top:35rpx; padding:23rpx; border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); border-left:8rpx solid #c68a32; background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); font-size:23rpx; line-height:1.75; }
.fit-summary { margin-top:27rpx; padding:27rpx; border-left:6rpx solid var(--brand, #c41c23); background:var(--paper-shade, #faeee9); }
.fit-summary-top { display:flex; align-items:baseline; gap:19rpx; }
.fit-total { color:var(--brand-deep, #8c1614); font-size:65rpx; line-height:1.1; font-weight:700; }
.fit-total-partial { color:var(--brand-deep, #8c1614); font-size:50rpx; line-height:1.15; font-weight:700; }
.fit-grade { padding:4rpx 15rpx; border:1rpx solid rgba(198,154,40,0.55); background:rgba(198,154,40,0.12); color:var(--brand-ink, #7a1a12); font-size:21rpx; font-weight:700; }
.fit-summary-line { margin-top:12rpx; color:var(--text-2, #6b5d57); font-size:23rpx; line-height:1.75; }
.fit-em { color:var(--warn, #9a5b1e); font-weight:700; }

.fit-table { margin-top:31rpx; border-top:1rpx solid rgba(43,36,34,0.16); }
.fit-table-row { display:flex; align-items:center; gap:19rpx; padding:17rpx 0; border-bottom:1rpx solid rgba(43,36,34,0.13); }
.fit-item-main { flex:1; min-width:0; }
.fit-item-name { color:var(--text, #2b2422); font-size:25rpx; line-height:1.5; }
.fit-item-note { margin-top:4rpx; color:var(--warn, #9a5b1e); font-size:20rpx; line-height:1.6; }
.fit-item-value { flex:none; width:185rpx; color:var(--text-2, #6b5d57); font-size:22rpx; text-align:right; }
.fit-item-score { flex:none; width:100rpx; text-align:right; color:var(--brand-deep, #8c1614); font-size:27rpx; font-weight:700; }
.fit-item-score-null { color:var(--warn, #9a5b1e); font-size:21rpx; font-weight:600; }

.fit-bonus { margin-top:27rpx; padding:19rpx 23rpx; border-left:6rpx solid var(--gold, #c69a28); background:rgba(198,154,40,0.10); color:var(--text-2, #6b5d57); font-size:22rpx; line-height:1.75; }
.fit-notes { margin-top:31rpx; color:var(--text-3, #746760); font-size:21rpx; line-height:1.8; }
.fit-notes view { margin-top:6rpx; }
.fit-again { margin-top:38rpx; font-size:29rpx; }
.fit-foot { margin-top:42rpx; padding-top:23rpx; border-top:1rpx solid rgba(43,36,34,0.17); }
.fit-back { margin-top:27rpx; color:var(--brand-ink, #7a1a12); font-size:25rpx; text-align:center; }
