@import "../../ui/study/study.wxss";

/* 体测估算页：通用件用 u2-，本页专用件用 fit- 前缀；表格/大分数/键值复用 st-。 */

.fit-result {
  margin-top: 26px;
}

.fit-summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.fit-total {
  margin: 6px 0 2px;
}

/* 总分与标准分之间用一条细线分开，避免两个数字看着像同一件事。 */
.fit-divider {
  height: 1px;
  margin: 16px 0;
  background: var(--line-soft, #ececef);
}

.fit-summary-foot {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: var(--text-2, #6b5d57);
}

.fit-partial {
  margin-top: 18px;
}

.fit-warn {
  margin-bottom: 12px;
}

.fit-strong {
  font-weight: 650;
  color: var(--text, #2b2422);
}

.fit-missing-row {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--line-soft, #ececef);
}

.fit-missing-row:first-of-type {
  margin-top: 12px;
}

.fit-missing-note {
  color: var(--text-2, #6b5d57);
}

.fit-missing-fields {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}

.fit-missing-input {
  flex: 1;
  min-width: 0;
}

.fit-recalc {
  margin-top: 18px;
}

.fit-table-row .fit-item-name {
  font-weight: 650;
}

.fit-item-note {
  margin-top: 2px;
  font-size: 11px;
  line-height: 1.6;
  color: var(--text-2, #6b5d57);
}

.fit-score-null {
  color: var(--text-3, #746760);
}

.fit-note-guard {
  margin-top: 12px;
}

.fit-bonus {
  margin-top: 12px;
}

.fit-notes {
  margin-top: 16px;
}

.fit-actions {
  margin-top: 20px;
}

.fit-foot {
  margin: 24px 0 12px;
}

.fit-back {
  margin-top: 4px;
}
