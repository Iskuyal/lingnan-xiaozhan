<view class="u2-page">
  <view class="u2-kicker">体测估算 · {{bandLabel}} · {{sexLabel}}</view>
  <view class="u2-h1">看看自己的状态。</view>
  <view class="u2-lead">按国家标准估算，缺项就留空。只在本机计算，不上传、不保存。</view>

  <view class="st-field">
    <view class="st-label">性别</view>
    <view class="st-seg">
      <view id="fit-sex-male" class="st-seg-item {{sex === 'male' ? 'st-seg-on' : ''}}" hover-class="pressed" data-value="male" bindtap="onSexTap">男</view>
      <view id="fit-sex-female" class="st-seg-item {{sex === 'female' ? 'st-seg-on' : ''}}" hover-class="pressed" data-value="female" bindtap="onSexTap">女</view>
    </view>
  </view>

  <view class="st-field">
    <view class="st-label">年级组</view>
    <view class="st-seg">
      <view id="fit-band-freshman" class="st-seg-item {{band === 'freshman' ? 'st-seg-on' : ''}}" hover-class="pressed" data-value="freshman" bindtap="onBandTap">大一 / 大二</view>
      <view id="fit-band-senior" class="st-seg-item {{band === 'senior' ? 'st-seg-on' : ''}}" hover-class="pressed" data-value="senior" bindtap="onBandTap">大三 / 大四</view>
    </view>
    <view class="st-field-hint">标准把大学一二年级与三四年级分成两组，同一成绩在两组里的分数不同。</view>
  </view>

  <view class="st-field-pair">
    <view class="st-field">
      <view class="st-label">身高（厘米）</view>
      <input id="fit-height" class="st-input" type="digit" value="{{form.height}}" data-value="height" bindinput="onInput" placeholder="175" />
    </view>
    <view class="st-field">
      <view class="st-label">体重（千克）</view>
      <input id="fit-weight" class="st-input" type="digit" value="{{form.weight}}" data-value="weight" bindinput="onInput" placeholder="61.3" />
    </view>
  </view>

  <view class="st-field">
    <view class="st-label">肺活量（毫升）</view>
    <input id="fit-vital" class="st-input" type="number" value="{{form.vitalCapacity}}" data-value="vitalCapacity" bindinput="onInput" placeholder="4300" />
  </view>

  <view class="st-field-pair">
    <view class="st-field">
      <view class="st-label">50 米跑（秒）</view>
      <input id="fit-sprint" class="st-input" type="digit" value="{{form.sprint50}}" data-value="sprint50" bindinput="onInput" placeholder="7.0" />
    </view>
    <view class="st-field">
      <view class="st-label">坐位体前屈（厘米）</view>
      <input id="fit-sit" class="st-input" type="digit" value="{{form.sitAndReach}}" data-value="sitAndReach" bindinput="onInput" placeholder="17.7" />
    </view>
  </view>

  <view class="st-field">
    <view class="st-label">立定跳远（厘米）</view>
    <input id="fit-jump" class="st-input" type="number" value="{{form.standingLongJump}}" data-value="standingLongJump" bindinput="onInput" placeholder="248" />
  </view>

  <view class="st-field">
    <view class="st-label">引体向上 / 1 分钟仰卧起坐（次）</view>
    <input id="fit-strength" class="st-input" type="number" value="{{form.strength}}" data-value="strength" bindinput="onInput" placeholder="15" />
  </view>

  <view class="st-field">
    <view class="st-label">{{sex === 'male' ? '1000 米跑' : '800 米跑'}}（分′秒″ 或总秒数）</view>
    <input id="fit-run" class="st-input" type="text" value="{{form.distanceRun}}" data-value="distanceRun" bindinput="onInput" placeholder="3′42″ 或 222" />
    <view id="fit-run-hint" class="st-field-hint" wx:if="{{runHint !== ''}}">{{runHint}}</view>
  </view>

  <view class="u2-actions">
    <button id="fit-calc" class="u2-btn u2-btn-primary" hover-class="pressed" bindtap="calculate">查看估算结果</button>
  </view>

  <view class="u2-source">
    <view class="u2-source-line">国家学生体质健康标准（2014 年修订）</view>
    <view class="u2-source-line">不代表本校计分口径或学校正式成绩；学校实际规则未核实。</view>
  </view>

  <block wx:if="{{hasResult}}">
    <view class="fit-result">
      <view class="u2-kicker">{{resultEyebrow}}</view>
      <view class="u2-h1">每一项，都看清楚。</view>
      <view class="u2-lead u2-sm">本页是估算，不是学校成绩；缺项不会被当成 0 分。</view>

      <view wx:if="{{result.total !== null}}" class="u2-card fit-summary">
        <view class="fit-summary-head">
          <view class="u2-sm u2-muted">估算学年总分</view>
          <view class="u2-tag u2-tag-red">{{result.grade}}</view>
        </view>
        <view class="st-score u2-num fit-total">{{totalText}}</view>
        <view class="u2-sm u2-muted">国家标准参考 · {{filledCount}} 项均有输入</view>
        <view class="fit-divider"></view>
        <view class="fit-summary-foot u2-sm">
          <text>标准分 {{standardText}}</text>
          <text>附加分 {{bonusText}}</text>
        </view>
      </view>

      <view wx:else class="fit-partial">
        <view class="u2-notice u2-notice-info fit-warn">
          7 项没有全部计分，这里<text class="fit-strong">不给学年总分、也不给等级</text>；已填项目的加权分同样不冒充总分。
        </view>

        <view class="u2-card fit-missing">
          <view class="u2-card-title">缺少的项目</view>
          <view class="u2-card-copy">填完点下面的按钮重新估算；不填的项目始终按「没参与」处理，不按 0 分算。</view>
          <view class="fit-missing-row" wx:for="{{missingRows}}" wx:key="key" wx:for-item="row">
            <view class="st-kv">
              <view class="st-kv-key">{{row.label}}</view>
              <view class="st-kv-val fit-missing-note">{{row.note}}</view>
            </view>
            <view class="fit-missing-fields" wx:if="{{row.fields.length > 0}}">
              <input
                wx:for="{{row.fields}}"
                wx:key="field"
                wx:for-item="slot"
                id="fit-fill-{{row.key}}-{{slot.field}}"
                class="st-input fit-missing-input"
                type="{{slot.type}}"
                value="{{slot.value}}"
                data-value="{{slot.field}}"
                bindinput="onInput"
                placeholder="{{slot.placeholder}}"
              />
            </view>
          </view>
          <button id="fit-recalc" class="u2-btn u2-btn-soft fit-recalc" hover-class="pressed" bindtap="onRecalculate">补填后重新估算</button>
        </view>
      </view>

      <view class="u2-section">
        <view class="u2-section-title">{{result.total === null ? '已填项目的单项结果' : '单项明细'}}</view>
        <view class="u2-section-note">{{filledCount}} / 7 项有分数</view>
      </view>

      <view class="u2-card fit-table">
        <view class="st-table-head">
          <view class="st-table-name">项目</view>
          <view class="st-table-value">成绩</view>
          <view class="st-table-score">单项分</view>
        </view>
        <view class="st-table-row fit-table-row" wx:for="{{result.items}}" wx:key="key" wx:for-item="item">
          <view class="st-table-name">
            <view class="fit-item-name">{{item.label}}</view>
            <view class="fit-item-note" wx:if="{{item.note !== ''}}">{{item.note}}</view>
          </view>
          <view class="st-table-value">{{item.valueText === '' ? '未填' : item.valueText}}</view>
          <view class="st-table-score {{item.score === null ? 'fit-score-null' : ''}}">{{item.score === null ? '—' : item.score}}</view>
        </view>
      </view>

      <view class="u2-notice u2-notice-info fit-note-guard">缺项时不显示学年总分与等级；已填项目的加权分也不会冒充总分。</view>

      <view wx:if="{{result.bonus > 0}}" class="u2-card fit-bonus">
        <view class="u2-card-title">附加分明细</view>
        <view class="u2-card-copy" wx:for="{{result.bonusDetail}}" wx:key="*this" wx:for-item="line">{{line}}</view>
      </view>

      <view class="u2-source fit-notes">
        <view class="u2-source-line" wx:for="{{result.notes}}" wx:key="*this" wx:for-item="line">{{line}}</view>
        <view class="u2-source-line">你的输入只在这台手机上参与计算，不上传、不保存。</view>
      </view>

      <view class="u2-actions st-actions-dual fit-actions">
        <button id="fit-again" class="u2-btn u2-btn-primary" hover-class="pressed" bindtap="focusForm">返回修改成绩</button>
        <button id="fit-study" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="goStudy">返回学习工具</button>
      </view>
    </view>
  </block>

  <view class="u2-sm u2-muted fit-foot">填了的项目才参与计算；留空的项目不会按 0 分算。</view>
  <view id="back-from-fitness" class="u2-btn u2-btn-secondary fit-back" hover-class="pressed" bindtap="goHome">返回</view>
</view>
