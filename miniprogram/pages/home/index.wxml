    </view>

    <view class="news-section">
      <view class="news-section-head">
        <view class="section-title">最近动态</view>
        <view class="section-note">校园资讯</view>
      </view>
      <view wx:if="{{newsStatus === 'loading'}}" class="news-hint">正在读取最近资讯…</view>
      <view wx:elif="{{newsStatus === 'error'}}" class="news-hint news-hint-error">
        <view>{{newsError}}</view>
        <button id="news-retry" class="news-retry" hover-class="pressed" bindtap="retryNews">重试</button>
      </view>
      <block wx:else>
        <view wx:if="{{recentNews.length === 0}}" class="news-hint">
          云端还没有已同步的资讯，稍后再来看看。
        </view>
        <view wx:else class="recent-news-list">
          <view
            class="recent-news-item news-recent-item {{index === 0 ? 'recent-news-item-feature' : ''}}"
            wx:for="{{recentNews}}"
            wx:key="id"
            wx:for-index="index"
            hover-class="pressed"
            data-id="{{item.id}}"
            bindtap="openNewsDetail"
          >
            <view class="recent-date news-recent-date">{{item.date === '' ? '日期待核实' : item.date}}</view>
            <view class="recent-title news-recent-title">{{item.title}}</view>
            <view class="recent-item-arrow">›</view>
          </view>
        </view>
        <view class="news-source">
          来源：{{newsMeta.label}}
          <block wx:if="{{newsSyncedAtText !== ''}}"> · 最近写入：{{newsSyncedAtText}}</block>
        </view>
        <button id="news-view-all" class="news-view-all" hover-class="pressed" bindtap="openNews">查看全部校园资讯 ›</button>
      </block>
    </view>

    <view class="school-about">
      <view class="section-head">
        <view class="section-title">认识岭南</view>
        <view class="section-note">学校简介</view>
      </view>
      <view class="introduction">{{school.introduction}}</view>
      <view class="source-area">
        <view class="source-label">资料来源：{{school.sourceLabel}}</view>
        <view class="verified-date">核查于 {{school.verifiedAt}}</view>
        <button id="copy-source" class="source-button" hover-class="pressed" bindtap="copySource">复制官网链接</button>
      </view>
    </view>

    <view class="home-footer">从了解校园，到安排每一天</view>
  </view>
</view>
