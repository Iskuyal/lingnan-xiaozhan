<view class="u2-page">
  <view class="u2-home-head">
    <view class="u2-home-head-main">
      <view class="u2-kicker">{{brief.dateLine}}</view>
      <view class="u2-home-greet">{{brief.greeting}}，</view>
      <view class="u2-home-greet">{{greetLine}}</view>
    </view>
    <view class="u2-date-tile" aria-label="今天日期">
      <view class="u2-date-tile-top">{{dateTile.month}}</view>
      <view class="u2-date-tile-num">{{dateTile.day}}</view>
    </view>
  </view>

  <view wx:if="{{hero.mode === 'class'}}" id="hero-card" class="u2-hero home-hero" hover-class="pressed" data-id="{{hero.key}}" bindtap="openCourse" aria-label="{{hero.label}}{{hero.title}}">
    <view class="u2-hero-top">
      <text class="u2-hero-label">{{hero.label}}</text>
      <text wx:if="{{hero.sectionText !== ''}}" class="u2-tag u2-tag-line">{{hero.sectionText}}</text>
    </view>
    <view wx:if="{{hero.timeRange !== ''}}" class="u2-hero-time u2-num">{{hero.timeRange}}</view>
    <view class="u2-hero-title">{{hero.title}}</view>
    <view wx:if="{{hero.meta !== ''}}" class="u2-hero-meta">{{hero.meta}}</view>
    <view class="u2-hero-foot">
      <text>{{hero.footNote}}</text>
      <text wx:if="{{hero.key !== ''}}" class="u2-hero-link">课程详情 →</text>
    </view>
  </view>

  <view wx:elif="{{hero.mode === 'unknown-times'}}" id="hero-unknown-times" class="u2-notice u2-notice-info home-notice">
    <view class="u2-notice-title">还没有填写作息时间</view>
    <view>{{hero.meta}}</view>
  </view>

  <view wx:elif="{{hero.mode === 'error'}}" id="hero-error" class="u2-notice u2-notice-error home-notice">
    <view class="u2-notice-title">今天的课表暂时没读到</view>
    <view class="home-notice-copy">{{hero.meta}}</view>
    <button id="today-retry" class="u2-btn u2-btn-secondary home-notice-button" hover-class="pressed" bindtap="retryToday">重新读取</button>
  </view>

  <view wx:elif="{{hero.mode === 'empty'}}" id="hero-empty" class="u2-empty home-empty">
    <view class="u2-empty-icon"><image class="u2-quick-img" src="/assets/ui-v2/v2-calendar.svg" /></view>
    <view class="u2-empty-title">{{hero.title}}</view>
    <view class="u2-empty-copy">{{hero.meta}}</view>
    <view class="u2-actions">
      <button id="import-entry-empty" class="u2-btn u2-btn-primary" hover-class="pressed" bindtap="openImport">导入我的课表</button>
      <button id="manual-entry" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="openManualCourse">先手工添加一门课</button>
    </view>
    <view class="u2-quote home-empty-note">还没设置学期与作息时，只显示节次；不猜测「正在上课」或「今天没课」。</view>
  </view>

  <view wx:elif="{{hero.mode === 'loading'}}" id="hero-loading" class="u2-card u2-card-line home-loading">
    <view class="u2-card-title">正在读取今天的安排</view>
    <view class="u2-card-copy">课表读取完成后显示下一节课与今日时间线。</view>
  </view>

  <view wx:if="{{hero.mode === 'unknown-times'}}" class="u2-actions">
    <button id="fill-settings" class="u2-btn u2-btn-primary" hover-class="pressed" bindtap="openTimetableSettings">填写我的作息时间</button>
    <button id="week-link-unknown" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="openTimetable">直接看周课表</button>
  </view>

  <view class="u2-quick">
    <button id="ask-entry" class="u2-quick-item" hover-class="pressed" bindtap="askTimetable" aria-label="问课表，打开课表助手">
      <view class="u2-quick-icon"><image class="u2-quick-img" src="/assets/ui-v2/v2-ask.svg" /></view>
      <text>问课表</text>
    </button>
    <button id="import-entry" class="u2-quick-item" hover-class="pressed" bindtap="openImport" aria-label="导入课表">
      <view class="u2-quick-icon"><image class="u2-quick-img" src="/assets/ui-v2/v2-import.svg" /></view>
      <text>导入课表</text>
    </button>
    <button id="goal-entry" class="u2-quick-item" hover-class="pressed" bindtap="openGoals" aria-label="目标日">
      <view class="u2-quick-icon"><image class="u2-quick-img" src="/assets/ui-v2/v2-goal.svg" /></view>
      <text>目标日</text>
    </button>
    <button id="news-entry" class="u2-quick-item" hover-class="pressed" bindtap="openNews" aria-label="校园资讯">
      <view class="u2-quick-icon"><image class="u2-quick-img" src="/assets/ui-v2/v2-news.svg" /></view>
      <text>校园资讯</text>
    </button>
  </view>

  <block wx:if="{{brief.rows.length > 0}}">
    <view class="u2-section">
      <view class="u2-section-title">今天的安排</view>
      <view id="week-link" class="u2-text-link" bindtap="openTimetable">看课表 →</view>
    </view>
    <view id="today-timeline" class="u2-timeline">
      <view
        wx:for="{{brief.rows}}"
        wx:key="key"
        class="u2-tl-row"
        hover-class="{{item.kind === 'course' ? 'pressed' : 'none'}}"
        data-id="{{item.key}}"
        bindtap="openCourse"
      >
        <view class="u2-tl-time">
          <text wx:if="{{item.timeText !== ''}}">{{item.timeText}}</text>
          <text class="u2-tl-section">{{item.sectionText}}</text>
        </view>
        <view class="u2-tl-track {{item.isNow ? 'u2-tl-track-now' : ''}}{{item.kind === 'free' ? 'u2-tl-track-free' : ''}}"></view>
        <view class="u2-tl-main">
          <view class="u2-tl-title">{{item.title}}<text wx:if="{{item.isNow}}" class="u2-badge">正在上</text><text wx:elif="{{item.isNext}}" class="u2-badge">下一节</text></view>
          <view wx:if="{{item.detail !== ''}}" class="u2-tl-detail">{{item.detail}}</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{planStrip.hasPlan}}">
    <view class="u2-section">
      <view class="u2-section-title">继续计划</view>
      <view class="u2-section-note">本机保存</view>
    </view>
    <view id="plan-entry" class="u2-strip" hover-class="pressed" bindtap="openPlan">
      <view class="u2-strip-mark"></view>
      <view class="u2-strip-main">
        <view class="u2-row-title">{{planStrip.title}}</view>
        <view class="u2-row-sub">{{planStrip.meta}}</view>
      </view>
      <view class="u2-text-link">查看</view>
    </view>
  </block>

  <view class="u2-source">
    <view class="u2-source-line">今日卡片与时间线只用本机课表、目标日与已填作息，不调用模型。</view>
    <view class="u2-source-line">学生参赛作品 · 非学校官方应用</view>
  </view>
</view>