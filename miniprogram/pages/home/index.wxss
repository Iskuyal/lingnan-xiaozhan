/**
 * 首页样式：液态玻璃——整块连续的红色头区，玻璃卡上移压在头区边缘形成层叠。
 * 颜色与材质一律引用 app.wxss 的令牌（含回退值）。
 */
.home {
  min-height: 100vh;
  /* 顶部一小条同色红：导航栏是微信系统层、头区是页面层，两者在非整数像素边界各自舍入时
     可能留下亚像素缝隙，透出底下的浅色页面背景就是一条亮线。铺这一条红兜住它，
     高度只到几像素，被头区完全盖住，不影响下方圆角。 */
  background-image: linear-gradient(180deg, var(--brand, #c41c23) 0, var(--brand, #c41c23) 6rpx, rgba(0,0,0,0) 6rpx);
}

.hero {
  /* 头区是一整块连续的红，不做任何高光或反光叠加。顶边取与导航栏完全相同的颜色，
     向下压深出层次；玻璃质感由下方的卡片承担，不放在头区。 */
  background: linear-gradient(180deg, var(--brand, #c41c23) 0%, var(--brand-deep, #8c1614) 100%);
  border-radius: 0 0 52rpx 52rpx;
  padding: 40rpx 36rpx 92rpx;
  position: relative;
  overflow: hidden;
  /* 向上重叠 1rpx，吃掉与系统导航栏之间可能出现的亚像素缝隙。 */
  margin-top: -1rpx;
  box-shadow: 0 24rpx 60rpx var(--glass-drop-strong, rgba(140,22,20,0.26));
}
.hero-eyebrow { color: rgba(255,255,255,0.80); font-size: 24rpx; letter-spacing: 1rpx; position: relative; }
.school-name { font-size: 46rpx; font-weight: 700; line-height: 1.35; margin-top: 12rpx; color: #fff; letter-spacing: 1rpx; position: relative; text-shadow: 0 2rpx 16rpx rgba(0,0,0,0.18); }
.campuses { display: flex; align-items: center; margin-top: 20rpx; color: rgba(255,255,255,0.90); font-size: 25rpx; position: relative; }
.campus-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--gold, #c69a28); margin-right: 14rpx; box-shadow: 0 0 14rpx rgba(255,224,140,0.85); }

/* 上移压在头区边缘：玻璃层叠的关键一笔。 */
.tools-section { margin-top: -100rpx; position: relative; }
.tools-section .section-title { color: rgba(255,255,255,0.94); }
.tools { display: flex; gap: 22rpx; margin-top: 22rpx; }
.tool {
  flex: 1; min-width: 0; padding: 28rpx 24rpx 18rpx; text-align: left; margin: 0;
  line-height: 1.5; color: var(--text, #2b2422);
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), inset 0 -2rpx 0 rgba(255,255,255,0.34), 0 20rpx 52rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.tool-icon { width: 52rpx; height: 52rpx; display: block; margin-bottom: 22rpx; }
.tool-title { font-size: 32rpx; font-weight: 600; color: var(--brand-ink, #7a1a12); }
.tool-description { font-size: 23rpx; color: var(--text-3, #94867f); margin-top: 8rpx; }
.tool-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; border-top: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); padding-top: 16rpx; }
.tool-status { font-size: 22rpx; color: var(--text-3, #94867f); }
.chevron { font-size: 38rpx; line-height: 1; color: var(--gold-deep, #a67f1c); }

.news-section { margin-top: 48rpx; }
.news-section-head { display: flex; align-items: center; justify-content: space-between; }
.news-entry-link { margin: 0; padding: 8rpx 24rpx; background: rgba(196,28,35,0.92); color: #fff; font-size: 25rpx; line-height: 1.7; border-radius: var(--r-pill, 999rpx); border: 1rpx solid rgba(255,255,255,0.34); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40), 0 10rpx 26rpx var(--glass-drop-strong, rgba(140,22,20,0.26)); }
.news-hint { margin-top: 22rpx; padding: 26rpx 24rpx; background: var(--glass, rgba(255,255,255,0.52)); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); border-radius: var(--r-panel, 32rpx); box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)); color: var(--text-2, #6b5d57); font-size: 26rpx; line-height: 1.8; }
.news-hint-error { display: flex; flex-direction: column; align-items: flex-start; gap: 20rpx; background: var(--warn-soft, rgba(255,244,228,0.86)); border-color: var(--warn-line, rgba(214,160,90,0.55)); color: var(--warn, #9a5b1e); }
.news-retry { margin: 0; padding: 12rpx 32rpx; background: rgba(255,255,255,0.86); color: var(--warn, #9a5b1e); font-size: 25rpx; line-height: 1.5; border-radius: var(--r-pill, 999rpx); }
.news-recent-item { background: var(--glass-strong, rgba(255,255,255,0.72)); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); border-radius: var(--r-panel, 32rpx); padding: 24rpx 22rpx; margin-top: 18rpx; box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13)); }
.news-recent-title { font-size: 29rpx; font-weight: 600; line-height: 1.6; }
.news-recent-date { color: var(--text-3, #94867f); font-size: 23rpx; margin-top: 10rpx; }
.news-source { color: var(--text-3, #94867f); font-size: 22rpx; margin-top: 18rpx; }

.school-about { margin-top: 48rpx; padding: 32rpx; background: var(--glass-strong, rgba(255,255,255,0.72)); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); border-radius: var(--r-panel, 32rpx); box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13)); }
.introduction { margin-top: 20rpx; color: var(--text-2, #6b5d57); font-size: 28rpx; line-height: 1.9; }
.source-area { border-top: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); margin-top: 28rpx; padding-top: 24rpx; }
.source-label { font-size: 23rpx; color: var(--text-3, #94867f); }
.verified-date { color: var(--text-3, #94867f); font-size: 22rpx; margin-top: 4rpx; }
.source-button { color: var(--brand-ink, #7a1a12); background: var(--glass, rgba(255,255,255,0.52)); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); margin: 20rpx 0 0; padding: 18rpx 24rpx; font-size: 25rpx; line-height: 1.5; border-radius: var(--r-pill, 999rpx); box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)); }
.footer { text-align: center; color: var(--text-3, #94867f); font-size: 23rpx; margin-top: 38rpx; }
