.home {
  min-height: 100vh;
  background: var(--paper, #fdf7f5);
}
.home-hero {
  min-height: 424rpx;
  margin-top: -1rpx;
  padding: 48rpx 36rpx 28rpx;
  position: relative;
  overflow: hidden;
  background: var(--brand-deep, #8c1614);
  color: #fff;
}
.home-kicker { color: rgba(255,255,255,0.76); font-size: 21rpx; }
.home-name {
  max-width: 450rpx;
  margin-top: 14rpx;
  color: #fff;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}
.home-campus { margin-top: 8rpx; color: rgba(255,255,255,0.80); font-size: 21rpx; }
.home-hero-copy { max-width: 420rpx; margin-top: 28rpx; color: #fff; font-size: 25rpx; line-height: 1.7; }
.hero-foot { display:flex; align-items:center; gap:12rpx; margin-top:24rpx; color:rgba(255,255,255,0.72); font-size:20rpx; }
.gold-square { width:12rpx; height:12rpx; flex:none; background:var(--gold, #c69a28); }
.hero-art { position:absolute; right:22rpx; bottom:8rpx; width:276rpx; height:185rpx; }
.home-content { padding-top: 30rpx; }

.home-primary {
  display:block;
  width:100%;
  max-width:none;
  min-height:176rpx;
  position:relative;
  padding:28rpx 30rpx;
  border-radius:10rpx;
  background:var(--brand, #c41c23);
  color:#fff;
  text-align:left;
}
.entry-label { color:rgba(255,255,255,0.76); font-size:20rpx; }
.entry-title { display:block; margin-top:4rpx; color:var(--brand-deep, #8c1614); font-size:30rpx; line-height:1.4; font-weight:700; }
.home-primary .entry-title { color:#fff; font-size:38rpx; }
.entry-description { display:block; margin-top:5rpx; color:var(--text-3, #746760); font-size:21rpx; line-height:1.5; }
.home-primary .entry-description { color:rgba(255,255,255,0.84); }
.entry-arrow { position:absolute; top:50%; right:30rpx; transform:translateY(-50%); color:#fff; font-size:42rpx; line-height:1; }
.entry-pair { display:flex; gap:20rpx; margin-top:18rpx; }
.home-entry {
  flex:1;
  min-width:0;
  min-height:144rpx;
  padding:21rpx 22rpx;
  background:rgba(255,255,255,0.62);
  border:1rpx solid rgba(43,36,34,0.14);
  text-align:left;
}
.home-entry-departments { border-top:6rpx solid var(--gold, #c69a28); }
.home-entry-news { border-top:6rpx solid var(--brand-deep, #8c1614); }
.home-entry .entry-title { margin-top:0; font-size:29rpx; }
.home-entry .entry-description { margin-top:6rpx; }

.news-section { margin-top:44rpx; }
.news-section-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:8rpx; }
.news-section-head .section-title { font-size:32rpx; }
.section-note { color:var(--text-3, #746760); font-size:21rpx; }
.recent-news-item {
  position:relative;
  padding:20rpx 42rpx 20rpx 0;
  border-bottom:1rpx solid rgba(43,36,34,0.16);
}
.recent-date { color:var(--gold-deep, #a67f1c); font-size:20rpx; font-weight:700; }
.recent-title { margin-top:8rpx; color:var(--text, #2b2422); font-size:27rpx; line-height:1.6; font-weight:600; }
.recent-item-arrow { position:absolute; right:4rpx; bottom:22rpx; color:var(--gold-deep, #a67f1c); font-size:34rpx; }
.recent-news-item-feature {
  margin-top:8rpx;
  padding:25rpx 44rpx 24rpx 22rpx;
  border:0;
  background:var(--brand-deep, #8c1614);
}
.recent-news-item-feature .recent-date,
.recent-news-item-feature .recent-title,
.recent-news-item-feature .recent-item-arrow { color:#fff; }
.recent-news-item-feature .recent-title { font-size:31rpx; font-family:"Songti SC","STSong","SimSun",serif; font-weight:600; }
.news-hint {
  margin-top:14rpx;
  padding:20rpx 22rpx;
  border:1rpx solid rgba(43,36,34,0.16);
  border-left:6rpx solid var(--gold, #c69a28);
  color:var(--text-2, #6b5d57);
  font-size:24rpx;
  line-height:1.7;
}
.news-hint-error { border-color:var(--warn-line, rgba(214,160,90,0.55)); border-left-color:var(--warn, #9a5b1e); color:var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); }
.news-retry { min-height:64rpx; margin-top:12rpx; padding:8rpx 22rpx; border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); color:var(--warn, #9a5b1e); background:rgba(255,255,255,0.6); }
.news-source { margin-top:12rpx; color:var(--text-3, #746760); font-size:20rpx; }
.news-view-all { min-height:84rpx; display:flex; align-items:center; margin-top:12rpx; color:var(--brand-ink, #7a1a12); font-size:23rpx; text-align:left; }

.school-about { margin-top:42rpx; padding:0 0 0 22rpx; border-left:6rpx solid var(--gold, #c69a28); }
.school-about .section-head { margin:0 0 12rpx; }
.introduction { color:var(--text-2, #6b5d57); font-size:27rpx; line-height:1.8; }
.source-area { margin-top:24rpx; padding-top:19rpx; border-top:1rpx solid rgba(43,36,34,0.16); }
.source-label,.verified-date { color:var(--text-3, #746760); font-size:21rpx; line-height:1.6; }
.verified-date { margin-top:4rpx; }
.source-button { min-height:84rpx; margin-top:14rpx; color:var(--brand-ink, #7a1a12); font-size:23rpx; text-align:left; }
.home-footer { margin-top:34rpx; color:var(--text-3, #746760); font-size:21rpx; text-align:center; }

/* 整宽次级入口（升学问答）：原生 button 锁 184px，整宽靠行内样式，这里只给版式。 */
.home-wide-entry { margin-top:19rpx; padding:22rpx 27rpx; border:1rpx solid rgba(43,36,34,0.14); border-left:6rpx solid var(--brand-deep, #8c1614); background:rgba(255,255,255,0.62); text-align:left; }
.home-wide-entry .entry-title { font-size:27rpx; }
.home-wide-entry .entry-description { margin-top:6rpx; font-size:19rpx; }
