<view class="u2-page">
  <view class="u2-kicker qa-kicker">依据已收录的官方原文</view>
  <view class="u2-h1">下一步怎么走，<br />先把依据找清楚。</view>
  <view class="u2-lead">先确认你问的是哪一类升学或实习，有出处再解释；资料里没有就说明。</view>
  <view class="u2-lead u2-sm qa-principle">页面会先用本地收录的官方原文核对范围，再由 AI 依据原文解释；解释里每句都要能对上原文，对不上就退回原文摘录。</view>

  <view class="qa-ask">
    <textarea
      id="qa-input"
      class="st-textarea qa-input"
      value="{{question}}"
      bindinput="onInput"
      maxlength="120"
      placeholder="例如：转段考核包括哪些部分？"
      auto-height
    />
    <button id="qa-ask" class="u2-btn u2-btn-primary qa-submit" hover-class="pressed" bindtap="onAsk">查找相关原文</button>
  </view>

  <view class="qa-chips">
    <view class="st-chip qa-chip" wx:for="{{examples}}" wx:key="*this" wx:for-item="example" data-value="{{example}}" bindtap="onExample">{{example}}</view>
  </view>

  <view class="u2-notice u2-notice-info qa-scope-guard">仅覆盖已收录资料；回答不作为报考资格或录取判断。</view>

  <block wx:if="{{hasResult}}">
    <view class="qa-question">
      <view class="qa-question-label">你问的是</view>
      <view class="qa-question-text">{{asked}}</view>
    </view>

    <block wx:if="{{result.behavior === 'answer'}}">
      <view class="qa-scope">
        <view class="qa-scope-label">{{scopeLabel}}</view>
        <view class="st-kv qa-scope-row" wx:for="{{scopeRows}}" wx:key="key" wx:for-item="row">
          <view class="st-kv-key">{{row.key}}</view>
          <view class="st-kv-val">{{row.value}}</view>
        </view>
      </view>

      <view class="qa-pending" wx:if="{{modelPhase === 'loading'}}">
        <view class="st-loading-bars"><view></view><view></view><view></view></view>
        <view class="qa-pending-label">AI 依据原文解释中…</view>
        <view class="qa-pending-note">用的是已收录的官方原文；不是实时查网。</view>
        <view id="qa-cancel" class="u2-text-link qa-cancel" bindtap="onCancelModel">取消，直接看原文</view>
      </view>

      <view class="u2-card qa-answer" wx:if="{{modelPhase === 'ready' || modelPhase === 'fallback'}}">
        <view class="qa-answer-head">
          <view class="u2-card-title">{{modelLabel}}</view>
          <view class="u2-tag qa-answer-tag">{{modelPhase === 'ready' ? '解释' : '原文'}}</view>
        </view>
        <view class="qa-answer-body {{modelRefused ? 'qa-answer-guard' : ''}}">
          <block wx:for="{{segments}}" wx:key="key" wx:for-item="segment">
            <text wx:if="{{segment.kind === 'text'}}" class="qa-seg-text">{{segment.text}}</text>
            <text wx:else class="qa-ref {{activeRef === segment.ref ? 'qa-ref-on' : ''}}" data-ref="{{segment.ref}}" bindtap="onJumpRef">{{segment.text}}</text>
          </block>
        </view>
        <view class="qa-answer-note" wx:if="{{modelNote !== ''}}">{{modelNote}}</view>
        <view class="u2-sm u2-muted qa-answer-caveat">这里只解释收录文件，不据此判断你本人能否报考。</view>
        <view id="qa-retry" class="u2-text-link qa-retry" wx:if="{{modelPhase === 'fallback'}}" bindtap="onRetryModel">重试 AI 解释</view>
      </view>

      <block wx:if="{{sources.length > 0}}">
        <view class="u2-section">
          <view class="u2-section-title">对应原文 · {{sources.length}} 处依据</view>
          <view class="u2-section-note">编号与上面的解释一一对应</view>
        </view>

        <view class="u2-card qa-source {{activeRef === source.ref ? 'qa-source-on' : ''}}" wx:for="{{sources}}" wx:key="ref" wx:for-item="source">
          <view class="qa-source-title">{{source.title}}</view>
          <view class="u2-source qa-source-meta">
            <view class="u2-source-line">{{source.issuer}} · {{source.documentNumber}}</view>
            <view class="u2-source-line">发布 {{source.publishedAt}} · 收录 {{source.collectedAt}}</view>
            <view class="u2-source-line">{{source.applicableText}}</view>
            <view class="u2-source-line">适用人群：{{source.applicableAudience}}</view>
          </view>
          <view class="qa-source-divider"></view>
          <view class="qa-source-ref" data-ref="{{source.ref}}" bindtap="onJumpRef">{{source.ref}} 原文摘录</view>
          <view class="qa-source-quote">{{source.quote}}</view>
          <view class="u2-text-link qa-copy" data-url="{{source.sourceUrl}}" bindtap="onCopySource">复制原文链接</view>
        </view>
      </block>

      <view class="u2-actions">
        <button id="qa-again" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="onAskAgain">继续提问</button>      </view>
    </block>

    <block wx:else>
      <view class="qa-guard">
        <view class="qa-guard-label">{{result.behavior === 'clarify' ? '需要先确认范围' : '这件事没法用收录原文回答'}}</view>
        <view class="qa-guard-text">{{result.answer}}</view>
        <view class="qa-guard-note" wx:if="{{result.note !== ''}}">{{result.note}}</view>
      </view>

      <block wx:if="{{result.choices.length > 0}}">
        <view class="qa-choice" wx:for="{{result.choices}}" wx:key="*this" wx:for-item="choice" data-value="{{choice}}" bindtap="onChoice">
          <view class="qa-choice-main">
            <view class="qa-choice-title">{{choice}}</view>
            <view class="qa-choice-sub">按这个范围再找一次原文</view>
          </view>
          <view class="qa-choice-chev">›</view>
        </view>
      </block>

      <block wx:if="{{result.links.length > 0}}">
        <view class="u2-section">
          <view class="u2-section-title">官方入口</view>
          <view class="u2-section-note">这里没有的，去原文自己查</view>
        </view>
        <view class="u2-card qa-link" wx:for="{{result.links}}" wx:key="url" wx:for-item="link" data-url="{{link.url}}" bindtap="onCopySource">
          <view class="qa-link-label">{{link.label}}</view>
          <view class="qa-link-url">{{link.url}}</view>
        </view>
      </block>

      <view class="u2-actions">
        <button id="qa-reask" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="onAskAgain">换个问法</button>
      </view>
    </block>
  </block>

  <view class="u2-sm u2-muted qa-foot">语料 {{collectedAt}} 核查；页面不保存你的提问。</view>
  <view id="back-from-qa" class="u2-btn u2-btn-secondary qa-back" hover-class="pressed" bindtap="goHome">返回</view>
</view>
