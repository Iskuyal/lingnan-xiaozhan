.page>.qa-title { display:none; }
.qa-note { margin:14px 0 20px; padding:14px 15px; border-left:3px solid #ded4cf; background:#fff; font-size:13px; line-height:1.9; color:#6b5d57; }
.qa-strong { font-weight:600; color:#2b2422; }
.qa-ask { display:flex; gap:8px; align-items:center; }
.qa-input { flex:1; min-width:0; height:48px; padding:10px 12px; background:#fff; border:1px solid #aa9990; border-radius:7px; font-size:14px; }
.qa-ask-btn { flex:none; min-width:64px; min-height:48px; padding:12px; border-radius:8px; background:#c41c23; color:#fff; text-align:center; font-size:14px; }
.qa-chips { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.qa-chip,.qa-choice { min-height:44px; padding:10px 12px; border:1px solid #b9847c; border-radius:7px; background:#fff; color:#8c1614; font-size:12px; line-height:1.8; }
.qa-question { margin:24px 0 16px 20px; padding:13px 15px; border:1px solid #d4b9ac; border-radius:12px 12px 2px 12px; background:#faeee9; font-size:14px; line-height:1.9; }
.qa-answer,.qa-pending { margin-top:16px; padding:16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.qa-answer-label,.qa-pending-label { font-size:14px; font-weight:600; color:#8c1614; }
.qa-answer-text { margin-top:10px; font-size:14px; line-height:1.9; white-space:pre-wrap; }
.qa-answer-note,.qa-pending-note { margin-top:10px; font-size:11px; color:#746760; line-height:1.8; }
.qa-answer-guard { border-color:#bca99d; }
.qa-pending-cancel,.qa-retry,.qa-copy { min-height:44px; margin-top:12px; padding:10px 12px; border:1px solid #b9847c; border-radius:7px; color:#8c1614; font-size:12px; text-align:center; line-height:1.8; }
.qa-source { margin-top:20px; padding-top:14px; border-top:1px solid #bca99d; }
.qa-source-head { margin-bottom:10px; }
.qa-source-title { color:#8c1614; font-size:13px; font-weight:600; line-height:1.8; }
.qa-source-badge { margin-right:7px; font-weight:700; }
.qa-source-meta,.qa-source-url { margin-top:8px; color:#746760; font-size:11px; line-height:1.8; word-break:break-all; }
.qa-source-quote { padding:14px; margin-top:10px; background:#fff; font-size:14px; line-height:1.9; white-space:pre-wrap; }
.qa-guard { margin-top:20px; padding:14px 15px; border-left:3px solid #9a5b1e; background:#fff4e4; }
.qa-guard-label { color:#78420e; font-size:14px; font-weight:600; }
.qa-guard-text { margin-top:10px; color:#78420e; font-size:14px; line-height:1.9; }
.qa-guard-note { margin-top:10px; color:#6b5d57; font-size:11px; line-height:1.8; }
.qa-choice { margin-top:10px; }
.qa-actions,.qa-links { margin-top:16px; }
.qa-foot { margin-top:24px; }
.qa-back { margin-top:18px; padding:12px; min-height:44px; color:#8c1614; font-size:13px; text-align:center; }
