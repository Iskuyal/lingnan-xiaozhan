<view class="u2-page">
  <view class="u2-kicker">校历与考试</view>
  <view class="u2-h1">重要日期，<br />有据可查。</view>
  <view class="u2-lead">日期、适用范围、原文来源一起看。没有官方日期的事项如实写「待公布」「以本校通知为准」或「暂无官方日期」，不沿用往年安排。</view>

  <view wx:if="{{hasProblems}}" class="u2-notice cal-problems">
    <view class="u2-notice-title">这份日期表没有通过自检，先别当真</view>
    <view class="cal-problem" wx:for="{{problems}}" wx:key="id">{{item.id}}：{{item.problem}}</view>
  </view>

  <view class="cal-group" wx:for="{{groups}}" wx:key="category" wx:for-item="group">
    <view class="u2-section">
      <view class="u2-section-title">{{group.label}}</view>
      <view class="u2-section-note">{{group.rows.length}} 条</view>
    </view>

    <view class="u2-card cal-card" wx:for="{{group.rows}}" wx:key="id" wx:for-item="card">
      <view class="cal-top">
        <view class="u2-card-title cal-title">{{card.title}}</view>
        <view class="u2-tag cal-tag-{{card.tone}}">{{card.stateLabel}}</view>
      </view>

      <view wx:if="{{card.dateHint !== ''}}" class="cal-date cal-date-{{card.tone}}">{{card.dateHint}}</view>
      <view wx:elif="{{card.dateText !== ''}}" class="cal-date cal-date-live u2-num">{{card.dateText}}</view>

      <view class="cal-kv">
        <view class="st-kv">
          <view class="st-kv-key">报名</view>
          <view class="st-kv-val">{{card.registerText}}</view>
        </view>
        <view class="st-kv">
          <view class="st-kv-key">适用范围</view>
          <view class="st-kv-val">{{card.scope}}</view>
        </view>
      </view>

      <view wx:if="{{card.note !== ''}}" class="u2-sm u2-muted cal-note">{{card.note}}</view>
      <view wx:if="{{card.guard !== ''}}" class="cal-guard">{{card.guard}}</view>

      <view class="u2-source">
        <view class="u2-source-line">{{card.sourceLabel}}</view>
        <view wx:if="{{card.publishedAt !== ''}}" class="u2-source-line">公告发布 {{card.publishedAt}} · 最后核查 {{card.verifiedAt}}</view>
        <view wx:else class="u2-source-line">最后核查 {{card.verifiedAt}}</view>
      </view>

      <view id="copy-source-{{card.id}}" class="u2-text-link cal-copy" hover-class="pressed" data-url="{{card.sourceUrl}}" bindtap="onCopySource">复制官方原文链接</view>
    </view>
  </view>

  <view class="u2-body u2-sm u2-muted cal-foot">
    共 {{summary.total}} 条，其中 {{summary.published}} 条有官方公布的考试日期；报名时间以本校通知为准，本页不给没有来源的截止日。
    学校校历与全国放假安排不是一回事，本页只做校历。
  </view>
  <view id="back-from-calendar" class="u2-btn u2-btn-secondary cal-back" hover-class="pressed" bindtap="goHome">返回</view>
</view>
