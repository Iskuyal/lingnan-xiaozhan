/* 校历与考试（设计图 exam-calendar/01、02）：卡片 + 两行信息 + 来源可复制。 */
.cal-title { margin:8rpx 0 0; color:var(--brand-deep, #8c1614); font-size:52rpx; line-height:1.25; font-weight:700; }
.cal-copy { margin-top:12rpx; color:var(--text-2, #6b5d57); font-size:25rpx; line-height:1.8; }

.cal-problems { margin-top:27rpx; padding:23rpx; border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); border-left:8rpx solid var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); }
.cal-problems-title { color:var(--warn, #9a5b1e); font-size:27rpx; font-weight:700; }
.cal-problems-item { margin-top:8rpx; color:var(--warn, #9a5b1e); font-size:22rpx; line-height:1.7; }

.cal-group { margin-top:38rpx; }
.cal-group-head { display:flex; align-items:baseline; justify-content:space-between; }
.cal-group-note { color:var(--text-3, #746760); font-size:21rpx; }

.cal-card { margin-top:15rpx; padding:21rpx 23rpx; border:1rpx solid rgba(43,36,34,0.13); border-left:6rpx solid var(--brand-deep, #8c1614); background:rgba(255,255,255,0.62); }
.cal-top { display:flex; align-items:flex-start; gap:19rpx; }
.cal-title-item { flex:1; min-width:0; color:var(--text, #2b2422); font-size:29rpx; line-height:1.4; font-weight:600; }
.cal-state { flex:none; min-height:42rpx; padding:4rpx 15rpx; display:flex; align-items:center; border-radius:6rpx; font-size:19rpx; font-weight:700; }
.cal-state-live { color:var(--brand-ink, #7a1a12); border:1rpx solid rgba(198,154,40,0.55); background:rgba(198,154,40,0.12); }
.cal-state-plain { color:var(--text-2, #6b5d57); border:1rpx solid rgba(43,36,34,0.2); background:rgba(255,255,255,0.5); }

.cal-line { margin-top:12rpx; display:flex; gap:15rpx; font-size:22rpx; line-height:1.7; }
.cal-key { flex:none; width:85rpx; color:var(--text-3, #746760); }
.cal-val { flex:1; min-width:0; color:var(--text-2, #6b5d57); }
.cal-val-strong { color:var(--text, #2b2422); font-weight:600; }

.cal-source { margin-top:15rpx; padding-top:15rpx; border-top:1rpx solid rgba(43,36,34,0.14); display:flex; align-items:center; justify-content:space-between; gap:15rpx; }
.cal-source-text { min-width:0; color:var(--text-3, #746760); font-size:19rpx; line-height:1.6; }
.cal-copy { flex:none; min-height:56rpx; display:flex; align-items:center; color:var(--brand-ink, #7a1a12); font-size:19rpx; font-weight:700; }

.cal-foot { margin-top:42rpx; padding-top:23rpx; border-top:1rpx solid rgba(43,36,34,0.17); }
.cal-back { margin-top:27rpx; color:var(--brand-ink, #7a1a12); font-size:25rpx; text-align:center; }
