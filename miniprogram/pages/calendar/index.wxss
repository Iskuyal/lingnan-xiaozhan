.cal-title { display:none; }
.cal-copy { margin:12px 0 20px; padding:14px 15px; border-left:3px solid #ded4cf; background:#fff; color:#6b5d57; font-size:13px; line-height:1.8; }
.cal-problems { margin:16px 0; padding:14px; background:#fff4e4; color:#78420e; border-left:3px solid #9a5b1e; }
.cal-problems-title { font-weight:600; }
.cal-problems-item { margin-top:8px; font-size:12px; line-height:1.8; }
.cal-group { margin-top:24px; }
.cal-group-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; }
.cal-group-note { color:#746760; font-size:11px; }
.cal-card { margin-top:12px; padding:16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.cal-top { display:flex; align-items:flex-start; gap:8px; justify-content:space-between; }
.cal-title-item { flex:1; font-size:16px; font-weight:600; line-height:1.7; }
.cal-state { flex:none; max-width:100px; padding:4px 8px; background:#faeee9; color:#8c1614; border-radius:6px; font-size:11px; line-height:1.6; }
.cal-state-plain { color:#746760; background:#fdf7f5; }
.cal-line { display:flex; gap:10px; margin-top:12px; font-size:13px; line-height:1.8; }
.cal-key { flex:none; width:30px; color:#746760; }
.cal-val { flex:1; min-width:0; }
.cal-val-strong { font-weight:600; }
.cal-source { margin-top:14px; padding-top:14px; border-top:1px solid #ded4cf; }
.cal-source-text { color:#746760; font-size:11px; line-height:1.8; }
.cal-copy-link { display:block; min-height:44px; margin-top:10px; padding:10px; color:#8c1614; border:1px solid #b9847c; border-radius:7px; text-align:center; font-size:12px; line-height:1.8; }
.cal-foot { margin-top:22px; }
.cal-back { min-height:44px; margin-top:18px; padding:12px; color:#8c1614; text-align:center; font-size:13px; }
