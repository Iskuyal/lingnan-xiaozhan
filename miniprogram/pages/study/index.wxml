<view class="u2-page">
  <view class="u2-h1 study-title">学习，也有好安排。</view>
  <view class="u2-lead">目标、计划与日常练习，都在这里。</view>

  <view id="study-hero" class="u2-hero study-hero" hover-class="pressed" bindtap="openHero" aria-label="{{hero.name}}">
    <view class="u2-hero-top">
      <text class="u2-hero-label">{{hero.hasGoal ? hero.name : '目标日'}}</text>
      <text wx:if="{{hero.dateText !== ''}}" class="u2-tag u2-tag-line">{{hero.dateText}}</text>
    </view>
    <view wx:if="{{hero.hasGoal}}" class="study-hero-count u2-num">{{hero.days}}<text class="study-hero-unit">{{hero.unit}}</text></view>
    <view wx:else class="u2-hero-title">还没有目标日</view>
    <view wx:if="{{plan.hasPlan}}" class="study-hero-side">{{plan.meta}}</view>
    <view class="u2-hero-foot">
      <text>{{hero.footNote}}</text>
      <text class="study-hero-arrow">→</text>
    </view>
  </view>

  <view class="u2-section"><view class="u2-section-title">学习工具</view></view>
  <view id="study-tools" class="u2-list">
    <view class="u2-row" hover-class="pressed" data-route="/pages/goals/index" bindtap="openTool" aria-label="目标日与学习计划">
      <view class="u2-icon"><image class="u2-icon-img" src="/assets/ui-v2/v2-goal.svg" /></view>
      <view class="u2-row-main"><view class="u2-row-title">目标日与学习计划</view><view class="u2-row-sub">管理目标与本周安排</view></view>
      <text class="u2-chev">›</text>
    </view>
    <view class="u2-row" hover-class="pressed" data-route="/pages/defense/index" bindtap="openTool" aria-label="项目讲解与答辩练习">
      <view class="u2-icon"><image class="u2-icon-img" src="/assets/ui-v2/v2-defense.svg" /></view>
      <view class="u2-row-main"><view class="u2-row-title">项目讲解与答辩练习</view><view class="u2-row-sub">三轮练习，一次复盘</view></view>
      <text class="u2-chev">›</text>
    </view>
    <view class="u2-row" hover-class="pressed" data-route="/pages/advancement/index" bindtap="openTool" aria-label="升学与实习问答">
      <view class="u2-icon"><image class="u2-icon-img" src="/assets/ui-v2/v2-book.svg" /></view>
      <view class="u2-row-main"><view class="u2-row-title">升学与实习问答</view><view class="u2-row-sub">依据已收录的官方原文</view></view>
      <text class="u2-chev">›</text>
    </view>
    <view class="u2-row" hover-class="pressed" data-route="/pages/fitness/index" bindtap="openTool" aria-label="体测估算">
      <view class="u2-icon"><image class="u2-icon-img" src="/assets/ui-v2/v2-pulse.svg" /></view>
      <view class="u2-row-main"><view class="u2-row-title">体测估算</view><view class="u2-row-sub">国家标准参考 · 本机计算</view></view>
      <text class="u2-chev">›</text>
    </view>
  </view>

  <view class="u2-source">
    <view class="u2-source-line">目标日与学习计划只保存在本机，不写入正式课表。</view>
    <view class="u2-source-line">学生参赛作品 · 非学校官方应用</view>
  </view>
</view>