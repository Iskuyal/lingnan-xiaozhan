<view class="u2-page">
  <block wx:if="{{status === 'ready'}}">
    <view class="article">
      <view class="u2-kicker">{{source.label}} · 原文可核对</view>
      <view class="u2-h1 article-title">{{article.title}}</view>
      <view class="article-meta">
        <text>来源：{{source.label}}</text>
        <text>{{article.date === '' ? '日期待核实' : article.date}}</text>
      </view>

      <view class="u2-notice u2-notice-info article-notice">
        正文为云端已同步的原文段落，图片未同步；引用请以原文链接为准。
      </view>

      <view class="article-body">
        <view class="article-paragraph" wx:for="{{article.paragraphs}}" wx:key="index">{{item.text}}</view>
      </view>

      <view class="u2-source">
        <view class="u2-source-line">原文链接</view>
        <view class="u2-source-line article-url">{{article.url}}</view>
        <view wx:if="{{syncedAtText !== ''}}" class="u2-source-line">本条最近一次成功写入：{{syncedAtText}}</view>
      </view>

      <view class="u2-actions">
        <button id="copy-article-source" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="copySource">复制原文链接</button>
        <button id="back-from-detail" class="u2-btn u2-btn-secondary article-back" hover-class="pressed" bindtap="goBack">返回</button>
      </view>
    </view>
  </block>

  <view wx:elif="{{status === 'loading'}}" id="article-loading" class="u2-card u2-card-line">
    <view class="u2-card-title">正在读取</view>
    <view class="u2-card-copy">正在从云端读取这篇资讯…</view>
  </view>

  <view wx:elif="{{status === 'error'}}" id="article-error" class="u2-notice u2-notice-error">
    <view class="u2-notice-title">暂时读不到这篇资讯</view>
    <view class="article-state-copy">{{errorMessage}}</view>
    <button id="retry-load" class="u2-btn u2-btn-secondary article-state-button" hover-class="pressed" bindtap="retry">重试</button>
    <button id="back-home" class="u2-btn u2-btn-secondary article-state-button" hover-class="pressed" bindtap="goHome">返回</button>
  </view>

  <view wx:else id="article-missing" class="u2-empty">
    <view class="u2-empty-icon">讯</view>
    <view class="u2-empty-title">没有找到这篇资讯</view>
    <view class="u2-empty-copy">该条目不在云端已同步的内容里，可能是链接不完整或文章尚未收录。</view>
    <view class="u2-actions">
      <button id="back-home" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="goHome">返回</button>
    </view>
  </view>
</view>
