/* 资讯详情（设计图 24）：标题 + 来源与日期 + 正文段落 + 原文链接。 */
.article-title { margin-top:6px; font-size:26px; line-height:1.55; }
.article-meta { display:flex; flex-direction:column; gap:3px; margin:14px 0 16px; color:var(--text-2, #6b5d57); font-size:12px; line-height:1.7; }
.article-notice { margin-bottom:8px; }
.article-body { margin-top:8px; }
.article-paragraph { margin:16px 0; color:var(--text, #2b2422); font-size:15px; line-height:1.95; }
.article-url { word-break:break-all; }
.article-state-copy { margin-top:6px; }
.article-state-button { margin-top:10px; }
.article-back { background:transparent; border-color:transparent; color:var(--brand, #c41c23); }
