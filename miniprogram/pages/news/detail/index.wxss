.detail-heading { padding-bottom:22rpx; border-bottom:4rpx solid var(--brand, #c41c23); }
.detail-title {
  color:var(--text, #2b2422); font-family:"Songti SC","STSong","SimSun",serif;
  font-size:40rpx; line-height:1.52; font-weight:600;
}
.detail-meta { margin-top:16rpx; color:var(--text-3, #746760); font-size:21rpx; line-height:1.7; }
.detail-body { padding:26rpx 2rpx 0; }
.detail-paragraph { margin-bottom:26rpx; color:var(--text, #2b2422); font-size:28rpx; line-height:1.95; }
.detail-source {
  margin-top:30rpx; padding:22rpx; border:1rpx solid rgba(43,36,34,0.15);
  background:rgba(255,255,255,0.58);
}
.detail-source-label { color:var(--brand-deep, #8c1614); font-size:25rpx; font-weight:700; }
.detail-url { margin-top:8rpx; color:var(--text-2, #6b5d57); font-size:20rpx; line-height:1.55; word-break:break-all; }
.detail-note { margin-top:14rpx; padding:14rpx 16rpx; color:var(--text-3, #746760); background:var(--paper-shade, #faeee9); font-size:20rpx; line-height:1.65; }
