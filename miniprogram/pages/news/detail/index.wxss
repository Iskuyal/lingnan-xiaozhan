/**
 * 详情页私有样式；通用类（.page、.status- 前缀类、.home-button、.pressed）沿用 app.wxss。
 * 正文以可读性为先：高不透明度的玻璃承载长文本。
 */
.detail-heading {
  padding: 28rpx 30rpx 28rpx;
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 20rpx 52rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.detail-title { font-size: 40rpx; font-weight: 700; line-height: 1.5; color: var(--brand-deep, #8c1614); }
.detail-meta { color: var(--text-3, #94867f); font-size: 24rpx; margin-top: 14rpx; }
.detail-body {
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  padding: 32rpx 28rpx;
  margin-top: 28rpx;
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.detail-paragraph { font-size: 29rpx; line-height: 1.9; color: var(--text, #2b2422); margin-bottom: 20rpx; }
.detail-paragraph:last-child { margin-bottom: 0; }
.detail-source {
  margin-top: 28rpx; padding: 26rpx 24rpx;
  background: linear-gradient(150deg, rgba(198,154,40,0.20), rgba(198,154,40,0.09));
  border: 1rpx solid rgba(198,154,40,0.30);
  border-radius: var(--r-control, 20rpx);
}
.detail-source-label { color: var(--text-2, #6b5d57); font-size: 23rpx; }
.detail-url { color: var(--brand, #c41c23); font-size: 24rpx; margin-top: 10rpx; word-break: break-all; }
.detail-note { color: var(--text-3, #94867f); font-size: 23rpx; line-height: 1.8; margin-top: 32rpx; }
