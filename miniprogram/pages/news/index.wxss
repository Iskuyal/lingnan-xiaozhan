.news-heading { margin-bottom:22px; }
.news-title { display:none; }
.news-meta { color:#746760; font-size:12px; line-height:1.8; }
.news-notice { margin:16px 0; padding:14px 15px; border-left:3px solid #9a5b1e; background:#fff4e4; color:#78420e; font-size:13px; line-height:1.8; }
.news-list { margin-top:16px; }
.news-item { padding:18px 0; border-bottom:1px solid #ded4cf; }
.news-item-title { color:#2b2422; font-size:16px; font-weight:600; line-height:1.7; }
.news-item-foot { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; }
.news-item-date,.news-item-stamp { color:#746760; font-size:11px; line-height:1.7; }
.news-item-arrow { color:#8c1614; font-size:23px; }
.news-item-feature { padding:22px 0; border-top:3px solid #c41c23; }
.news-item-feature .news-item-title { font-size:27px; font-family:"Songti SC","STSong","SimSun",serif; line-height:1.5; }
.news-empty { padding:40px 0; }
.news-empty-copy,.news-more-copy { margin-top:12px; color:#6b5d57; font-size:13px; line-height:1.9; }
.news-more { margin-top:22px; }
.news-more-tap,.news-more-button { display:block; width:100%; min-height:48px; padding:12px; background:#fff; border:1px solid #b9847c; border-radius:8px; color:#8c1614; font-size:14px; text-align:center; }
.news-more-error { color:#9a5b1e; }
