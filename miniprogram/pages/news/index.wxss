/* 校园资讯（设计图 23）：日期列 + 标题列表，来源与同步状态常驻可见。 */
.news-title { font-size:30px; }
.news-source-line { display:flex; flex-wrap:wrap; gap:4px 12px; margin:16px 0 4px; color:var(--text-2, #6b5d57); font-size:12px; line-height:1.8; }
.news-state { margin-top:16px; }
.news-state-copy { margin-top:6px; }
.news-state-button { margin-top:10px; }
.news-list { margin-top:10px; }
.news-row { display:flex; gap:14px; padding:18px 0; border-bottom:1px solid var(--line-soft, #ececef); }
.news-date { flex:none; width:46px; color:var(--text-2, #6b5d57); font-size:10px; line-height:1.4; }
.news-date-day { display:block; color:var(--brand, #c41c23); font-size:25px; font-weight:500; }
.news-date-month { display:block; margin-top:2px; }
.news-row-main { flex:1; min-width:0; }
.news-row-title { color:var(--text, #2b2422); font-size:16px; line-height:1.55; font-weight:650; }
.news-row-meta { margin-top:6px; color:var(--text-2, #6b5d57); font-size:11px; line-height:1.7; }
.news-more { padding:16px 0; color:var(--text-2, #6b5d57); font-size:12px; text-align:center; }
.news-more-error { text-align:left; }
.news-more-button { margin-top:8px; }
.news-more-tap { min-height:44px; line-height:2.2; }
