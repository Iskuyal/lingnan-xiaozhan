.news-heading { padding-bottom:22rpx; border-bottom:4rpx solid var(--brand, #c41c23); }
.news-title { margin-top:8rpx; color:var(--brand-deep, #8c1614); font-size:48rpx; line-height:1.3; font-weight:700; }
.news-meta { margin-top:8rpx; color:var(--text-3, #746760); font-size:21rpx; line-height:1.5; }
.news-notice {
  margin-top:24rpx; padding:18rpx 20rpx; border:1rpx solid rgba(43,36,34,0.15);
  border-left:6rpx solid var(--gold, #c69a28); color:var(--text-2, #6b5d57);
  font-size:22rpx; line-height:1.7;
}
.news-list { margin-top:28rpx; }
.news-item {
  position:relative; padding:22rpx 4rpx 20rpx; margin:0;
  border-bottom:1rpx solid rgba(43,36,34,0.16);
}
.news-item-title { font-size:27rpx; line-height:1.65; font-weight:600; color:var(--text, #2b2422); }
.news-item-foot { display:flex; align-items:center; justify-content:space-between; margin-top:8rpx; }
.news-item-date { color:var(--text-3, #746760); font-size:20rpx; }
.news-item-arrow { color:var(--gold-deep, #a67f1c); font-size:32rpx; line-height:1; }
.news-item-feature {
  min-height:300rpx; margin-bottom:24rpx; padding:26rpx 24rpx 22rpx;
  display:flex; flex-direction:column; justify-content:flex-end;
  border:1rpx solid rgba(43,36,34,0.14); border-left:6rpx solid var(--brand, #c41c23);
  background:var(--paper-shade, #faeee9); color:var(--text, #2b2422);
}
.news-item-stamp {
  position:absolute; top:24rpx; right:24rpx; width:90rpx; min-height:54rpx;
  display:flex; align-items:center; justify-content:center; padding:6rpx 8rpx;
  background:var(--gold, #c69a28); color:var(--brand-deep, #8c1614);
  font-size:20rpx; line-height:1.3; font-weight:700; text-align:center;
}
.news-item-feature .news-item-title {
  max-width:560rpx; color:var(--text, #2b2422); font-family:"Songti SC","STSong","SimSun",serif;
  font-size:34rpx; line-height:1.5; font-weight:600;
}
.news-item-feature .news-item-foot { color:var(--text-3, #746760); }
.news-item-feature .news-item-date { color:var(--brand-ink, #7a1a12); }
.news-item-feature .news-item-arrow { color:var(--gold-deep, #a67f1c); }
.news-empty { padding-top:40rpx; }
.news-empty-copy { margin-top:16rpx; color:var(--text-2, #6b5d57); font-size:26rpx; line-height:1.8; }
.news-more { padding:26rpx 0 8rpx; color:var(--text-3, #746760); font-size:23rpx; text-align:center; }
.news-more-tap { color:var(--brand-ink, #7a1a12); }
.news-more-error { display:flex; flex-direction:column; align-items:flex-start; gap:14rpx; color:var(--warn, #9a5b1e); }
.news-more-copy { line-height:1.7; }
.news-more-button { min-height:64rpx; padding:8rpx 22rpx; border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); color:var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); }
