.ge-title { margin:10px 0 22px; font-size:24px; font-weight:700; line-height:1.5; }
.ge-field { margin-top:18px; }
.ge-label { margin-bottom:8px; font-size:13px; font-weight:600; }
.ge-input,.ge-pick { width:100%; min-height:48px; padding:12px 13px; background:#fff; border:1px solid #aa9990; border-radius:7px; font-size:14px; line-height:1.7; }
.ge-hint { margin-top:7px; color:#746760; font-size:11px; line-height:1.8; }
.ge-pick { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.ge-pick-value { flex:1; }
.ge-pick-arrow { font-size:23px; color:#8c1614; }
.ge-switch-row { display:flex; align-items:center; gap:16px; min-height:52px; padding:12px; background:#fff; border:1px solid #ded4cf; border-radius:8px; }
.ge-switch-copy { flex:1; font-size:13px; line-height:1.8; }
.ge-switch { flex:none; width:44px; height:26px; padding:3px; border-radius:16px; background:#aa9990; }
.ge-knob { width:20px; height:20px; border-radius:50%; background:#fff; }
.ge-switch-on { background:#8c1614; }
.ge-switch-on .ge-knob { margin-left:18px; }
.ge-preview { margin-top:22px; padding:20px 18px; background:#8c1614; border-radius:12px; color:#fff; }
.ge-preview-top { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; }
.ge-preview-name { flex:1; font-size:17px; font-weight:600; }
.ge-preview-state { font-size:28px; font-weight:700; }
.ge-preview-meta { margin-top:12px; font-size:12px; }
.ge-preview .ge-hint { color:#fff; }
.ge-delete,.ge-cancel { min-height:44px; margin-top:12px; padding:12px; color:#8c1614; font-size:13px; text-align:center; }
.ge-note { margin-top:16px; }
.ge-missing { padding-top:38px; }
.ge-missing-title { font-size:22px; font-weight:700; }
.ge-missing-copy { margin-top:14px; font-size:13px; line-height:1.9; color:#6b5d57; }
