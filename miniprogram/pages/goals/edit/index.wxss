/* 新建 / 编辑目标日（设计图 goal-days/03）。 */
.ge-title { margin:8rpx 0 0; color:var(--brand-deep, #8c1614); font-size:52rpx; line-height:1.25; font-weight:700; }

.ge-field { margin-top:27rpx; padding:23rpx; border:1rpx solid rgba(43,36,34,0.14); background:rgba(255,255,255,0.62); }
.ge-label { color:var(--text-3, #746760); font-size:21rpx; }
.ge-input { margin-top:13rpx; min-height:85rpx; padding:19rpx 21rpx; border:1rpx solid rgba(43,36,34,0.18); background:#fff; font-size:29rpx; }
.ge-hint { margin-top:12rpx; color:var(--text-3, #746760); font-size:21rpx; line-height:1.7; }

.ge-pick { margin-top:13rpx; min-height:92rpx; padding:0 23rpx; display:flex; align-items:center; justify-content:space-between; border:1rpx solid rgba(43,36,34,0.18); background:#fff; }
.ge-pick-value { color:var(--brand-deep, #8c1614); font-size:33rpx; font-weight:700; }
.ge-pick-arrow { color:var(--text-3, #746760); font-size:37rpx; line-height:1; }

.ge-switch-row { margin-top:13rpx; display:flex; align-items:center; justify-content:space-between; gap:19rpx; }
.ge-switch-copy { flex:1; min-width:0; color:var(--text, #2b2422); font-size:23rpx; line-height:1.6; }
.ge-switch { width:88rpx; height:50rpx; flex:none; padding:4rpx; display:flex; align-items:center; justify-content:flex-start; border-radius:25rpx; background:rgba(43,36,34,0.28); }
.ge-switch-on { justify-content:flex-end; background:var(--brand, #c41c23); }
.ge-knob { width:42rpx; height:42rpx; border-radius:50%; background:#fff; }

.ge-preview { margin-top:35rpx; padding:23rpx; border-left:6rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9); }
.ge-preview-top { display:flex; align-items:flex-start; gap:19rpx; }
.ge-preview-name { flex:1; min-width:0; color:var(--text, #2b2422); font-size:29rpx; line-height:1.4; font-weight:600; }
.ge-preview-state { flex:none; min-height:42rpx; padding:4rpx 15rpx; display:flex; align-items:center; border-radius:6rpx; color:var(--brand-ink, #7a1a12); border:1rpx solid rgba(198,154,40,0.55); background:rgba(198,154,40,0.12); font-size:19rpx; font-weight:700; }
.ge-preview-meta { margin-top:10rpx; color:var(--text-2, #6b5d57); font-size:21rpx; line-height:1.6; }

.ge-save { margin-top:38rpx; font-size:29rpx; }
.ge-delete { min-height:85rpx; margin-top:17rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); font-size:25rpx; font-weight:600; }
.ge-cancel { margin-top:27rpx; color:var(--brand-ink, #7a1a12); font-size:25rpx; text-align:center; }
.ge-note { margin-top:42rpx; padding-top:23rpx; border-top:1rpx solid rgba(43,36,34,0.17); }

.ge-missing { margin-top:50rpx; padding:38rpx 31rpx 42rpx; border-left:6rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9); }
.ge-missing-title { color:var(--brand-deep, #8c1614); font-size:38rpx; line-height:1.35; font-weight:700; }
.ge-missing-copy { margin-top:15rpx; color:var(--text-2, #6b5d57); font-size:25rpx; line-height:1.8; }
.ge-missing-btn { margin-top:31rpx; }
