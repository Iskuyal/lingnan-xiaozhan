/* 目标日列表（设计图 goal-days/01、02）：未到期 / 今天 / 已过期三组，空分组不画。 */
.goal-title { margin:8rpx 0 0; color:var(--brand-deep, #8c1614); font-size:52rpx; line-height:1.25; font-weight:700; }
.goal-copy { margin-top:12rpx; color:var(--text-2, #6b5d57); font-size:25rpx; line-height:1.8; }

.goal-group { margin-top:38rpx; }
.goal-group-head { display:flex; align-items:baseline; justify-content:space-between; }
.goal-group-note { color:var(--text-3, #746760); font-size:21rpx; }

.goal-item { margin-top:15rpx; padding:21rpx 23rpx; border:1rpx solid rgba(43,36,34,0.13); border-left:6rpx solid var(--gold, #c69a28); background:rgba(255,255,255,0.62); }
.goal-item-today { border-left-color:var(--brand, #c41c23); }
.goal-item-expired { border-left-color:#c68a32; background:var(--paper-shade, #faeee9); }
.goal-item-top { display:flex; align-items:flex-start; gap:19rpx; }
.goal-name { flex:1; min-width:0; color:var(--text, #2b2422); font-size:29rpx; line-height:1.4; font-weight:600; }
.goal-state { flex:none; min-height:42rpx; padding:4rpx 15rpx; display:flex; align-items:center; border-radius:6rpx; font-size:19rpx; font-weight:700; }
.goal-state-upcoming { color:var(--brand-ink, #7a1a12); border:1rpx solid rgba(198,154,40,0.55); background:rgba(198,154,40,0.12); }
.goal-state-today { color:#fff; background:var(--brand, #c41c23); }
.goal-state-expired { color:var(--warn, #9a5b1e); border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); background:var(--warn-soft, rgba(255,244,228,0.86)); }
.goal-meta { margin-top:10rpx; color:var(--text-2, #6b5d57); font-size:21rpx; line-height:1.6; }

/* 修改 / 删除两键显式定宽：原生 button 自带内在宽度，不限宽会把整行挤变形。 */
.goal-actions { margin-top:17rpx; display:flex; gap:13rpx; }
.goal-action { width:119rpx; min-height:62rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(43,36,34,0.2); color:var(--brand-ink, #7a1a12); font-size:21rpx; }
.goal-action-warn { color:var(--warn, #9a5b1e); border-color:var(--warn-line, rgba(214,160,90,0.55)); }

.goal-new { margin-top:42rpx; font-size:29rpx; }
.goal-note { margin-top:42rpx; padding-top:23rpx; border-top:1rpx solid rgba(43,36,34,0.17); }

.goal-empty { margin-top:50rpx; padding:38rpx 31rpx 42rpx; border:1rpx solid rgba(43,36,34,0.13); background:rgba(255,255,255,0.62); }
.goal-empty-mark { width:108rpx; height:108rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(198,154,40,0.55); color:var(--gold-deep, #a67f1c); font-size:48rpx; }
.goal-empty-title { margin-top:8rpx; color:var(--brand-deep, #8c1614); font-size:38rpx; line-height:1.35; font-weight:700; }
.goal-empty-copy { margin-top:15rpx; color:var(--text-2, #6b5d57); font-size:25rpx; line-height:1.8; }
