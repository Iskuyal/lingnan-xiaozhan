/**
 * 部门 AI 问答面板样式（Ticket 07）：列表页与详情页 @import 同一份，类名统一 qa- 前缀。
 * 面板结构与标记见同目录 qa.wxml（做法移植自 PR #29）。样式内容不得出现中文，只允许注释里出现。
 */
.qa { margin-top: 36rpx; }
.qa-open { margin-top: 24rpx; }
.qa-panel { background: #fff; border-radius: 22rpx; padding: 26rpx 28rpx; }
.qa-head { display: flex; align-items: center; }
.qa-badge { background: #23664e; color: #fff; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 10rpx; }
.qa-head-note { color: #6c7c73; font-size: 22rpx; margin-left: 14rpx; flex: 1; }
.qa-close { font-size: 24rpx; color: #547367; padding: 0; margin: 0 0 0 16rpx; background: none; border: none; line-height: 1; }
.qa-close::after { border: none; }
.qa-row { display: flex; margin-top: 16rpx; }
.qa-row-user { justify-content: flex-end; }
.qa-row-assistant { justify-content: flex-start; }
.qa-bubble { max-width: 86%; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 27rpx; line-height: 1.7; }
.qa-bubble-assistant { background: #f2f6f3; color: #33483f; }
.qa-bubble-user { background: #e3efe9; color: #33483f; }
.qa-bubble-pending { color: #576c63; }
.qa-bubble-text { word-break: break-all; }
/* 被标记的回答（出现语料外记号或被防幻觉复核拦下）：提示行贴在对应回答下方。 */
.qa-flag { color: #b3543a; font-size: 23rpx; line-height: 1.7; margin-top: 8rpx; }
.qa-options { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.qa-option {
  background: #f2f6f3;
  border: 2rpx solid #d7e5dc;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin: 12rpx 12rpx 0 0;
  width: calc(50% - 12rpx);
  box-sizing: border-box;
}
.qa-option-active { border-color: #23664e; background: #e4f0e9; }
.qa-option-name { font-size: 27rpx; font-weight: 600; }
.qa-option-campus { color: #6c7c73; font-size: 22rpx; margin-top: 4rpx; }
.qa-transcript { margin-top: 4rpx; }
.qa-suggestions { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.qa-suggestion {
  background: #e7edf4;
  color: #46596b;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
}
.qa-input-row { display: flex; align-items: center; margin-top: 14rpx; }
.qa-input { flex: 1; background: #f2f6f3; border-radius: 999rpx; padding: 14rpx 26rpx; font-size: 26rpx; }
.qa-send { margin: 0 0 0 14rpx; background: #2e6e5b; color: #fff; font-size: 26rpx; border-radius: 999rpx; padding: 0 30rpx; line-height: 2.2; }
.qa-send[disabled] { background: #a9c4bb; color: #fff; }
/* 本轮未真正做内容安全检测时的提示行。 */
.qa-warn { color: #b3543a; font-size: 23rpx; line-height: 1.7; margin: 12rpx 0 4rpx; }
.qa-error { color: #b3543a; font-size: 24rpx; margin: 8rpx 0; }
/* 模型不可用时的降级说明：部门资料仍可查看。 */
.qa-offline { color: #6c7c73; font-size: 22rpx; line-height: 1.7; margin: 4rpx 0 8rpx; }
.qa-cap { color: #a5762b; font-size: 22rpx; margin: 4rpx 0 8rpx; }
.qa-restart { margin-top: 12rpx; text-align: center; }
.qa-restart-button {
  margin: 0;
  display: inline-block;
  background: #f2f6f3;
  color: #2e6e5b;
  font-size: 23rpx;
  line-height: 1.6;
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
}
.qa-note { margin-top: 16rpx; color: #63786d; font-size: 22rpx; line-height: 1.6; }
