/**
 * 部门 AI 问答面板样式（Ticket 07）：列表页与详情页 @import 同一份，类名统一 qa- 前缀。
 * 面板结构与标记见同目录 qa.wxml（做法移植自 PR #29）。样式内容不得出现中文，只允许注释里出现。
 * 液态玻璃：面板是玻璃面；AI 侧气泡用金色薄层，用户侧用红色薄层，失败与提示用琥珀色。
 */
.qa { margin-top: 36rpx; }
.qa-open { margin-top: 24rpx; }
.qa-panel {
  padding: 26rpx 28rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.qa-head { display: flex; align-items: center; }
.qa-badge {
  font-size: 22rpx; padding: 6rpx 18rpx; border-radius: var(--r-pill, 999rpx); color: #fff;
  background: rgba(196,28,35,0.92);
  border: 1rpx solid rgba(255,255,255,0.34);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40);
}
.qa-head-note { color: var(--text-3, #94867f); font-size: 22rpx; margin-left: 14rpx; flex: 1; }
.qa-close { font-size: 24rpx; color: var(--text-3, #94867f); padding: 0; margin: 0 0 0 16rpx; background: none; border: none; line-height: 1; }
.qa-close::after { border: none; }
.qa-row { display: flex; margin-top: 16rpx; }
.qa-row-user { justify-content: flex-end; }
.qa-row-assistant { justify-content: flex-start; }
.qa-bubble { max-width: 86%; border-radius: var(--r-control, 20rpx); padding: 16rpx 20rpx; font-size: 27rpx; line-height: 1.7; }
.qa-bubble-assistant { background: rgba(198,154,40,0.16); border: 1rpx solid rgba(198,154,40,0.28); color: var(--text, #2b2422); }
.qa-bubble-user { background: rgba(196,28,35,0.12); border: 1rpx solid rgba(196,28,35,0.22); color: var(--brand-ink, #7a1a12); }
.qa-bubble-pending { color: var(--text-2, #6b5d57); }
.qa-bubble-text { word-break: break-all; }
/* 被标记的回答（出现语料外记号或被防幻觉复核拦下）：提示行贴在对应回答下方。 */
.qa-flag { color: var(--warn, #9a5b1e); font-size: 23rpx; line-height: 1.7; margin-top: 8rpx; }
.qa-options { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.qa-option {
  background: rgba(255,255,255,0.70);
  border: 2rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-control, 20rpx);
  padding: 16rpx 20rpx;
  margin: 12rpx 12rpx 0 0;
  width: calc(50% - 12rpx);
  box-sizing: border-box;
}
.qa-option-active { border-color: rgba(196,28,35,0.75); background: rgba(196,28,35,0.10); }
.qa-option-name { font-size: 27rpx; font-weight: 600; }
.qa-option-campus { color: var(--text-3, #94867f); font-size: 22rpx; margin-top: 4rpx; }
.qa-transcript { margin-top: 4rpx; }
.qa-suggestions { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.qa-suggestion {
  background: linear-gradient(150deg, rgba(198,154,40,0.20), rgba(198,154,40,0.09));
  border: 1rpx solid rgba(198,154,40,0.30);
  color: var(--brand-ink, #7a1a12);
  font-size: 24rpx;
  padding: 12rpx 22rpx;
  border-radius: var(--r-pill, 999rpx);
  margin: 0 12rpx 12rpx 0;
}
.qa-input-row { display: flex; align-items: center; margin-top: 14rpx; }
.qa-input { flex: 1; background: rgba(255,255,255,0.86); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); border-radius: var(--r-pill, 999rpx); padding: 14rpx 26rpx; font-size: 26rpx; }
.qa-send {
  margin: 0 0 0 14rpx; font-size: 26rpx; border-radius: var(--r-pill, 999rpx); padding: 0 30rpx; line-height: 2.2; color: #fff;
  background: rgba(196,28,35,0.92);
  border: 1rpx solid rgba(255,255,255,0.34);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40);
}
.qa-send[disabled] { background: rgba(196,28,35,0.35); color: #fff; box-shadow: none; }
/* 本轮未真正做内容安全检测时的提示行。 */
.qa-warn { color: var(--warn, #9a5b1e); font-size: 23rpx; line-height: 1.7; margin: 12rpx 0 4rpx; }
.qa-error { color: var(--warn, #9a5b1e); font-size: 24rpx; margin: 8rpx 0; }
/* 模型不可用时的降级说明：部门资料仍可查看。 */
.qa-offline { color: var(--text-3, #94867f); font-size: 22rpx; line-height: 1.7; margin: 4rpx 0 8rpx; }
.qa-cap { color: var(--warn, #9a5b1e); font-size: 22rpx; margin: 4rpx 0 8rpx; }
.qa-restart { margin-top: 12rpx; text-align: center; }
.qa-restart-button {
  margin: 0;
  display: inline-block;
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  color: var(--brand-ink, #7a1a12);
  font-size: 23rpx;
  line-height: 1.6;
  padding: 8rpx 26rpx;
  border-radius: var(--r-pill, 999rpx);
}
.qa-note { margin-top: 16rpx; color: var(--text-3, #94867f); font-size: 22rpx; line-height: 1.6; }

/* 检索来源条（部门动态 RAG）：回答引用了检索命中的动态时才出现。
   色值全部走 app.wxss 令牌（金色细线用 --gold-deep，透明度感由 1rpx 细线承载），
   尺寸依据 docs/design/department-rag/ 设计图。 */
.qa-citations { margin-top: 12rpx; border-top: 1rpx solid var(--gold-deep, #a67f1c); padding-top: 10rpx; }
.qa-citations-head { color: var(--text-3, #94867f); font-size: 21rpx; margin-bottom: 6rpx; }
.qa-citation {
  background: var(--glass, rgba(255,255,255,0.52));
  border: 1rpx solid var(--gold-deep, #a67f1c);
  border-radius: var(--r-control, 20rpx);
  padding: 10rpx 14rpx;
  margin-bottom: 8rpx;
}
.qa-citation-title { font-size: 24rpx; line-height: 1.5; color: var(--text, #2b2422); }
.qa-citation-meta { font-size: 21rpx; line-height: 1.5; color: var(--text-3, #94867f); margin-top: 2rpx; }
