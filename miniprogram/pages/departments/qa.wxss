.qa-entry-shortcut,.qa-open { display:block; width:100%; max-width:none; padding:14px 16px; margin:18px 0; background:#c41c23; color:#fff; border-radius:8px; text-align:left; }
.qa-entry-copy { display:inline-block; max-width:90%; }
.qa-entry-title { font-size:15px; font-weight:600; }
.qa-entry-note { margin-top:5px; font-size:12px; line-height:1.7; }
.qa-entry-arrow { float:right; font-size:23px; }
.qa-panel { margin-top:22px; padding:16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.qa-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:16px; }
.qa-badge { flex:none; white-space:nowrap; color:#8c1614; font-size:16px; font-weight:700; }
.qa-head-note { flex:1; min-width:0; margin-top:5px; color:#746760; font-size:11px; line-height:1.7; }
.qa-close { flex:none; width:52px; min-height:44px; padding:8px; font-size:12px; color:#8c1614; border:1px solid #b9847c; border-radius:7px; }
.qa-row { display:flex; margin-top:12px; }
.qa-row-user { justify-content:flex-end; }
.qa-bubble { max-width:100%; padding:13px 15px; border:1px solid #ded4cf; border-radius:10px; }
.qa-bubble-assistant { background:#fff; }
.qa-bubble-user { background:#faeee9; border-color:#d4b9ac; border-bottom-right-radius:2px; }
.qa-bubble-text { font-size:14px; line-height:1.9; white-space:pre-wrap; word-break:break-all; }
.qa-options { margin-top:14px; }
.qa-option { display:block; width:100%; margin-top:8px; padding:12px; min-height:48px; background:#fff; border:1px solid #ded4cf; border-radius:8px; text-align:left; }
.qa-option-active { border-color:#8c1614; background:#faeee9; }
.qa-option-name { font-size:14px; font-weight:600; }
.qa-option-campus { margin-top:5px; color:#746760; font-size:11px; }
.qa-transcript { margin-top:16px; }
.qa-bubble-pending { color:#746760; }
.qa-suggestions { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.qa-suggestion { min-height:44px; padding:10px 12px; border:1px solid #b9847c; border-radius:7px; color:#8c1614; font-size:12px; text-align:left; }
.qa-input-row { display:flex; align-items:center; gap:8px; margin-top:16px; }
.qa-input { flex:1; min-width:0; height:48px; padding:10px 12px; border:1px solid #aa9990; border-radius:7px; font-size:14px; background:#fff; }
.qa-send { flex:none; width:64px; min-height:48px; padding:10px; background:#c41c23; color:#fff; font-size:14px; }
.qa-warn,.qa-error,.qa-cap { padding:12px; margin-top:12px; border-left:3px solid #9a5b1e; background:#fff4e4; color:#78420e; font-size:13px; line-height:1.8; }
.qa-offline,.qa-note { margin-top:12px; color:#746760; font-size:11px; line-height:1.8; }
.qa-restart { margin-top:12px; }
.qa-restart-button { min-height:44px; color:#8c1614; font-size:12px; }
.qa-citations { margin-top:14px; padding-top:14px; border-top:1px solid #bca99d; }
.qa-citations-head { font-size:12px; color:#8c1614; font-weight:600; }
.qa-citation { min-height:44px; padding:10px 0; border-bottom:1px solid #ded4cf; }
.qa-citation-title { color:#8c1614; font-size:13px; line-height:1.8; }
.qa-citation-meta { margin-top:5px; color:#746760; font-size:11px; }
