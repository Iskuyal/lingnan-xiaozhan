/* 部门问答（设计图 22 / 65）：学生提问走浅红气泡，回答是白卡片；
   资料不足时先说清楚「当前资料里没有这项信息」，并把已查/未收录写在下面。
   金色只出现在失败与额度提示上；红仍是学生要做的动作（发送、重开）。 */
.qa-entry-shortcut,.qa-open { display:block; width:100%; max-width:none; padding:14px 16px; margin:18px 0; background:var(--brand, #c41c23); color:#fff; border-radius:12px; text-align:left; }
.qa-entry-copy { display:inline-block; max-width:90%; }
.qa-entry-title { font-size:15px; font-weight:600; }
.qa-entry-note { margin-top:5px; font-size:12px; line-height:1.7; }
.qa-entry-arrow { float:right; font-size:23px; }
.qa-panel { margin-top:22px; padding:16px; border-radius:var(--r-hub, 36rpx); background:var(--surface, #ffffff); }
.qa-head { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
.qa-badge { flex:none; white-space:nowrap; color:var(--brand, #c41c23); font-size:13px; font-weight:650; }
.qa-head-note { flex:1; min-width:0; color:var(--text-2, #6b5d57); font-size:11px; line-height:1.7; }
.qa-close { flex:none; width:52px; min-height:44px; padding:8px; color:var(--text-2, #6b5d57); font-size:12px; border:1px solid var(--line, #ded4cf); border-radius:10px; }
.qa-row { display:flex; margin-top:10px; }
.qa-row-user { justify-content:flex-end; }
.qa-bubble { max-width:100%; padding:13px 15px; border-radius:14px; }
.qa-bubble-assistant { background:var(--canvas, #f5f6f8); }
.qa-bubble-user { background:var(--brand-soft, #fff0ef); border-bottom-right-radius:4px; }
.qa-bubble-text { font-size:14px; line-height:1.85; white-space:pre-wrap; word-break:break-word; }
.qa-options { margin-top:14px; }
.qa-option { display:block; width:100%; margin-top:8px; padding:12px; min-height:48px; background:var(--surface, #ffffff); border:1px solid var(--line-soft, #ececef); border-radius:12px; text-align:left; }
.qa-option-active { border-color:var(--brand-line, #e8a5a8); background:var(--brand-soft, #fff0ef); }
.qa-option-name { font-size:14px; font-weight:650; }
.qa-option-campus { margin-top:5px; color:var(--text-2, #6b5d57); font-size:11px; }
.qa-transcript { margin-top:12px; }
.qa-bubble-pending { color:var(--text-2, #6b5d57); }
.qa-suggestions { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.qa-suggestion { min-height:44px; padding:10px 12px; border:1px solid var(--line-soft, #ececef); border-radius:10px; background:var(--surface, #ffffff); color:var(--text, #2b2422); font-size:12px; text-align:left; }
.qa-input-row { display:flex; align-items:center; gap:8px; margin-top:16px; }
.qa-input { flex:1; min-width:0; height:48px; padding:10px 14px; border:1px solid var(--control-line, #aa9990); border-radius:14px; font-size:14px; background:var(--surface, #ffffff); }
.qa-send { flex:none; width:64px; min-height:48px; padding:10px; background:var(--brand, #c41c23); color:#fff; border-radius:12px; font-size:14px; }
.qa-warn,.qa-error,.qa-cap { padding:12px 14px; margin-top:12px; border-radius:12px; background:#fff5e8; color:#83501e; font-size:13px; line-height:1.8; }
.qa-error { background:var(--danger-soft, #fff0ef); color:#a42127; }
.qa-offline,.qa-note { margin-top:10px; color:var(--text-3, #746760); font-size:11px; line-height:1.8; }
.qa-restart { margin-top:12px; }
.qa-restart-button { min-height:44px; color:var(--brand, #c41c23); font-size:12px; }
.qa-citations { margin-top:12px; padding-top:12px; border-top:1px solid var(--line-soft, #ececef); }
.qa-citations-head { font-size:12px; color:var(--brand, #c41c23); font-weight:650; }
.qa-citation { min-height:44px; padding:10px 0; }
.qa-citation + .qa-citation { border-top:1px solid var(--line-soft, #ececef); }
.qa-citation-title { color:var(--text, #2b2422); font-size:13px; line-height:1.8; }
.qa-citation-meta { margin-top:4px; color:var(--text-2, #6b5d57); font-size:11px; }
