@import "../qa.wxss";

/**
 * 部门详情页：液态玻璃——各区块是高不透明度的玻璃卡，缺失信息如实呈现。
 */
.department-detail { padding-bottom: 8rpx; }
.department-detail .qa { margin-top: 32rpx; }
.department-detail .section-title { color: var(--brand-deep, #8c1614); letter-spacing: 2rpx; }
.department-name { font-size: 42rpx; font-weight: 700; line-height: 1.4; margin-top: 12rpx; color: var(--brand-deep, #8c1614); letter-spacing: 1rpx; }
.department-campus-line { display: flex; align-items: baseline; margin-top: 18rpx; font-size: 25rpx; color: var(--text-2, #6b5d57); }
.department-campus-label { color: var(--text-3, #94867f); margin-right: 14rpx; font-size: 23rpx; }
.department-campus-note { margin-top: 12rpx; color: var(--text-3, #94867f); font-size: 22rpx; line-height: 1.7; }
.detail-block {
  margin-top: 32rpx; padding: 30rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.detail-copy { margin-top: 18rpx; color: var(--text-2, #6b5d57); font-size: 28rpx; line-height: 1.9; }
.detail-unit-note { margin-top: 16rpx; }
.detail-units { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.detail-unit {
  margin: 12rpx 12rpx 0 0; padding: 10rpx 22rpx; font-size: 24rpx;
  background: rgba(196,28,35,0.10); border: 1rpx solid rgba(196,28,35,0.22);
  color: var(--brand-ink, #7a1a12); border-radius: var(--r-pill, 999rpx);
}
.detail-missing {
  margin-top: 18rpx; padding: 18rpx 22rpx; font-size: 25rpx; line-height: 1.7;
  background: var(--warn-soft, rgba(255,244,228,0.86)); border: 1rpx solid var(--warn-line, rgba(214,160,90,0.55));
  color: var(--warn, #9a5b1e); border-radius: var(--r-control, 20rpx);
}
.detail-contact { margin-top: 14rpx; color: var(--text-2, #6b5d57); font-size: 27rpx; }
.detail-activity { padding: 20rpx 0; border-bottom: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); }
.detail-activity:last-child { border-bottom: 0; padding-bottom: 0; }
.detail-activity-title { color: var(--text, #2b2422); font-size: 27rpx; line-height: 1.7; }
.detail-activity-date { margin-top: 8rpx; color: var(--text-3, #94867f); font-size: 22rpx; }
.detail-source { margin-top: 36rpx; padding-top: 26rpx; border-top: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); }
.detail-source-label { font-size: 23rpx; color: var(--text-3, #94867f); }
.detail-verified-date { color: var(--text-3, #94867f); font-size: 22rpx; margin-top: 4rpx; }
.source-button {
  color: var(--brand-ink, #7a1a12); margin: 20rpx 0 0; padding: 18rpx 24rpx; font-size: 25rpx; line-height: 1.5;
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-pill, 999rpx);
}
