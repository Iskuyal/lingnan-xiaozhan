@import "../qa.wxss";

.department-profile {
  margin:-42rpx -36rpx 0; padding:30rpx 36rpx 25rpx;
  border-left:6rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9); color:var(--text, #2b2422);
}
.department-profile .eyebrow { color:var(--text-3, #746760); }
.department-profile .department-name { margin-top:8rpx; color:var(--brand-deep, #8c1614); font-size:46rpx; line-height:1.35; }
.department-campus-line { margin-top:10rpx; display:flex; gap:12rpx; align-items:baseline; color:var(--text-2, #6b5d57); font-size:21rpx; }
.department-campus-label { color:var(--text-3, #746760); }
.department-campus-note { margin-top:12rpx; padding:11rpx 12rpx; border-left:6rpx solid var(--gold, #c69a28); background:rgba(255,255,255,0.65); color:var(--text-2, #6b5d57); font-size:20rpx; line-height:1.65; }
.detail-block { padding:23rpx 0 21rpx; border-bottom:1rpx solid rgba(43,36,34,0.15); }
.detail-block .section-title { margin-bottom:10rpx; font-size:28rpx; }
.detail-copy { color:var(--text-2, #6b5d57); font-size:25rpx; line-height:1.8; }
.detail-unit-note { margin-bottom:10rpx; }
.detail-units { display:flex; flex-wrap:wrap; gap:10rpx; }
.detail-unit { padding:8rpx 14rpx; border:1rpx solid rgba(198,154,40,0.55); color:var(--brand-ink, #7a1a12); background:rgba(198,154,40,0.12); font-size:21rpx; }
.detail-missing { padding:17rpx 18rpx; border-left:6rpx solid var(--warn, #9a5b1e); border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); border-left-width:6rpx; background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); font-size:22rpx; line-height:1.7; }
.detail-contact,.detail-activity { padding:10rpx 0; color:var(--text-2, #6b5d57); font-size:23rpx; line-height:1.65; }
.detail-activity + .detail-activity { border-top:1rpx solid rgba(43,36,34,0.12); }
.detail-activity-title { color:var(--text, #2b2422); font-weight:600; }
.detail-activity-date { margin-top:4rpx; color:var(--text-3, #746760); font-size:20rpx; }
.detail-source { margin-top:22rpx; padding-top:17rpx; border-top:1rpx solid rgba(43,36,34,0.16); }
.detail-source-label,.detail-verified-date { color:var(--text-3, #746760); font-size:20rpx; line-height:1.6; }
.detail-verified-date { margin-top:4rpx; }
.source-button { margin-top:13rpx; min-height:84rpx; padding:12rpx 18rpx; border:1rpx solid rgba(122,26,18,0.35); color:var(--brand-ink, #7a1a12); }
.department-detail > .home-button { margin-top:16rpx; }
