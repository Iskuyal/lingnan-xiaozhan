@import "../qa.wxss";
.department-profile { margin-bottom:22px; }
.department-profile .department-name { margin:8px 0; font-size:26px; font-weight:700; line-height:1.4; }
.department-campus-line { display:flex; gap:12px; margin-top:12px; font-size:12px; color:#746760; }
.department-campus-label { flex:none; }
.department-campus-note { margin-top:8px; font-size:11px; line-height:1.8; color:#746760; }
.detail-block { margin-top:24px; }
.detail-copy,.detail-contact { margin-top:12px; color:#2b2422; font-size:14px; line-height:1.9; }
.detail-unit-note { color:#6b5d57; font-size:13px; }
.detail-units { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.detail-unit { padding:8px 12px; background:#fff; border:1px solid #ded4cf; border-radius:7px; color:#8c1614; font-size:13px; }
.detail-missing { margin-top:12px; padding:14px 15px; background:#fff; border-left:3px solid #ded4cf; color:#6b5d57; font-size:13px; line-height:1.8; }
.detail-activity { margin-top:12px; padding:16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.detail-activity-title { font-size:15px; line-height:1.7; font-weight:600; }
.detail-activity-date { margin-top:10px; color:#746760; font-size:11px; }
.detail-source { margin-top:24px; padding-top:16px; border-top:1px solid #bca99d; }
.detail-source-label { color:#8c1614; font-size:13px; font-weight:600; }
.detail-verified-date { margin-top:8px; color:#746760; font-size:11px; }
