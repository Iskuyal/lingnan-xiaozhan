<import src="../qa.wxml" />
<view class="u2-page">
  <block wx:if="{{detail}}">
    <view id="department-detail" class="dept-detail">
      <view class="dept-profile">
        <view class="dept-mark">{{mark}}</view>
        <view class="dept-profile-main">
          <view class="u2-h2">{{detail.name}}</view>
          <view class="u2-xs u2-muted">学校官网保存资料 · {{detail.verifiedAt}}</view>
        </view>
      </view>

      <view class="u2-notice u2-notice-info dept-campus-notice">
        适用校区以原资料标注为准（{{detail.campusLabel}}）；未标注时不推断。
      </view>

      <view class="u2-section u2-section-first"><view class="u2-section-title">组织介绍</view></view>
      <view class="u2-card">
        <view class="u2-body" id="department-introduction">{{detail.introduction}}</view>
      </view>

      <view class="u2-section"><view class="u2-section-title">下设部门</view></view>
      <view class="u2-card">
        <view class="dept-units">
          <text wx:for="{{detail.units}}" wx:key="*this" class="u2-tag dept-unit">{{item}}</text>
        </view>
        <view class="u2-card-copy">{{detail.unitNote}}</view>
        <button id="department-detail-qa-shortcut" class="u2-btn u2-btn-soft dept-ask" hover-class="pressed" bindtap="scrollToQa">依据这些资料提问</button>
      </view>

      <view class="u2-section"><view class="u2-section-title">联系与动态</view></view>
      <view class="u2-card">
        <view class="dept-kv">
          <text class="dept-kv-key">公开联系方式</text>
          <text wx:if="{{detail.contactMissing}}" id="department-contact" class="dept-kv-val">{{detail.contactMissingText}}</text>
          <text wx:else id="department-contact" class="dept-kv-val">{{detail.contactItems[0].label}}：{{detail.contactItems[0].value}}</text>
        </view>
        <view class="dept-kv dept-kv-block">
          <text class="dept-kv-key">组织动态</text>
          <view wx:if="{{detail.activityMissing}}" id="department-activities" class="dept-kv-val">{{detail.activityMissingText}}</view>
          <view wx:else id="department-activities" class="dept-activities">
            <view wx:for="{{detail.activities}}" wx:key="sourceUrl" class="dept-activity">
              <view class="dept-activity-title">{{item.title}}</view>
              <view class="dept-activity-meta">{{item.publishedAt}} · 已收录活动</view>
              <button class="u2-btn u2-btn-secondary dept-activity-copy" hover-class="pressed" data-url="{{item.sourceUrl}}" bindtap="copyActivitySource">复制动态原文链接</button>
            </view>
          </view>
        </view>
        <view class="u2-source">
          <view class="u2-source-line">资料来源：{{detail.sourceLabel}}</view>
          <view class="u2-source-line">资料核查 {{detail.verifiedAt}} · 未重新核查现状</view>
        </view>
      </view>

      <view id="department-qa-panel">
        <template
          is="department-qa"
          data="{{qaOpen: qaOpen, qaPrompt: qaPrompt, qaMessages: qaMessages, qaOptions: qaOptions, qaSuggestionList: qaSuggestionList, qaInput: qaInput, qaSending: qaSending, qaError: qaError, qaCapWarning: qaCapWarning, qaSafetyNote: qaSafetyNote, qaSourceNote: qaSourceNote, qaOfflineNote: qaOfflineNote}}"
        />
      </view>

      <view class="u2-actions">
        <button id="ask-organization" class="u2-btn u2-btn-primary" hover-class="pressed" bindtap="scrollToQa">问问这个组织</button>
        <button id="back-to-list" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="goBackToList">返回部门列表</button>
      </view>

      <view class="u2-source">
        <view class="u2-source-line">来源链接：{{detail.sourceUrl}}</view>
        <button id="copy-detail-source" class="u2-btn u2-btn-secondary dept-source-button" hover-class="pressed" bindtap="copySource">复制来源链接</button>
      </view>
    </view>
  </block>

  <view wx:else id="department-not-found" class="u2-empty">
    <view class="u2-empty-icon">?</view>
    <view class="u2-empty-title">{{notFoundTitle}}</view>
    <view class="u2-empty-copy">{{notFoundCopy}}</view>
    <view class="u2-actions">
      <button id="not-found-back" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="goBackToList">返回部门列表</button>
    </view>
  </view>
</view>