<import src="./qa.wxml" />
<view class="page">
  <view class="departments-heading">
    <view class="eyebrow">已核实名录</view>
    <view class="section-title">学生部门</view>
    <view class="departments-intro">以下组织来自学校官网「学生组织」页面，介绍与下设部门按原文转录。有疑问可以直接问 AI 助手，它只依据这些已核实资料回答。</view>
  </view>

  <view wx:if="{{!view.isEmpty}}" id="departments-list" class="departments-list">
    <view
      wx:for="{{view.items}}"
      wx:key="id"
      id="department-{{item.id}}"
      class="department-item"
      hover-class="pressed"
      data-id="{{item.id}}"
      bindtap="openDetail"
      aria-role="button"
      aria-label="查看{{item.name}}，{{item.campusLabel}}"
    >
      <view class="department-main">
        <view class="department-name">{{item.name}}</view>
        <view class="department-campus">{{item.campusLabel}}</view>
      </view>
      <text class="department-chevron">›</text>
    </view>
  </view>

  <view wx:else id="departments-empty" class="departments-empty">
    <view class="status-title">{{view.emptyTitle}}</view>
    <view class="status-copy">{{view.emptyCopy}}</view>
  </view>

  <view id="departments-source" class="departments-source">
    <view class="departments-source-label">资料来源：{{view.source.label}}</view>
    <view class="departments-verified-date">核查于 {{view.source.verifiedAt}}</view>
    <view class="departments-source-note">{{view.source.note}}</view>
  </view>

  <template
    is="department-qa"
    data="{{qaOpen: qaOpen, qaPrompt: qaPrompt, qaMessages: qaMessages, qaOptions: qaOptions, qaSuggestionList: qaSuggestionList, qaInput: qaInput, qaSending: qaSending, qaError: qaError, qaCapWarning: qaCapWarning, qaSafetyNote: qaSafetyNote, qaSourceNote: qaSourceNote, qaOfflineNote: qaOfflineNote}}"
  />

  <button id="back-home" class="home-button" hover-class="pressed" bindtap="goHome">返回首页</button>
</view>
