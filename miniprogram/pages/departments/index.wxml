<import src="./qa.wxml" />
<view class="u2-page">
  <view class="u2-h1 dept-title">在这里，<br/>找到同路的人。</view>
  <view class="u2-lead">浏览项目已保存的公开组织资料，了解职责，也可以依据资料提问。</view>

  <view id="department-qa-shortcut" class="u2-card dept-qa-card" hover-class="pressed" bindtap="scrollToQa" aria-roledescription="button" aria-label="跳到部门问答">
    <view class="dept-qa-icon"><image class="u2-icon-img" src="/assets/ui-v2/v2-defense-light.svg" /></view>
    <view class="dept-qa-copy">
      <view class="u2-card-title">不确定找哪个部门？</view>
      <view class="u2-row-sub">问问部门，先找到资料中的答案</view>
    </view>
    <text class="dept-qa-arrow">→</text>
  </view>

  <view class="u2-section">
    <view class="u2-section-title">已收录组织 · 节选</view>
    <view class="u2-section-note">{{view.total}} 个</view>
  </view>

  <view wx:if="{{!view.isEmpty}}" id="departments-list" class="u2-list">
    <view
      wx:for="{{view.items}}"
      wx:key="id"
      id="department-{{item.id}}"
      class="department-item"
      hover-class="pressed"
      data-id="{{item.id}}"
      bindtap="openDetail"
      aria-role="button"
      aria-label="查看{{item.name}}，{{item.campusLabel}}"
    >
      <view class="department-mark">{{item.mark}}</view>
      <view class="u2-row-main department-main">
        <view class="department-name u2-row-title">{{item.name}}</view>
        <view class="department-campus u2-row-sub">{{item.campusLabel}}</view>
      </view>
      <text class="u2-chev">›</text>
    </view>
  </view>

  <view wx:else id="departments-empty" class="u2-empty">
    <view class="u2-empty-icon">部</view>
    <view class="u2-empty-title">{{view.emptyTitle}}</view>
    <view class="u2-empty-copy">{{view.emptyCopy}}</view>
  </view>

  <view id="department-qa-panel">
    <template
      is="department-qa"
      data="{{qaOpen: qaOpen, qaPrompt: qaPrompt, qaMessages: qaMessages, qaOptions: qaOptions, qaSuggestionList: qaSuggestionList, qaInput: qaInput, qaSending: qaSending, qaError: qaError, qaCapWarning: qaCapWarning, qaSafetyNote: qaSafetyNote, qaSourceNote: qaSourceNote, qaOfflineNote: qaOfflineNote}}"
    />
  </view>

  <view id="departments-source" class="u2-source">
    <view class="u2-source-line">资料来源：{{view.source.label}}</view>
    <view class="u2-source-line">核查于 {{view.source.verifiedAt}}；本轮未重新联网核查。</view>
    <view class="u2-source-line">{{view.source.note}}</view>
    <button id="copy-directory-source" class="u2-btn u2-btn-secondary dept-source-button" hover-class="pressed" bindtap="copySource">复制官网链接</button>
  </view>

  <view class="u2-actions">
    <button id="back-home" class="u2-btn u2-btn-secondary" hover-class="pressed" bindtap="goHome">返回首页</button>
  </view>
</view>