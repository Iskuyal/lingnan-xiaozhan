<view class="page">
  <view class="departments-heading">
    <view class="eyebrow">已核实名录</view>
    <view class="section-title">学生部门</view>
    <view class="departments-intro">以下组织来自学校官网「学生组织」页面，介绍与下设部门按原文转录。</view>
  </view>

  <view wx:if="{{!view.isEmpty}}" id="departments-list" class="departments-list">
    <view
      wx:for="{{view.items}}"
      wx:key="id"
      id="department-{{item.id}}"
      class="department-item"
      hover-class="pressed"
      data-id="{{item.id}}"
      bindtap="openDetail"
      aria-role="button"
      aria-label="查看{{item.name}}，{{item.campusLabel}}"
    >
      <view class="department-main">
        <view class="department-name">{{item.name}}</view>
        <view class="department-campus">{{item.campusLabel}}</view>
      </view>
      <text class="department-chevron">›</text>
    </view>
  </view>

  <view wx:else id="departments-empty" class="departments-empty">
    <view class="status-title">{{view.emptyTitle}}</view>
    <view class="status-copy">{{view.emptyCopy}}</view>
  </view>

  <view id="departments-source" class="departments-source">
    <view class="departments-source-label">资料来源：{{view.source.label}}</view>
    <view class="departments-verified-date">核查于 {{view.source.verifiedAt}}</view>
    <view class="departments-source-note">{{view.source.note}}</view>
  </view>

  <view id="dept-qa" class="qa">
    <button wx:if="{{!qaOpen}}" id="qa-open" class="home-button qa-open" hover-class="pressed" bindtap="openQa">问问 AI：部门答疑</button>
    <view wx:else class="qa-panel">
      <view class="qa-head">
        <view class="qa-title">部门答疑</view>
        <button class="qa-close" hover-class="pressed" bindtap="closeQa">收起</button>
      </view>
      <view class="qa-messages">
        <block wx:for="{{qaMessages}}" wx:key="index">
          <view class="qa-msg {{item.role === 'user' ? 'qa-msg-user' : 'qa-msg-ai'}}">{{item.text}}</view>
          <view class="qa-flag" wx:if="{{item.warning}}">{{item.warning}}</view>
        </block>
      </view>
      <view id="qa-safety-note" class="qa-warn" wx:if="{{qaSafetyNote !== ''}}">{{qaSafetyNote}}</view>
      <view class="qa-options" wx:if="{{qaOptions.length > 0}}">
        <button wx:for="{{qaOptions}}" wx:key="id" class="qa-chip" hover-class="pressed" data-id="{{item.id}}" bindtap="openDetail">{{item.name}}</button>
      </view>
      <view class="qa-error" wx:if="{{qaError !== ''}}">{{qaError}}</view>
      <view class="qa-cap" wx:if="{{qaCapWarning !== ''}}">{{qaCapWarning}}</view>
      <view class="qa-input-row">
        <input id="qa-input" class="qa-input" value="{{qaInput}}" bindinput="onQaInput" placeholder="例如：校学生会下设哪些部门？" confirm-type="send" bindconfirm="sendQuestion" />
        <button id="qa-send" class="qa-send" hover-class="pressed" disabled="{{qaSending}}" bindtap="sendQuestion">发送</button>
      </view>
      <view class="qa-note">{{qaSourceNote}}</view>
    </view>
  </view>

  <button id="back-home" class="home-button" hover-class="pressed" bindtap="goHome">返回首页</button>
</view>
