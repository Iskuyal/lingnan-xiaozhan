@import "./qa.wxss";
/* 学生部门（设计图 20）：抬头 + 问答入口卡 + 组织名录 + 出处。 */
.dept-title { font-size:30px; }
.dept-qa-card { display:flex; align-items:center; gap:13px; margin:20px 0 4px; padding:16px; text-align:left; width:100%; max-width:none; }
.dept-qa-icon { flex:none; width:44px; height:44px; display:flex; align-items:center; justify-content:center; border-radius:13px; background:var(--brand, #c41c23); }
.dept-qa-icon image { width:22px; height:22px; }
.dept-qa-copy { flex:1; min-width:0; }
.dept-qa-arrow { flex:none; color:var(--text, #2b2422); font-size:18px; }
.department-mark { flex:none; width:44px; height:44px; display:flex; align-items:center; justify-content:center; border-radius:13px; background:var(--brand-soft, #fff0ef); color:var(--brand, #c41c23); font-size:15px; font-weight:700; }
.department-item { display:flex; align-items:center; gap:13px; min-height:78px; padding:14px 0; }
.department-item + .department-item { border-top:1px solid var(--line-soft, #ececef); }
.department-main { flex:1; min-width:0; }
.dept-source-button { margin-top:12px; }