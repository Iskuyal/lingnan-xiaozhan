@import "./qa.wxss";

.departments-heading { padding-bottom:18rpx; border-bottom:1rpx solid rgba(43,36,34,0.16); }
.departments-heading .section-title { margin-top:8rpx; font-size:48rpx; color:var(--brand-deep, #8c1614); }
.departments-intro { margin-top:12rpx; color:var(--text-2, #6b5d57); font-size:24rpx; line-height:1.75; }
.departments-count { margin-top:16rpx; padding:18rpx 20rpx; display:flex; align-items:center; justify-content:space-between; background:var(--paper-shade, #faeee9); border-left:6rpx solid var(--gold, #c69a28); }
.departments-count-label { color:var(--brand-deep, #8c1614); font-size:24rpx; font-weight:700; }
.departments-count-value { color:var(--text-2, #6b5d57); font-size:22rpx; }
.departments-list { display:flex; flex-direction:column; margin-top:10rpx; }
.department-item {
  min-height:138rpx; display:flex; align-items:center; gap:20rpx;
  padding:16rpx 0; border-bottom:1rpx solid rgba(43,36,34,0.15);
}
.department-mark {
  width:48rpx; height:48rpx; flex:none; display:flex; align-items:center; justify-content:center;
  border:1rpx solid rgba(198,154,40,0.65); color:var(--brand-ink, #7a1a12); font-size:22rpx; font-weight:700;
}
.department-main { min-width:0; flex:1; }
.department-name { color:var(--text, #2b2422); font-size:29rpx; line-height:1.45; font-weight:700; }
.department-campus { margin-top:4rpx; color:var(--text-3, #746760); font-size:20rpx; line-height:1.5; }
.department-chevron { color:var(--gold-deep, #a67f1c); font-size:35rpx; line-height:1; }
.departments-empty { padding:34rpx 0 10rpx; }
.departments-source { margin-top:30rpx; padding-top:20rpx; border-top:1rpx solid rgba(43,36,34,0.16); }
.departments-source-label,.departments-verified-date { color:var(--text-3, #746760); font-size:20rpx; line-height:1.6; }
.departments-verified-date { margin-top:4rpx; }
.departments-source-note { margin-top:12rpx; color:var(--text-2, #6b5d57); font-size:21rpx; line-height:1.7; }
