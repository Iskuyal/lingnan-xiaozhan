/* 失物招领页面共享样式(版式数字依据 docs/design/lost-found/ 设计图)。 */
.page { padding-bottom: 40rpx; }
.nav {
  background: linear-gradient(150deg, var(--brand, #c41c23), var(--brand-deep, #8c1614));
  color: #fff; padding: 28rpx 32rpx 56rpx;
}
.nav-title { font-size: 36rpx; font-weight: 700; }
.nav-sub { font-size: 23rpx; opacity: 0.85; margin-top: 8rpx; }

.seg {
  display: flex; margin: -32rpx 32rpx 0; background: var(--glass-strong, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); border-radius: 999rpx; padding: 6rpx;
  position: relative; z-index: 1;
}
.seg-item { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 999rpx; font-size: 27rpx; color: var(--text-2, #6b5d57); }
.seg-item.on { background: var(--brand, #c41c23); color: #fff; font-weight: 600; }

.filters { display: flex; gap: 16rpx; margin: 24rpx 32rpx 0; }
.chip {
  flex-shrink: 0; border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  background: var(--glass-strong, rgba(255,255,255,0.72));
  border-radius: 999rpx; padding: 10rpx 24rpx; font-size: 23rpx; color: var(--text-2, #6b5d57);
  margin: 0; line-height: 1.5;
}
.chip.on { border-color: var(--brand, #c41c23); color: var(--brand, #c41c23); background: rgba(196,28,35,0.08); }

.card {
  margin: 24rpx 32rpx 0; background: var(--glass-strong, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); border-radius: 32rpx; padding: 24rpx 28rpx;
}
.card-head { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.badge { font-size: 20rpx; font-weight: 600; border-radius: 12rpx; padding: 4rpx 16rpx; }
.badge-lost { background: rgba(196,28,35,0.12); color: var(--brand, #c41c23); }
.badge-found { background: rgba(198,154,40,0.18); color: var(--gold-deep, #a67f1c); }
.badge-status { background: rgba(148,134,127,0.15); color: var(--text-2, #6b5d57); }
.badge-warn { background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e); }
.card-title { font-size: 29rpx; font-weight: 600; margin-top: 12rpx; }
.card-desc { font-size: 24rpx; color: var(--text-2, #6b5d57); margin-top: 8rpx; line-height: 1.5; }
.card-meta { font-size: 22rpx; color: var(--text-3, #746760); margin-top: 16rpx; display: flex; gap: 20rpx; flex-wrap: wrap; }

.form { margin: 24rpx 32rpx 0; }
.field { margin-bottom: 24rpx; }
.field-label { font-size: 24rpx; color: var(--text-2, #6b5d57); margin-bottom: 10rpx; }
.field-label .req { color: var(--brand, #c41c23); }
.input {
  width: 100%; box-sizing: border-box; border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  background: var(--glass-strong, rgba(255,255,255,0.72)); border-radius: 20rpx; padding: 18rpx 24rpx;
  font-size: 26rpx; min-height: 44rpx;
}
.textarea { min-height: 176rpx; }
.field-hint { font-size: 22rpx; color: var(--text-3, #746760); margin-top: 8rpx; }
.field-error { font-size: 22rpx; color: var(--warn, #9a5b1e); margin-top: 8rpx; }

.btn-row { margin: 32rpx 32rpx 0; display: flex; gap: 20rpx; }
.btn { flex: 1; text-align: center; border-radius: 999rpx; padding: 20rpx 0; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.btn-primary { background: var(--brand, #c41c23); color: #fff; }
.btn-ghost { border: 1rpx solid var(--brand, #c41c23); color: var(--brand, #c41c23); background: transparent; }
.btn-plain { border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); color: var(--text-2, #6b5d57); background: var(--glass-strong, rgba(255,255,255,0.72)); }
.btn-disabled { background: rgba(148,134,127,0.4); color: #fff; }

.note { margin: 24rpx 32rpx 0; background: var(--warn-soft, rgba(255,244,228,0.86)); border: 1rpx solid var(--warn-line, rgba(214,160,90,0.55));
  border-radius: 24rpx; padding: 18rpx 24rpx; font-size: 24rpx; color: var(--warn, #9a5b1e); line-height: 1.6; }
.note-info { margin: 24rpx 32rpx 0; background: rgba(255,255,255,0.6); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: 24rpx; padding: 18rpx 24rpx; font-size: 24rpx; color: var(--text-2, #6b5d57); line-height: 1.6; }

.empty { text-align: center; padding: 96rpx 32rpx; }
.empty-icon { font-size: 80rpx; opacity: 0.4; }
.empty-text { font-size: 26rpx; color: var(--text-3, #746760); margin-top: 16rpx; }

.evidence { margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; }
.evidence-line { margin-top: 6rpx; }
.evidence-tag { font-weight: 700; margin-right: 8rpx; }
.evidence-sim { color: #2e6b3e; }
.evidence-con { color: var(--brand, #c41c23); }
.evidence-unc { color: var(--text-3, #746760); }

.claim-row { display: flex; align-items: center; gap: 16rpx; }
.claim-body { flex: 1; }
.claim-actions { display: flex; gap: 12rpx; }
.mini-btn { border-radius: 999rpx; padding: 12rpx 24rpx; font-size: 23rpx; font-weight: 600; margin: 0; line-height: 1.5; }
.mini-primary { background: var(--brand, #c41c23); color: #fff; }
.mini-ghost { border: 1rpx solid var(--brand, #c41c23); color: var(--brand, #c41c23); background: transparent; }
.mini-warn { border: 1rpx solid var(--warn, #9a5b1e); color: var(--warn, #9a5b1e); background: transparent; }
