<view class="page">
  <view class="nav">
    <view class="nav-title">失物招领</view>
    <view class="nav-sub">只做匹配与线索，不代判归属 · 请勿公开联系方式</view>
  </view>

  <view class="seg">
    <view class="seg-item {{activeType === 'found' ? 'on' : ''}}" data-type="found" bindtap="switchType">拾获</view>
    <view class="seg-item {{activeType === 'lost' ? 'on' : ''}}" data-type="lost" bindtap="switchType">丢失</view>
  </view>

  <scroll-view class="filters" scroll-x>
    <button
      wx:for="{{categories}}"
      wx:key="*this"
      class="chip {{activeCategory === item ? 'on' : ''}}"
      hover-class="pressed"
      data-category="{{item}}"
      bindtap="pickCategory"
    >{{item}}</button>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty"><view class="empty-text">正在读取…</view></view>

  <view wx:elif="{{error !== ''}}">
    <view class="empty">
      <view class="empty-icon">⚠️</view>
      <view class="empty-text">{{error}}</view>
    </view>
    <view class="btn-row"><button class="btn btn-plain" bindtap="retry">重新加载</button></view>
  </view>

  <block wx:else>
    <view wx:if="{{posts.length === 0}}" class="empty">
      <view class="empty-icon">🔍</view>
      <view class="empty-text">没有符合条件的帖子，发布一条试试</view>
    </view>
    <view
      wx:for="{{posts}}"
      wx:key="postId"
      id="lost-post-{{item.postId}}"
      class="card"
      hover-class="pressed"
      data-id="{{item.postId}}"
      bindtap="openDetail"
    >
      <view class="card-head">
        <text class="badge {{item.type === 'lost' ? 'badge-lost' : 'badge-found'}}">{{item.type === 'lost' ? '丢失' : '拾获'}}</text>
        <text class="badge">{{item.category}}</text>
      </view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.description}}</view>
      <view class="card-meta">
        <text>{{item.timeRange.start}} ~ {{item.timeRange.end}}</text>
        <text>{{item.locationArea}}</text>
      </view>
    </view>
  </block>

  <view class="btn-row">
    <button class="btn btn-plain" bindtap="goMine">我的失物招领</button>
    <button id="lost-found-publish" class="btn btn-primary" bindtap="goPublish">+ 发布信息</button>
  </view>

  <view class="note-info">失物招领目前为原型验证阶段：候选为规则召回，未经 AI 图文比对；认领与交接请在线下公共场所进行。</view>
</view>
