.settings-heading { display:flex; align-items:flex-start; gap:12px; margin-bottom:20px; }
.settings-heading-copy { flex:1; min-width:0; }
.settings-lead { font-size:20px; font-weight:700; line-height:1.5; }
.settings-intro { margin-top:8px; font-size:13px; line-height:1.8; color:#6b5d57; }
.settings-back { flex:none; min-height:44px; padding:10px; font-size:12px; color:#8c1614; }
.settings-card { margin-top:22px; }
.settings-field { margin-top:16px; }
.settings-label { margin-bottom:8px; font-size:13px; font-weight:600; }
.settings-input { width:100%; min-height:48px; padding:12px 13px; border:1px solid #aa9990; border-radius:7px; background:#fff; font-size:14px; }
.settings-row { display:flex; align-items:center; gap:10px; }
.settings-input-flex { flex:1; min-width:0; }
.settings-input-narrow { width:92px; }
.settings-input-center { text-align:center; }
.settings-pills { display:flex; flex-wrap:wrap; gap:8px; }
.settings-pill { min-height:44px; padding:10px 14px; border:1px solid #aa9990; border-radius:7px; background:#fff; font-size:13px; }
.settings-pill-on { background:#8c1614; color:#fff; border-color:#8c1614; }
.settings-callout,.settings-note { padding:14px 15px; margin-top:16px; border-left:3px solid #ded4cf; background:#fff; font-size:13px; line-height:1.8; color:#6b5d57; }
.settings-callout-warn { border-color:#9a5b1e; background:#fff4e4; color:#78420e; }
.settings-hint { margin-top:7px; color:#746760; font-size:11px; line-height:1.8; }
.settings-hint-warn,.settings-error { color:#9a5b1e; }
.settings-preview { padding:14px 15px; margin-top:16px; border:1px solid #ded4cf; background:#fff; border-radius:8px; font-size:13px; line-height:1.8; }
.settings-group-toggle { display:flex; align-items:center; gap:12px; padding:14px 0; margin-top:10px; border-bottom:1px solid #ded4cf; min-height:52px; }
.settings-group-copy { flex:1; }
.settings-group-title { font-size:15px; font-weight:600; }
.settings-group-state { margin-top:4px; font-size:11px; color:#746760; }
.settings-group-chevron { color:#8c1614; font-size:23px; }
.settings-time-row { display:flex; align-items:center; gap:10px; margin-top:12px; }
.settings-time-no { flex:1; font-size:13px; }
.settings-time-fields { display:flex; align-items:center; gap:8px; }
.settings-time-sep { font-size:12px; color:#746760; }
.settings-secondary { display:block; width:100%; min-height:48px; padding:12px; margin-top:16px; border:1px solid #b9847c; color:#8c1614; background:#fff; font-size:13px; }
.settings-gap { height:12px; }
.settings-loading { padding-top:36px; font-size:14px; color:#6b5d57; }
.settings-error { margin-top:14px; font-size:13px; line-height:1.8; }
