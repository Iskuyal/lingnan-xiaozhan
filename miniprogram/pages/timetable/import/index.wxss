/**
 * 导入确认页样式：液态玻璃——玻璃卡与金色薄层引导条，待核对项用琥珀色。
 * 失败与阻断项一律琥珀色 + 文字说明，不用品牌红，避免误读成「重点」。
 */
.imp-block { margin-top: 32rpx; }
.imp-copy { color: var(--text-2, #6b5d57); font-size: 28rpx; margin: 12rpx 0; line-height: 1.8; }
.imp-guide {
  padding: 20rpx 24rpx; margin-top: 24rpx; font-size: 28rpx; line-height: 1.8;
  color: var(--brand-ink, #7a1a12);
  background: linear-gradient(150deg, rgba(198,154,40,0.22), rgba(198,154,40,0.10));
  border: 1rpx solid rgba(198,154,40,0.30);
  border-radius: var(--r-control, 20rpx);
}
.imp-guide-note { background: var(--warn-soft, rgba(255,244,228,0.86)); border-color: var(--warn-line, rgba(214,160,90,0.55)); color: var(--warn, #9a5b1e); font-size: 25rpx; }
.imp-steps { margin: 28rpx 0 8rpx; }
.imp-step { color: var(--text-2, #6b5d57); font-size: 27rpx; line-height: 1.9; }
.imp-file { color: var(--text-2, #6b5d57); font-size: 26rpx; margin-top: 8rpx; }
.imp-progress { color: var(--brand-deep, #8c1614); font-size: 26rpx; margin-top: 8rpx; font-weight: 600; }
.imp-error { background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e); border-radius: var(--r-control, 20rpx); padding: 20rpx 24rpx; font-size: 27rpx; line-height: 1.7; margin: 20rpx 0; }
.imp-cap { color: var(--warn, #9a5b1e); font-size: 24rpx; margin-top: -8rpx; }
.imp-secondary { background: var(--glass, rgba(255,255,255,0.52)); color: var(--brand-ink, #7a1a12); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); }
.imp-summary {
  padding: 24rpx; margin-top: 24rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-card, 24rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.imp-summary-title { font-size: 30rpx; font-weight: 700; color: var(--brand-deep, #8c1614); letter-spacing: 1rpx; margin-bottom: 8rpx; }
.imp-summary-line { color: var(--text-2, #6b5d57); font-size: 25rpx; line-height: 1.8; }
.imp-problem { color: var(--warn, #9a5b1e); }
.imp-notice {
  color: var(--text-2, #6b5d57); border-radius: var(--r-control, 20rpx); padding: 18rpx 22rpx; font-size: 25rpx; line-height: 1.7; margin: 24rpx 0;
  background: linear-gradient(150deg, rgba(198,154,40,0.20), rgba(198,154,40,0.09));
  border: 1rpx solid rgba(198,154,40,0.30);
}
.imp-list { margin-bottom: 24rpx; }
.imp-item {
  padding: 22rpx 24rpx; margin-bottom: 16rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-card, 24rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.imp-item-blocked { border: 2rpx solid var(--warn-line, rgba(214,160,90,0.55)); }
.imp-item-head { display: flex; align-items: center; gap: 12rpx; }
.imp-item-index { color: var(--text-3, #94867f); font-size: 24rpx; }
.imp-item-name { font-size: 29rpx; font-weight: 600; flex: 1; }
.imp-tag { color: var(--warn, #9a5b1e); background: var(--warn-soft, rgba(255,244,228,0.86)); border-radius: var(--r-pill, 999rpx); padding: 2rpx 12rpx; font-size: 20rpx; }
.imp-item-line { color: var(--text-2, #6b5d57); font-size: 25rpx; margin-top: 6rpx; }
.imp-item-warning { color: var(--warn, #9a5b1e); font-size: 23rpx; margin-top: 8rpx; }
.imp-item-blocked-hint { color: var(--warn, #9a5b1e); font-size: 24rpx; margin-top: 8rpx; font-weight: 600; }
.imp-item-raw { color: var(--text-3, #94867f); font-size: 22rpx; margin-top: 8rpx; word-break: break-all; }
.imp-item-ops { display: flex; gap: 16rpx; margin-top: 16rpx; }
.imp-op { flex: 1; background: rgba(196,28,35,0.90); color: #fff; border-radius: var(--r-pill, 999rpx); padding: 12rpx 0; font-size: 25rpx; margin: 0; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.36); }
.imp-op-delete { background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e); box-shadow: none; }
.imp-privacy { color: var(--text-3, #94867f); font-size: 23rpx; margin-top: 24rpx; line-height: 1.7; }
