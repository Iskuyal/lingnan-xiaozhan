/* 导入确认页样式：引导文案与待核对条目要显眼。 */
.imp-block { margin-top: 32rpx; }
.imp-copy { color: #576c63; font-size: 28rpx; margin: 12rpx 0; line-height: 1.8; }
.imp-guide { border-left: 6rpx solid #23664e; background: #eef5f1; padding: 20rpx 24rpx; color: #1d4c3c; font-size: 28rpx; line-height: 1.8; margin-top: 24rpx; }
.imp-guide-note { border-left-color: #d7c9a6; background: #f7f4ea; color: #6b5a2e; font-size: 25rpx; }
.imp-steps { margin: 28rpx 0 8rpx; }
.imp-step { color: #35564a; font-size: 27rpx; line-height: 1.9; }
.imp-file { color: #576c63; font-size: 26rpx; margin-top: 8rpx; }
.imp-progress { color: #23664e; font-size: 26rpx; margin-top: 8rpx; }
.imp-error { background: #f8efe2; color: #7a4a12; border-radius: 14rpx; padding: 20rpx 24rpx; font-size: 27rpx; line-height: 1.7; margin: 20rpx 0; }
.imp-cap { color: #a5762b; font-size: 24rpx; margin-top: -8rpx; }
.imp-secondary { background: #eef5f1; color: #23664e; }
.imp-summary { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; }
.imp-summary-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.imp-summary-line { color: #576c63; font-size: 25rpx; line-height: 1.8; }
.imp-problem { color: #7a4a12; }
.imp-notice { background: #f7f4ea; color: #6b5a2e; border-radius: 14rpx; padding: 18rpx 22rpx; font-size: 25rpx; line-height: 1.7; margin: 24rpx 0; }
.imp-list { margin-bottom: 24rpx; }
.imp-item { background: #fff; border-radius: 16rpx; padding: 22rpx 24rpx; margin-bottom: 16rpx; }
.imp-item-blocked { border: 2rpx solid #e0b184; }
.imp-item-head { display: flex; align-items: center; gap: 12rpx; }
.imp-item-index { color: #547367; font-size: 24rpx; }
.imp-item-name { font-size: 29rpx; font-weight: 600; flex: 1; }
.imp-tag { color: #9a5b1e; background: #f8efe2; border-radius: 8rpx; padding: 2rpx 10rpx; font-size: 20rpx; }
.imp-item-line { color: #576c63; font-size: 25rpx; margin-top: 6rpx; }
.imp-item-warning { color: #9a5b1e; font-size: 23rpx; margin-top: 8rpx; }
.imp-item-blocked-hint { color: #7a4a12; font-size: 24rpx; margin-top: 8rpx; font-weight: 600; }
.imp-item-raw { color: #6b7f76; font-size: 22rpx; margin-top: 8rpx; word-break: break-all; }
.imp-item-ops { display: flex; gap: 16rpx; margin-top: 16rpx; }
.imp-op { flex: 1; background: #eef5f1; color: #23664e; border-radius: 12rpx; padding: 12rpx 0; font-size: 25rpx; margin: 0; }
.imp-op-delete { background: #f8efe2; color: #9a5b1e; }
.imp-privacy { color: #6b7f76; font-size: 23rpx; margin-top: 24rpx; line-height: 1.7; }
