@import "../index.wxss";
.imp-block { margin-top:20px; }
.imp-copy,.imp-guide { margin-top:14px; color:#6b5d57; font-size:13px; line-height:1.9; }
.imp-guide-note { padding:14px 15px; border-left:3px solid #ded4cf; background:#fff; }
.imp-steps { margin-top:18px; padding:16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.imp-step { margin-bottom:8px; font-size:13px; line-height:1.9; }
.imp-secondary { background:#fff; color:#8c1614; border:1px solid #b9847c; }
.imp-file,.imp-progress { margin-top:14px; font-size:12px; color:#746760; line-height:1.8; word-break:break-all; }
.imp-error,.imp-cap,.imp-problem,.imp-notice,.imp-callout-warn { margin:16px 0; padding:14px 15px; border-left:3px solid #9a5b1e; background:#fff4e4; color:#78420e; font-size:13px; line-height:1.8; }
.imp-summary { padding:16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.imp-meta-toggle { display:block; min-height:44px; padding:10px; margin-top:12px; border:1px solid #b9847c; border-radius:7px; background:#fff; color:#8c1614; font-size:12px; }
.imp-title { margin:8px 0 16px; font-size:22px; font-weight:700; line-height:1.5; }
.imp-sheet-row { display:flex; gap:12px; margin-top:10px; font-size:13px; line-height:1.8; }
.imp-sheet-key { flex:none; width:54px; color:#746760; }
.imp-sheet-val { flex:1; min-width:0; }
.imp-summary-line,.imp-head-meta { margin-top:10px; color:#746760; font-size:11px; line-height:1.8; }
.imp-summary .imp-problem { color:#78420e; }
.imp-result-head { margin-top:24px; }
.imp-card { display:flex; gap:0; padding:16px; margin-top:12px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.imp-card-review { border-color:#cbaa88; background:#fff4e4; }
.imp-card-bar { display:none; }
.imp-card-main { flex:1; min-width:0; }
.imp-card-name { font-size:16px; font-weight:600; line-height:1.6; }
.imp-card-line { margin-top:8px; font-size:13px; line-height:1.8; }
.imp-card-warn { margin-top:8px; color:#9a5b1e; font-size:12px; line-height:1.8; }
.imp-card-raw { margin-top:10px; color:#746760; font-size:11px; line-height:1.8; word-break:break-all; }
.imp-chip { margin-left:6px; color:#9a5b1e; font-size:10px; }
.imp-card-ops { width:58px; flex:none; display:flex; flex-direction:column; gap:8px; margin-left:12px; }
.imp-op { width:58px; min-height:44px; padding:10px 4px; border:1px solid #b9847c; border-radius:6px; color:#8c1614; background:#fff; font-size:12px; }
.imp-quiet,.imp-view-hint,.imp-privacy { margin-top:14px; color:#746760; font-size:11px; line-height:1.8; }
.imp-unrecognized { padding:16px; margin-top:12px; border:1px solid #cbaa88; border-radius:10px; background:#fff4e4; }
.imp-unrecognized-head { font-weight:600; font-size:14px; }
.imp-unrecognized-row,.imp-unrecognized-hint { margin-top:10px; color:#78420e; font-size:12px; line-height:1.8; }
.imp-unrecognized-ops,.imp-btn-row { display:flex; gap:10px; margin-top:12px; }
.imp-actions { margin-top:20px; }
.imp-btn { flex:1; min-width:0; min-height:48px; padding:12px; border-radius:8px; background:#c41c23; color:#fff; font-size:14px; }
.imp-btn-secondary { background:#fff; border:1px solid #b9847c; color:#8c1614; }
.grid-block { border:1px dashed var(--blk-solid, rgba(148,134,127,0.55)); }
.grid-block-review { border-color:#9a5b1e; }
