<view class="page">
  <view wx:if="{{status === 'loading'}}" class="tt-hint">
    <view class="section-title">加载中</view>
    <view class="tt-hint-copy">正在从云端读取你的课表…</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="tt-hint">
    <view class="section-title">暂时读不到课表</view>
    <view class="tt-hint-copy">{{errorMessage}}</view>
    <button id="retry-load" class="home-button" hover-class="pressed" bindtap="retry">重试</button>
    <button id="back-home" class="home-button" hover-class="pressed" bindtap="goHome">返回首页</button>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="tt-empty">
    <view class="section-title">还没有课表</view>
    <view class="tt-hint-copy">两种方式都可以：导入教务系统导出的 Excel，或手工一节一节添加。手工添加的课程与导入的课程一样保存、一样展示。</view>
    <view id="file-guide" class="tt-guide">{{fileGuide}}</view>
    <view class="tt-guide tt-guide-note">{{offlineNote}}</view>
    <button id="import-entry" class="home-button" hover-class="pressed" bindtap="openImport">导入课表文件</button>
    <button id="manual-add" class="home-button tt-secondary" hover-class="pressed" bindtap="openCreate">手工新增课程</button>
    <view class="tt-privacy">课表只存你自己的内容，按微信身份隔离，不涉及教务账号。</view>
  </view>

  <block wx:else>
    <view class="tt-heading">
      <view class="section-title">我的课表</view>
      <view class="tt-meta">{{semesterText}}<block wx:if="{{count > 0}}"> · 共 {{count}} 门</block><block wx:if="{{updatedAtText !== ''}}"> · 最近保存于 {{updatedAtText}}</block></view>
    </view>

    <view class="week-switch">
      <button id="week-prev" class="week-button" hover-class="pressed" bindtap="previousWeek">上一周</button>
      <picker id="week-picker" class="week-picker" mode="selector" range="{{weekOptions}}" value="{{weekIndex}}" bindchange="selectWeek">
        <view class="week-current">{{view.weekLabel}} ▾</view>
      </picker>
      <button id="week-next" class="week-button" hover-class="pressed" bindtap="nextWeek">下一周</button>
    </view>

    <view wx:if="{{view.total === 0}}" class="tt-hint-copy tt-empty-week">本周没有安排课程，可以切换其他周次查看。</view>

    <view wx:else class="grid">
      <view class="grid-row grid-head">
        <view class="grid-cell grid-corner">节次</view>
        <view class="grid-cell grid-th" wx:for="{{weekdayShort}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="grid-row" wx:for="{{view.rows}}" wx:for-item="row" wx:key="index">
        <view class="grid-cell grid-corner">{{row.sectionLabel}}</view>
        <view class="grid-cell" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="weekday">
          <view
            class="grid-course {{course.needsReview ? 'grid-course-review' : (course.tint === 'red' ? 'grid-course-red' : 'grid-course-gold')}}"
            wx:for="{{cell.items}}"
            wx:for-item="course"
            wx:key="id"
            hover-class="pressed"
            data-id="{{course.id}}"
            bindtap="openSheet"
          >{{course.name}}</view>
        </view>
      </view>
    </view>

    <view class="tt-footer">课表按节次展示；学校作息与具体时刻尚未核实，不臆造上课时间。</view>

    <view class="tt-foot-actions">
      <button id="import-entry" class="home-button tt-secondary" hover-class="pressed" bindtap="openImport">重新导入课表</button>
      <button id="manual-add" class="home-button tt-secondary" hover-class="pressed" bindtap="openCreate">手工加课</button>
    </view>
  </block>

  <text wx:if="{{status !== 'error'}}" id="back-home" class="tt-back-link" bindtap="goHome">返回首页</text>

  <!-- 课程滑层：网格点开课程后在此修改或删除，取代原先按天列表里的两个按钮。 -->
  <view wx:if="{{sheetCourse !== null}}" class="tt-scrim" bindtap="closeSheet"></view>
  <view wx:if="{{sheetCourse !== null}}" id="course-sheet" class="tt-sheet">
    <view class="tt-sheet-handle"></view>
    <view class="tt-sheet-title">{{sheetCourse.name}}<text wx:if="{{sheetCourse.source === 'manual'}}" class="course-tag">手工</text><text wx:if="{{sheetCourse.needsReview}}" class="course-tag course-tag-review">待核对</text></view>
    <view class="tt-sheet-fields">
      <view class="tt-field"><text class="tt-field-label">星期</text><text class="tt-field-value">{{sheetCourse.weekdayText === '' ? '未填写' : sheetCourse.weekdayText}}</text></view>
      <view class="tt-field"><text class="tt-field-label">节次</text><text class="tt-field-value tt-field-key">{{sheetCourse.sectionLabel}}</text></view>
      <view class="tt-field"><text class="tt-field-label">地点</text><text class="tt-field-value {{sheetCourse.location === '' ? 'tt-field-empty' : ''}}">{{sheetCourse.location === '' ? '未填写' : sheetCourse.location}}</text></view>
      <view class="tt-field"><text class="tt-field-label">周次</text><text class="tt-field-value">{{sheetCourse.weekLabel}}</text></view>
      <view class="tt-field"><text class="tt-field-label">教师</text><text class="tt-field-value {{sheetCourse.teacher === '' ? 'tt-field-empty' : ''}}">{{sheetCourse.teacher === '' ? '未填写' : sheetCourse.teacher}}</text></view>
      <view class="tt-field" wx:if="{{sheetCourse.credits !== ''}}"><text class="tt-field-label">学分</text><text class="tt-field-value">{{sheetCourse.credits}}</text></view>
      <view class="tt-field" wx:if="{{sheetCourse.campus !== ''}}"><text class="tt-field-label">校区</text><text class="tt-field-value">{{sheetCourse.campus}}</text></view>
      <view class="tt-field" wx:if="{{sheetCourse.siteNumber !== ''}}"><text class="tt-field-label">场地编号</text><text class="tt-field-value">{{sheetCourse.siteNumber}}</text></view>
      <view class="tt-field" wx:if="{{sheetCourse.note !== ''}}"><text class="tt-field-label">备注</text><text class="tt-field-value">{{sheetCourse.note}}</text></view>
    </view>
    <view class="tt-sheet-warn" wx:if="{{sheetCourse.needsReview}}">{{sheetCourse.warningText}}</view>
    <view class="tt-sheet-actions">
      <button id="sheet-edit" class="home-button" hover-class="pressed" bindtap="editFromSheet">修改课程</button>
      <button id="sheet-delete" class="home-button tt-sheet-warn-btn" hover-class="pressed" bindtap="deleteFromSheet">删除课程</button>
      <button id="sheet-cancel" class="home-button tt-secondary" hover-class="pressed" bindtap="closeSheet">取消</button>
    </view>
  </view>

  <!-- 课表助手（Ticket 06）：悬浮入口 + 独立滑层，问完即收，不占课表视野。
       滑层只在课表可用的状态下渲染：读取失败时收起，不压住错误态的重试入口。 -->
  <button wx:if="{{!assistantOpen && status !== 'loading' && status !== 'error'}}" id="assistant-open" class="tt-fab" hover-class="pressed" bindtap="openAssistant">问问助手</button>
  <view wx:if="{{assistantOpen && status !== 'loading' && status !== 'error'}}" class="tt-scrim" bindtap="closeAssistant"></view>
  <view wx:if="{{assistantOpen && status !== 'loading' && status !== 'error'}}" id="assistant-panel" class="tt-sheet tt-qa">
    <view class="tt-sheet-handle"></view>
    <view class="qa-head">
      <view class="qa-title">课表助手</view>
      <button class="qa-close" hover-class="pressed" bindtap="closeAssistant">收起</button>
    </view>
    <view class="qa-messages">
      <!-- 与部门问答面板同一约定：助手回答带 qa-answer 标记，开发者工具验收靠它数气泡，测试锁住这个标记。 -->
      <view wx:for="{{assistantMessages}}" wx:key="index" class="qa-msg {{item.role === 'user' ? 'qa-msg-user' : 'qa-msg-ai'}} {{item.role === 'assistant' ? 'qa-answer' : ''}}">{{item.text}}</view>
    </view>
    <view class="qa-error" wx:if="{{assistantError !== ''}}">{{assistantError}}</view>
    <view id="assistant-safety-note" class="qa-warn" wx:if="{{assistantSafetyNote !== ''}}">{{assistantSafetyNote}}</view>
    <view class="qa-cap" wx:if="{{assistantCapWarning !== ''}}">{{assistantCapWarning}}</view>
    <view class="qa-input-row">
      <input id="assistant-input" class="qa-input" value="{{assistantInput}}" bindinput="onAssistantInput" placeholder="例如：周三第几节有课？" confirm-type="send" bindconfirm="sendAssistant" />
      <button id="assistant-send" class="qa-send" hover-class="pressed" disabled="{{assistantSending}}" bindtap="sendAssistant">发送</button>
    </view>
    <view class="qa-note">{{assistantNote}}</view>
  </view>
</view>
