<view class="page">
  <view wx:if="{{status === 'ready'}}" class="tt-heading">
    <view class="head-top">
      <view class="eyebrow"><view>{{semesterText}} · 按节次展示</view><view class="tt-meta">本周 {{view.total}} 门 · 共 {{count}} 门课程</view></view>
      <view id="timetable-settings-entry" class="head-link" hover-class="pressed" bindtap="openSettings">课表设置</view>
    </view>
    <view class="week-row">
      <view id="week-prev" class="week-nav" hover-class="pressed" bindtap="previousWeek">‹</view>
      <picker id="week-picker" class="week-pick" mode="selector" range="{{weekOptions}}" value="{{weekIndex}}" bindchange="selectWeek">
        <view class="week-now">{{view.weekLabel}} ▾ <text class="week-range" wx:if="{{weekRange !== ''}}">{{weekRange}}</text></view>
      </picker>
      <view id="week-next" class="week-nav" hover-class="pressed" bindtap="nextWeek">›</view>
    </view>
  </view>

  <view wx:if="{{status === 'ready'}}" class="actionbar">
    <button style="margin-left:0;margin-right:0;flex:1;width:0;max-width:none" id="manage-entry" class="actionbar-item secondary" hover-class="pressed" bindtap="openManage">管理课程</button>
    <button style="margin-left:0;margin-right:0;flex:1;width:0;max-width:none" id="import-entry" class="actionbar-item secondary" hover-class="pressed" bindtap="openImport">导入课表</button>
    <button style="margin-left:0;margin-right:0;flex:1;width:0;max-width:none" id="manual-add" class="actionbar-item secondary" hover-class="pressed" bindtap="openCreate">新增课程</button>
  </view>

  <!-- 今日速查：只在「用户填了作息」且「正在看的就是本周」时出现；没填作息时整条不出现（设计图 07）。 -->
  <view
    wx:if="{{todayBar !== null}}"
    id="today-summary"
    class="today today-{{todayBar.kind}}"
    data-id="{{todayBar.courseId}}"
    hover-class="pressed"
    bindtap="openSheet"
  >
    <view class="today-dot today-dot-{{todayBar.kind}}"></view>
    <view class="today-body">
      <view class="today-kicker today-kicker-{{todayBar.kind}}">{{todayBar.note}}</view>
      <view class="today-name" wx:if="{{todayBar.name !== ''}}">{{todayBar.name}}</view>
      <view class="today-sub" wx:if="{{todayBar.sectionLabel !== ''}}">{{todayBar.sectionLabel}}<block wx:if="{{todayBar.detail !== ''}}"> · {{todayBar.detail}}</block></view>
    </view>
    <view class="today-pill" wx:if="{{todayBar.timeLabel !== ''}}">{{todayBar.timeLabel}}</view>
  </view>

  <!-- 退化态说明（设计图 19）：缺开学日或作息时讲清缺什么、点哪里补。
       设置齐了这条就不出现，位置让给速查条。 -->
  <view wx:if="{{status === 'ready' && setupHint !== ''}}" class="setup-hint">
    <view class="setup-hint-text">{{setupHint}}</view>
    <view id="settings-cta" class="setup-hint-btn" hover-class="pressed" bindtap="openSettings">去设置</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="tt-hint">
    <view class="section-title">加载中</view>
    <view class="tt-hint-copy">正在从云端读取你的课表…</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="tt-hint">
    <view class="section-title">暂时读不到课表</view>
    <view class="tt-hint-copy">{{errorMessage}}</view>
    <button style="margin-left:0;margin-right:0;width:100%;max-width:none" id="retry-load" class="home-button" hover-class="pressed" bindtap="retry">重试</button>
    <button style="margin-left:0;margin-right:0;width:100%;max-width:none" id="back-home" class="home-button secondary" hover-class="pressed" bindtap="goHome">返回首页</button>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="tt-empty">
    <view class="tt-empty-title">还没有课表</view>
    <view class="tt-hint-copy">两种方式都可以：导入教务系统导出的 Excel，或手工一节一节添加。手工添加的课程与导入的课程一样保存、一样展示。</view>
    <view id="file-guide" class="tt-guide">{{fileGuide}}</view>
    <view class="tt-guide tt-guide-note">{{offlineNote}}</view>
    <button style="margin-left:0;margin-right:0;width:100%;max-width:none" id="import-entry" class="home-button" hover-class="pressed" bindtap="openImport">导入课表文件</button>
    <button style="margin-left:0;margin-right:0;width:100%;max-width:none" id="manual-add" class="home-button secondary" hover-class="pressed" bindtap="openCreate">手工新增课程</button>
    <view class="tt-privacy">课表只存你自己的内容，按微信身份隔离，不涉及教务账号。</view>
  </view>

  <block wx:else>
    <view class="section-head">
      <view class="section-title">本周课表</view>
      <view id="view-switch" class="seg">
        <view class="seg-item {{viewMode === 'grid' ? 'seg-item-on' : ''}}" data-mode="grid" bindtap="switchView">课表</view>
        <view class="seg-item {{viewMode === 'list' ? 'seg-item-on' : ''}}" data-mode="list" bindtap="switchView">列表</view>
      </view>
    </view>

    <view wx:if="{{view.total > 0 && viewMode === 'grid'}}" class="grid-instruction">左右滑动查看周一至周日；点课程查看完整信息。</view>

    <view wx:if="{{view.total === 0}}" class="tt-empty-week">
      <view class="tt-empty-title">本周没有安排课程</view>
      <view class="tt-empty-copy">可以左右翻周查看其他周次。</view>
    </view>

    <block wx:else>
      <block wx:if="{{viewMode === 'grid'}}">
      <view id="week-grid" class="grid-shell">
        <view class="grid-axis">
          <view class="grid-axis-head">节次</view>
          <view class="grid-no" wx:for="{{gridUi.sectionPairs}}" wx:key="label" style="height:{{item.heightPx}}px">{{item.label}}</view>
        </view>
        <scroll-view class="grid-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{true}}" style="height:{{gridUi.totalHeightPx}}px" aria-label="横向查看完整七天课程，节次在左侧固定显示">
          <view class="grid" style="width:{{gridUi.widthPx}}px">
            <view class="grid-row grid-head"><view class="grid-th {{column.today ? 'grid-th-today' : ''}}" wx:for="{{gridUi.columns}}" wx:for-item="column" wx:key="weekday"><view class="grid-th-day">{{column.shortLabel}}</view><view class="grid-th-date" wx:if="{{column.dateLabel !== ''}}">{{column.dateLabel}}</view></view></view>
            <view class="grid-cols" style="height:{{gridUi.heightPx}}px">
              <view class="grid-col {{column.today ? 'grid-col-today' : ''}}" wx:for="{{gridUi.columns}}" wx:for-item="column" wx:key="weekday">
                <view class="grid-line" wx:for="{{gridUi.sectionNumbers}}" wx:key="*this"></view>
                <view class="grid-block {{block.needsReview ? 'grid-block-review' : ''}} {{block.now ? 'grid-block-now' : ''}}" wx:for="{{column.blocks}}" wx:for-item="block" wx:key="primaryId" style="top:{{block.topPx}}px;height:{{block.heightPx}}px;left:{{block.laneLeftPercent}}%;width:{{block.laneWidthPercent}}%;--blk-tint:{{block.tint}};--blk-line:{{block.lineColor}};--blk-solid:{{block.solid}}" hover-class="pressed" data-id="{{block.primaryId}}" bindtap="openSheet" aria-role="button" aria-label="{{block.name}}，第{{block.start}}至{{block.end}}节，点按查看完整课程">
                  <view class="grid-block-name grid-block-name-{{block.tier}}">{{block.name}}</view>
                  <view class="grid-block-meta" wx:if="{{block.meta !== ''}}">{{block.meta}}</view>
                  <view class="grid-block-meta" wx:if="{{block.teacher !== ''}}">{{block.teacher}}</view>
                  <view class="grid-block-badge" wx:if="{{block.count > 1}}">{{block.count}}</view>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
      <button style="margin-left:0;margin-right:0;display:block;width:100%;max-width:none" wx:if="{{viewMode === 'grid' && gridUi.canCollapse}}" id="grid-expand" class="grid-expand" hover-class="pressed" bindtap="toggleGridExpansion">{{gridExpanded ? '收起末尾空课时' : '第 ' + gridUi.hiddenFrom + '–12 节本周无课，展开完整周视图'}}</button>
      </block>

      <!-- 列表视图：同一份数据的另一种读法，信息更全（周次、教师、修改/删除都在这里）。
           空白天不进列表——列表是「读全」，不是日历。 -->
      <view wx:else class="day-list">
        <view wx:for="{{view.days}}" wx:for-item="day" wx:key="weekday" class="day-block">
          <view class="day-title">
            <view class="day-dot"></view>
            {{day.label}}
            <view class="day-date" wx:if="{{day.dateLabel !== ''}}">{{day.dateLabel}}</view>
            <view class="day-today" wx:if="{{day.today}}">今天</view>
          </view>
          <view class="course-item {{course.needsReview ? 'course-item-review' : ''}}" style="--blk-solid:{{course.colorSolid}}" wx:for="{{day.items}}" wx:for-item="course" wx:key="id">
            <view class="course-main">
              <view class="course-name">{{course.name}}<text wx:if="{{course.source === 'manual'}}" class="course-tag">手工</text><text wx:if="{{course.needsReview}}" class="course-tag course-tag-review">待核对</text></view>
              <view class="course-line">{{course.sectionLabel}}<block wx:if="{{course.location !== ''}}"> · {{course.location}}</block></view>
              <view class="course-line">{{course.weekLabel}}<block wx:if="{{course.teacher !== ''}}"> · {{course.teacher}}</block></view>
              <view class="course-warning" wx:if="{{course.needsReview}}">{{course.warningText}}</view>
            </view>
            <view class="course-ops">
              <button style="margin-left:0;margin-right:0;width:54px;max-width:none" class="course-op" hover-class="pressed" data-id="{{course.id}}" bindtap="openEdit">修改</button>
              <button style="margin-left:0;margin-right:0;width:54px;max-width:none" class="course-op course-op-delete" hover-class="pressed" data-id="{{course.id}}" data-name="{{course.name}}" bindtap="removeCourse">删除</button>
            </view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <view id="week-saved-plan" class="saved-plan-panel" wx:if="{{savedPlanPanel.hasPlan}}">
    <view class="saved-plan-head"><view class="section-title">{{savedPlanPanel.rows.length ? '本周学习计划' : '已保存的学习计划'}}</view><text class="ai-tag">本机保存</text></view>
    <view class="saved-plan-copy">{{savedPlanPanel.goalName}} · 计划独立于正式课程</view>
    <view class="saved-plan-row" wx:for="{{savedPlanPanel.rows}}" wx:key="id">
      <view class="saved-plan-label">{{item.label}}</view><view class="saved-plan-date">{{item.date}}</view>
      <view wx:if="{{item.note}}" class="saved-plan-note saved-plan-{{item.status}}">{{item.note}}</view>
    </view>
    <view wx:if="{{savedPlanPanel.notice}}" class="saved-plan-copy">{{savedPlanPanel.notice}}</view>
    <button style="margin-left:0;margin-right:0;display:block;width:100%;max-width:none" id="week-plan-open" class="home-button secondary" bindtap="openSavedPlan">查看已保存计划</button>
  </view>
  <view class="tt-footer">周课表按节次展示；学校作息未核实，不显示具体时刻。<block wx:if="{{updatedAtText !== ''}}">课表保存于 {{updatedAtText}}。</block></view>


  <block wx:if="{{status !== 'loading' && status !== 'error'}}">
    <block wx:if="{{!assistantOpen}}">
      <button style="margin-left:0;margin-right:0;width:100%;max-width:none" id="assistant-open" class="home-button tt-assistant" hover-class="pressed" bindtap="openAssistant">问问课表助手</button>
      <!-- 贴通知是本轮的主打功能，不该藏在助手面板里点两下才找到：
           课表页直接给一个入口，点了就同时打开助手与粘贴框。 -->
      <button style="margin-left:0;margin-right:0;width:100%;max-width:none" id="notice-entry" class="home-button secondary tt-notice-entry" hover-class="pressed" bindtap="openNoticeEntry">贴班群通知，识别课表变更</button>
    </block>
    <view wx:else class="qa-panel tt-qa" id="assistant-panel">
      <view class="qa-head">
        <view class="qa-title">课表助手</view>
        <button style="margin-left:0;margin-right:0;width:52px;max-width:none" class="qa-close" hover-class="pressed" bindtap="closeAssistant">收起</button>
      </view>
      <view class="qa-messages">
        <!-- 与部门问答面板同一约定：助手回答带 qa-answer 标记，开发者工具验收靠它数气泡，测试锁住这个标记。 -->
        <view wx:for="{{assistantMessages}}" wx:key="index" class="qa-msg {{item.role === 'user' ? 'qa-msg-user' : 'qa-msg-ai'}} {{item.role === 'assistant' ? 'qa-answer' : ''}}">{{item.text}}</view>
      </view>
      <view class="qa-error" wx:if="{{assistantError !== ''}}">{{assistantError}}</view>
      <view id="assistant-safety-note" class="qa-warn" wx:if="{{assistantSafetyNote !== ''}}">{{assistantSafetyNote}}</view>
      <view class="qa-cap" wx:if="{{assistantCapWarning !== ''}}">{{assistantCapWarning}}</view>
      <view class="qa-input-row">
        <input id="assistant-input" class="qa-input" value="{{assistantInput}}" bindinput="onAssistantInput" placeholder="例如：周三第几节有课？" confirm-type="send" bindconfirm="sendAssistant" />
        <button style="margin-left:0;margin-right:0;width:64px;max-width:none" id="assistant-send" class="qa-send" hover-class="pressed" disabled="{{assistantSending}}" bindtap="sendAssistant">发送</button>
      </view>
      <view class="qa-note">{{assistantNote}}</view>

      <!-- 贴班群通知（设计图 02）：粘贴 → 提案 → 逐条勾选 → 应用 → 10 秒撤销。
           提案只存在页面内存里，学生点「应用 N 处变更」才写课表。 -->
      <button style="margin-left:0;margin-right:0;width:100%;max-width:none" id="notice-open" class="home-button secondary notice-open" hover-class="pressed" bindtap="toggleNotice">{{noticeOpen ? '收起通知粘贴框' : '贴班群通知，识别课表变更'}}</button>
      <view wx:if="{{noticeOpen}}" class="notice-wrap">
        <view class="paste">
          <view class="paste-from">你粘贴的班群通知（这里只认文字；只是截图的话，可以用「导入课表」里的截图识别）</view>
          <textarea id="notice-input" class="paste-input" value="{{noticeInput}}" bindinput="onNoticeInput" maxlength="4000" auto-height placeholder="例如：第 12 周周三全天停课，网页设计与制作所有周次改到博雅楼 B604，高数第 13 周周五 5-6 节补课" />
        </view>
        <view class="notice-read-row">
          <button style="margin-left:0;margin-right:0;flex:1;width:0;max-width:none" id="notice-read" class="home-button notice-read" hover-class="pressed" disabled="{{noticeReading}}" bindtap="readNotice">{{noticeReading ? '正在读…' : '识别变更'}}</button>
        </view>
        <view id="notice-hint" class="ai-note">{{noticeHint}}</view>
        <view id="notice-error" class="notice-error" wx:if="{{noticeError !== ''}}">{{noticeError}}</view>

        <view wx:if="{{noticeProposal !== null}}" id="notice-proposal" class="proposal">
          <view class="proposal-head">
            <view class="proposal-title">识别到 {{noticeProposal.rows.length}} 处变更</view>
            <text class="ai-tag">AI 提案 · 待确认</text>
          </view>
          <view wx:for="{{noticeProposal.rows}}" wx:key="index" class="change" data-index="{{item.index}}" bindtap="toggleNoticeRow">
            <view class="check {{item.checked ? '' : 'off'}}" wx:if="{{item.checked}}">✓</view>
            <view class="check off" wx:else></view>
            <view class="change-body">
              <view class="change-title">{{item.title}}</view>
              <view class="notice-scope" wx:if="{{item.scopeLabel}}">{{item.scopeLabel}} · 其他周次保持原样</view>
              <view class="diff" wx:for="{{item.diffs}}" wx:for-item="diff" wx:key="index">
                <text wx:if="{{diff.lead !== ''}}" class="diff-lead">{{diff.lead}} </text>
                <text wx:if="{{diff.old !== ''}}" class="diff-old">{{diff.old}}</text>
                <text wx:if="{{diff.old !== '' && diff.next !== ''}}" class="diff-arrow"> → </text>
                <text wx:if="{{diff.next !== ''}}" class="diff-new">{{diff.next}}</text>
                <text wx:if="{{diff.note !== ''}}" class="diff-note">　{{diff.note}}</text>
              </view>
              <view class="warnline" wx:if="{{item.conflict !== ''}}">⚠ {{item.conflict}}</view>
              <view class="warnline blocked" wx:if="{{item.blocked !== ''}}">{{item.blocked}}</view>
              <view class="change-detail" wx:if="{{noticeDetailOpen || item.blocked !== ''}}">将写入：{{item.detail}}</view>
              <view class="quote">原文：{{item.quote}}</view>
              <view class="notice-unaffected" wx:if="{{item.unaffectedLabel}}">{{item.unaffectedLabel}}</view>
            </view>
          </view>
          <view class="proposal-actions">
            <button style="margin-left:0;margin-right:0;flex:1;width:0;max-width:none" id="notice-expand" class="btn-secondary" hover-class="pressed" bindtap="toggleNoticeDetail">{{noticeDetailOpen ? '收起逐条说明' : '逐条修改'}}</button>
            <button style="margin-left:0;margin-right:0;flex:1;width:0;max-width:none" id="notice-apply" class="btn-primary" hover-class="pressed" disabled="{{noticeProposal.checkedCount === 0 || noticeReading}}" bindtap="applyNotice">应用 {{noticeProposal.checkedCount}} 处变更</button>
          </view>
          <view class="ai-note">{{noticeDetailOpen ? '展开后可逐条核对将写入的内容；不想改的那条取消勾选即可，取消的不会写入。' : noticeFooter}}</view>
        </view>

        <view wx:if="{{noticeToast !== null}}" id="notice-toast" class="toast">
          <view class="toast-text">{{noticeToast.text}}</view>
          <view wx:if="{{noticeToast.canUndo}}" id="notice-undo" class="toast-undo" hover-class="pressed" bindtap="undoNotice">撤销</view>
        </view>
      </view>
    </view>
  </block>

  <button style="margin-left:0;margin-right:0;width:100%;max-width:none" wx:if="{{status !== 'error'}}" id="back-home" class="tt-back-home" hover-class="pressed" bindtap="goHome">返回首页</button>

  <!-- 课程详情弹层（设计图 09）：点课块或速查条打开；同格多门时在这里列出全部成员。
       课程色走与课块同一个令牌槽 --blk-solid，不为弹层新增令牌。 -->
  <view wx:if="{{sheetOpen}}" class="sheet-mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheetOpen && sheetCourse !== null}}" id="course-sheet" class="sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-head" style="--blk-solid:{{sheetCourse.solid}}">
      <view class="sheet-name">{{sheetCourse.name}}</view>
      <view class="sheet-sub">{{sheetCourse.sectionLabel}} · {{sheetCourse.weekLabel}}</view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view wx:if="{{sheetCourse.needsReview}}" class="sheet-warn">待核对 · {{sheetCourse.warningText}}</view>
      <view class="sheet-row" wx:if="{{sheetCourse.teacher !== ''}}"><view class="sheet-key">教师</view><view class="sheet-val">{{sheetCourse.teacher}}</view></view>
      <view class="sheet-row" wx:if="{{sheetCourse.location !== ''}}"><view class="sheet-key">地点</view><view class="sheet-val">{{sheetCourse.location}}</view></view>
      <view class="sheet-row" wx:if="{{sheetCourse.campus !== '' || sheetCourse.siteNumber !== ''}}">
        <view class="sheet-key">校区</view>
        <view class="sheet-val">{{sheetCourse.campus}}<block wx:if="{{sheetCourse.siteNumber !== ''}}"> · 场地编号 {{sheetCourse.siteNumber}}</block></view>
      </view>
      <view class="sheet-row" wx:if="{{sheetCourse.note !== ''}}"><view class="sheet-key">备注</view><view class="sheet-val">{{sheetCourse.note}}</view></view>
      <view class="sheet-row"><view class="sheet-key">来源</view><view class="sheet-val">{{sheetCourse.sourceLabel}}</view></view>
      <view class="sheet-row" wx:if="{{sheetCourse.updatedAtText !== ''}}"><view class="sheet-key">最近修改</view><view class="sheet-val">{{sheetCourse.updatedAtText}}</view></view>
      <view class="sheet-row" wx:if="{{sheetCourse.rawText !== ''}}"><view class="sheet-key">原文</view><view class="sheet-val">{{sheetCourse.rawText}}</view></view>
      <block wx:if="{{sheetMembers.length > 1}}">
        <view class="sheet-group">同一格还有 {{sheetMembers.length}} 门课</view>
        <view class="sheet-member" wx:for="{{sheetMembers}}" wx:key="id" data-id="{{item.id}}" hover-class="pressed" bindtap="pickSheetMember">
          <view class="sheet-member-name">{{item.name}}</view>
          <view class="sheet-member-sub">{{item.sectionLabel}}</view>
        </view>
      </block>
    </scroll-view>
    <view class="sheet-foot">
      <button style="margin-left:0;margin-right:0;flex:1;width:0;max-width:none" class="sheet-btn" hover-class="pressed" bindtap="editSheetCourse">修改这节课</button>
      <button style="margin-left:0;margin-right:0;flex:1;width:0;max-width:none" class="sheet-btn sheet-btn-warn" hover-class="pressed" bindtap="removeSheetCourse">删除</button>
      <view class="sheet-close" hover-class="pressed" bindtap="closeSheet">关闭</view>
    </view>
  </view>
</view>
