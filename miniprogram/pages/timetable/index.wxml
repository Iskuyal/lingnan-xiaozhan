<view class="page">
  <view class="tt-heading">
    <view class="head-top">
      <view class="eyebrow">{{semesterText}} · 按节次展示</view>
      <view id="timetable-settings-entry" class="head-link" hover-class="pressed" bindtap="openSettings">课表设置</view>
    </view>
    <view class="week-row">
      <view id="week-prev" class="week-nav" hover-class="pressed" bindtap="previousWeek">‹</view>
      <picker id="week-picker" class="week-pick" mode="selector" range="{{weekOptions}}" value="{{weekIndex}}" bindchange="selectWeek">
        <view class="week-now">{{view.weekLabel}} ▾</view>
        <view class="week-range" wx:if="{{weekRange !== ''}}">{{weekRange}}</view>
      </picker>
      <view id="week-next" class="week-nav" hover-class="pressed" bindtap="nextWeek">›</view>
    </view>
    <view class="tt-meta">本周 {{view.total}} 门 · 共 {{count}} 门课程</view>
  </view>

  <!-- 今日速查：只在「用户填了作息」且「正在看的就是本周」时出现；没填作息时整条不出现（设计图 07）。 -->
  <view
    wx:if="{{todayBar !== null}}"
    id="today-summary"
    class="today today-{{todayBar.kind}}"
    data-id="{{todayBar.courseId}}"
    hover-class="pressed"
    bindtap="openSheet"
  >
    <view class="today-dot today-dot-{{todayBar.kind}}"></view>
    <view class="today-body">
      <view class="today-kicker today-kicker-{{todayBar.kind}}">{{todayBar.note}}</view>
      <view class="today-name" wx:if="{{todayBar.name !== ''}}">{{todayBar.name}}</view>
      <view class="today-sub" wx:if="{{todayBar.sectionLabel !== ''}}">{{todayBar.sectionLabel}}<block wx:if="{{todayBar.detail !== ''}}"> · {{todayBar.detail}}</block></view>
    </view>
    <view class="today-pill" wx:if="{{todayBar.timeLabel !== ''}}">{{todayBar.timeLabel}}</view>
  </view>

  <!-- 退化态说明（设计图 19）：缺开学日或作息时讲清缺什么、点哪里补。
       设置齐了这条就不出现，位置让给速查条。 -->
  <view wx:if="{{setupHint !== ''}}" class="setup-hint">
    <view class="setup-hint-text">{{setupHint}}</view>
    <view id="settings-cta" class="setup-hint-btn" hover-class="pressed" bindtap="openSettings">去设置</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="tt-hint">
    <view class="section-title">加载中</view>
    <view class="tt-hint-copy">正在从云端读取你的课表…</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="tt-hint">
    <view class="section-title">暂时读不到课表</view>
    <view class="tt-hint-copy">{{errorMessage}}</view>
    <button id="retry-load" class="home-button" hover-class="pressed" bindtap="retry">重试</button>
    <button id="back-home" class="home-button" hover-class="pressed" bindtap="goHome">返回首页</button>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="tt-empty">
    <view class="section-title">还没有课表</view>
    <view class="tt-hint-copy">两种方式都可以：导入教务系统导出的 Excel，或手工一节一节添加。手工添加的课程与导入的课程一样保存、一样展示。</view>
    <view id="file-guide" class="tt-guide">{{fileGuide}}</view>
    <view class="tt-guide tt-guide-note">{{offlineNote}}</view>
    <button id="import-entry" class="home-button" hover-class="pressed" bindtap="openImport">导入课表文件</button>
    <button id="manual-add" class="home-button secondary" hover-class="pressed" bindtap="openCreate">手工新增课程</button>
    <view class="tt-privacy">课表只存你自己的内容，按微信身份隔离，不涉及教务账号。</view>
  </view>

  <block wx:else>
    <view class="section-head">
      <view class="section-title">本周课表</view>
      <view id="view-switch" class="seg">
        <view class="seg-item {{viewMode === 'grid' ? 'seg-item-on' : ''}}" data-mode="grid" bindtap="switchView">课表</view>
        <view class="seg-item {{viewMode === 'list' ? 'seg-item-on' : ''}}" data-mode="list" bindtap="switchView">列表</view>
      </view>
    </view>

    <view wx:if="{{view.total > 0 && viewMode === 'grid'}}" class="grid-instruction">长课程名如有省略，点课程块看完整信息；切换列表可读全。</view>

    <view wx:if="{{view.total === 0}}" class="tt-empty-week">
      <view class="tt-empty-title">本周没有安排课程</view>
      <view class="tt-empty-copy">可以左右翻周查看其他周次。</view>
    </view>

    <block wx:else>
      <!-- 周网格：12 节行，只画本周有课的天（空白天不进表，省下的宽度给有课的天）。
           块的位置与高度由 view 层算好（topRpx/heightRpx/lane*Percent），模板只负责画。 -->
      <view wx:if="{{viewMode === 'grid'}}" id="week-grid" class="grid">
        <view class="grid-row grid-head">
          <view class="grid-rail"></view>
          <view
            class="grid-th {{column.today ? 'grid-th-today' : ''}}"
            wx:for="{{grid.columns}}"
            wx:for-item="column"
            wx:key="weekday"
            wx:if="{{!column.narrow}}"
          >
            <view class="grid-th-day">{{column.label}}</view>
            <view class="grid-th-date" wx:if="{{column.dateLabel !== ''}}">{{column.dateLabel}}</view>
          </view>
        </view>
        <view class="grid-body">
          <view class="grid-rail">
            <view class="grid-no" wx:for="{{grid.sectionNumbers}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="grid-cols">
            <view
              class="grid-col {{column.today ? 'grid-col-today' : ''}}"
              wx:for="{{grid.columns}}"
              wx:for-item="column"
              wx:key="weekday"
              wx:if="{{!column.narrow}}"
            >
              <view class="grid-line" wx:for="{{grid.sectionNumbers}}" wx:for-item="line" wx:key="*this"></view>
              <view
                class="grid-block {{block.needsReview ? 'grid-block-review' : ''}} {{block.now ? 'grid-block-now' : ''}}"
                wx:for="{{column.blocks}}"
                wx:for-item="block"
                wx:key="primaryId"
                style="top:{{block.topRpx}}rpx;height:{{block.heightRpx}}rpx;left:{{block.laneLeftPercent}}%;width:{{block.laneWidthPercent}}%;--blk-tint:{{block.tint}};--blk-line:{{block.lineColor}};--blk-solid:{{block.solid}}"
                hover-class="pressed"
                data-id="{{block.primaryId}}"
                bindtap="openSheet"
              >
                <view class="grid-block-name grid-block-name-{{block.tier}}">{{block.name}}</view>
                <view class="grid-block-meta" wx:if="{{block.meta !== ''}}">{{block.meta}}</view>
                <view class="grid-block-meta" wx:if="{{block.teacher !== ''}}">{{block.teacher}}</view>
                <view class="grid-block-badge" wx:if="{{block.count > 1}}">{{block.count}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 列表视图：同一份数据的另一种读法，信息更全（周次、教师、修改/删除都在这里）。
           空白天不进列表——列表是「读全」，不是日历。 -->
      <view wx:else class="day-list">
        <view wx:for="{{view.days}}" wx:for-item="day" wx:key="weekday" class="day-block">
          <view class="day-title">
            <view class="day-dot"></view>
            {{day.label}}
            <view class="day-date" wx:if="{{day.dateLabel !== ''}}">{{day.dateLabel}}</view>
            <view class="day-today" wx:if="{{day.today}}">今天</view>
          </view>
          <view class="course-item {{course.needsReview ? 'course-item-review' : ''}}" style="--blk-solid:{{course.colorSolid}}" wx:for="{{day.items}}" wx:for-item="course" wx:key="id">
            <view class="course-main">
              <view class="course-name">{{course.name}}<text wx:if="{{course.source === 'manual'}}" class="course-tag">手工</text><text wx:if="{{course.needsReview}}" class="course-tag course-tag-review">待核对</text></view>
              <view class="course-line">{{course.sectionLabel}}<block wx:if="{{course.location !== ''}}"> · {{course.location}}</block></view>
              <view class="course-line">{{course.weekLabel}}<block wx:if="{{course.teacher !== ''}}"> · {{course.teacher}}</block></view>
              <view class="course-warning" wx:if="{{course.needsReview}}">{{course.warningText}}</view>
            </view>
            <view class="course-ops">
              <button class="course-op" hover-class="pressed" data-id="{{course.id}}" bindtap="openEdit">修改</button>
              <button class="course-op course-op-delete" hover-class="pressed" data-id="{{course.id}}" data-name="{{course.name}}" bindtap="removeCourse">删除</button>
            </view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <view class="tt-footer">周课表按节次展示；学校作息未核实，不显示具体时刻。<block wx:if="{{updatedAtText !== ''}}">课表保存于 {{updatedAtText}}。</block></view>

  <!-- 动作条只在已就绪时出现：空态自己有导入/手工两个大按钮，避免同页出现两个 #import-entry。 -->
  <view wx:if="{{status === 'ready'}}" class="actionbar">
    <button id="import-entry" class="actionbar-item" hover-class="pressed" bindtap="openImport">导入课表</button>
    <button id="manual-add" class="actionbar-item" hover-class="pressed" bindtap="openCreate">手工新增</button>
    <button id="manage-entry" class="actionbar-item" hover-class="pressed" bindtap="openManage">课程管理</button>
  </view>

  <block wx:if="{{status !== 'loading' && status !== 'error'}}">
    <button wx:if="{{!assistantOpen}}" id="assistant-open" class="home-button tt-assistant" hover-class="pressed" bindtap="openAssistant">问问课表助手</button>
    <view wx:else class="qa-panel tt-qa" id="assistant-panel">
      <view class="qa-head">
        <view class="qa-title">课表助手</view>
        <button class="qa-close" hover-class="pressed" bindtap="closeAssistant">收起</button>
      </view>
      <view class="qa-messages">
        <!-- 与部门问答面板同一约定：助手回答带 qa-answer 标记，开发者工具验收靠它数气泡，测试锁住这个标记。 -->
        <view wx:for="{{assistantMessages}}" wx:key="index" class="qa-msg {{item.role === 'user' ? 'qa-msg-user' : 'qa-msg-ai'}} {{item.role === 'assistant' ? 'qa-answer' : ''}}">{{item.text}}</view>
      </view>
      <view class="qa-error" wx:if="{{assistantError !== ''}}">{{assistantError}}</view>
      <view id="assistant-safety-note" class="qa-warn" wx:if="{{assistantSafetyNote !== ''}}">{{assistantSafetyNote}}</view>
      <view class="qa-cap" wx:if="{{assistantCapWarning !== ''}}">{{assistantCapWarning}}</view>
      <view class="qa-input-row">
        <input id="assistant-input" class="qa-input" value="{{assistantInput}}" bindinput="onAssistantInput" placeholder="例如：周三第几节有课？" confirm-type="send" bindconfirm="sendAssistant" />
        <button id="assistant-send" class="qa-send" hover-class="pressed" disabled="{{assistantSending}}" bindtap="sendAssistant">发送</button>
      </view>
      <view class="qa-note">{{assistantNote}}</view>
    </view>
  </block>

  <button wx:if="{{status !== 'error'}}" id="back-home" class="tt-back-home" hover-class="pressed" bindtap="goHome">返回首页</button>

  <!-- 课程详情弹层（设计图 09）：点课块或速查条打开；同格多门时在这里列出全部成员。
       课程色走与课块同一个令牌槽 --blk-solid，不为弹层新增令牌。 -->
  <view wx:if="{{sheetOpen}}" class="sheet-mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheetOpen && sheetCourse !== null}}" id="course-sheet" class="sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-head" style="--blk-solid:{{sheetCourse.solid}}">
      <view class="sheet-name">{{sheetCourse.name}}</view>
      <view class="sheet-sub">{{sheetCourse.sectionLabel}} · {{sheetCourse.weekLabel}}</view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view wx:if="{{sheetCourse.needsReview}}" class="sheet-warn">待核对 · {{sheetCourse.warningText}}</view>
      <view class="sheet-row" wx:if="{{sheetCourse.teacher !== ''}}"><view class="sheet-key">教师</view><view class="sheet-val">{{sheetCourse.teacher}}</view></view>
      <view class="sheet-row" wx:if="{{sheetCourse.location !== ''}}"><view class="sheet-key">地点</view><view class="sheet-val">{{sheetCourse.location}}</view></view>
      <view class="sheet-row" wx:if="{{sheetCourse.campus !== '' || sheetCourse.siteNumber !== ''}}">
        <view class="sheet-key">校区</view>
        <view class="sheet-val">{{sheetCourse.campus}}<block wx:if="{{sheetCourse.siteNumber !== ''}}"> · 场地编号 {{sheetCourse.siteNumber}}</block></view>
      </view>
      <view class="sheet-row" wx:if="{{sheetCourse.note !== ''}}"><view class="sheet-key">备注</view><view class="sheet-val">{{sheetCourse.note}}</view></view>
      <view class="sheet-row"><view class="sheet-key">来源</view><view class="sheet-val">{{sheetCourse.sourceLabel}}</view></view>
      <view class="sheet-row" wx:if="{{sheetCourse.updatedAtText !== ''}}"><view class="sheet-key">最近修改</view><view class="sheet-val">{{sheetCourse.updatedAtText}}</view></view>
      <view class="sheet-row" wx:if="{{sheetCourse.rawText !== ''}}"><view class="sheet-key">原文</view><view class="sheet-val">{{sheetCourse.rawText}}</view></view>
      <block wx:if="{{sheetMembers.length > 1}}">
        <view class="sheet-group">同一格还有 {{sheetMembers.length}} 门课</view>
        <view class="sheet-member" wx:for="{{sheetMembers}}" wx:key="id" data-id="{{item.id}}" hover-class="pressed" bindtap="pickSheetMember">
          <view class="sheet-member-name">{{item.name}}</view>
          <view class="sheet-member-sub">{{item.sectionLabel}}</view>
        </view>
      </block>
    </scroll-view>
    <view class="sheet-foot">
      <button class="sheet-btn" hover-class="pressed" bindtap="editSheetCourse">修改这节课</button>
      <button class="sheet-btn sheet-btn-warn" hover-class="pressed" bindtap="removeSheetCourse">删除</button>
      <view class="sheet-close" hover-class="pressed" bindtap="closeSheet">关闭</view>
    </view>
  </view>
</view>
