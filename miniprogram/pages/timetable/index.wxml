<view class="page">
  <view class="tt-heading">
    <view class="eyebrow">{{semesterText}} · 按节次展示</view>
    <view class="week-row">
      <button id="week-prev" class="week-nav" hover-class="pressed" bindtap="previousWeek">‹</button>
      <picker id="week-picker" class="week-pick" mode="selector" range="{{weekOptions}}" value="{{weekIndex}}" bindchange="selectWeek">
        <view class="week-now">{{view.weekLabel}} ▾</view>
      </picker>
      <button id="week-next" class="week-nav" hover-class="pressed" bindtap="nextWeek">›</button>
    </view>
    <view class="tt-meta">本周 {{view.total}} 门 · 共 {{count}} 门课程<block wx:if="{{updatedAtText !== ''}}"> · 最近保存于 {{updatedAtText}}</block></view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="tt-hint">
    <view class="section-title">加载中</view>
    <view class="tt-hint-copy">正在从云端读取你的课表…</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="tt-hint">
    <view class="section-title">暂时读不到课表</view>
    <view class="tt-hint-copy">{{errorMessage}}</view>
    <button id="retry-load" class="home-button" hover-class="pressed" bindtap="retry">重试</button>
    <button id="back-home" class="home-button" hover-class="pressed" bindtap="goHome">返回首页</button>
  </view>

  <view wx:elif="{{status === 'empty'}}" class="tt-empty">
    <view class="section-title">还没有课表</view>
    <view class="tt-hint-copy">两种方式都可以：导入教务系统导出的 Excel，或手工一节一节添加。手工添加的课程与导入的课程一样保存、一样展示。</view>
    <view id="file-guide" class="tt-guide">{{fileGuide}}</view>
    <view class="tt-guide tt-guide-note">{{offlineNote}}</view>
    <button id="import-entry" class="home-button" hover-class="pressed" bindtap="openImport">导入课表文件</button>
    <button id="manual-add" class="home-button tt-secondary" hover-class="pressed" bindtap="openCreate">手工新增课程</button>
    <view class="tt-privacy">课表只存你自己的内容，按微信身份隔离，不涉及教务账号。</view>
  </view>

  <block wx:else>
    <view class="section-head">
      <view class="section-bar"></view>
      <view class="section-title">本周课表</view>
      <view id="view-switch" class="seg">
        <view class="seg-item {{viewMode === 'grid' ? 'seg-item-on' : ''}}" data-mode="grid" bindtap="switchView">课表</view>
        <view class="seg-item {{viewMode === 'list' ? 'seg-item-on' : ''}}" data-mode="list" bindtap="switchView">列表</view>
      </view>
    </view>

    <view wx:if="{{view.total === 0}}" class="tt-hint-copy tt-empty-week">本周没有安排课程，可以左右翻周查看其他周次。</view>

    <block wx:else>
      <!-- 周网格：12 节行，有课的天宽、没课的天窄（样式里的 -narrow）。
           块的位置与高度由 view 层算好（topRpx/heightRpx/lane*Percent），模板只负责画。 -->
      <view wx:if="{{viewMode === 'grid'}}" id="week-grid" class="grid">
        <view class="grid-row grid-head">
          <view class="grid-rail"></view>
          <view
            class="grid-th {{column.narrow ? 'grid-th-narrow' : ''}} {{column.today ? 'grid-th-today' : ''}}"
            wx:for="{{grid.columns}}"
            wx:for-item="column"
            wx:key="weekday"
          >
            <view class="grid-th-day">{{column.label}}</view>
            <view class="grid-th-date" wx:if="{{column.dateLabel !== ''}}">{{column.dateLabel}}</view>
          </view>
        </view>
        <view class="grid-body">
          <view class="grid-rail">
            <view class="grid-no" wx:for="{{grid.sectionNumbers}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="grid-cols">
            <view
              class="grid-col {{column.narrow ? 'grid-col-narrow' : ''}} {{column.today ? 'grid-col-today' : ''}}"
              wx:for="{{grid.columns}}"
              wx:for-item="column"
              wx:key="weekday"
            >
              <view class="grid-line" wx:for="{{grid.sectionNumbers}}" wx:for-item="line" wx:key="*this"></view>
              <view
                class="grid-block {{block.needsReview ? 'grid-block-review' : ''}} {{block.now ? 'grid-block-now' : ''}}"
                wx:for="{{column.blocks}}"
                wx:for-item="block"
                wx:key="primaryId"
                style="top:{{block.topRpx}}rpx;height:{{block.heightRpx}}rpx;left:{{block.laneLeftPercent}}%;width:{{block.laneWidthPercent}}%;--blk-tint:{{block.tint}};--blk-line:{{block.lineColor}};--blk-solid:{{block.solid}}"
                hover-class="pressed"
                data-id="{{block.primaryId}}"
                bindtap="openEdit"
              >
                <view class="grid-block-name">{{block.name}}</view>
                <view class="grid-block-meta" wx:if="{{block.meta !== ''}}">{{block.meta}}</view>
                <view class="grid-block-meta" wx:if="{{block.teacher !== ''}}">{{block.teacher}}</view>
                <view class="grid-block-badge" wx:if="{{block.count > 1}}">{{block.count}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 列表视图：同一份数据的另一种读法，信息更全（周次、教师、修改/删除都在这里）。 -->
      <view wx:else class="day-list">
        <view wx:for="{{view.days}}" wx:for-item="day" wx:key="weekday" class="day-block">
          <view class="day-title">{{day.label}}</view>
          <view class="course-item" wx:for="{{day.items}}" wx:for-item="course" wx:key="id">
            <view class="course-main">
              <view class="course-name">{{course.name}}<text wx:if="{{course.source === 'manual'}}" class="course-tag">手工</text><text wx:if="{{course.needsReview}}" class="course-tag course-tag-review">待核对</text></view>
              <view class="course-line">{{course.sectionLabel}}<block wx:if="{{course.location !== ''}}"> · {{course.location}}</block></view>
              <view class="course-line">{{course.weekLabel}}<block wx:if="{{course.teacher !== ''}}"> · {{course.teacher}}</block></view>
              <view class="course-warning" wx:if="{{course.needsReview}}">{{course.warningText}}</view>
            </view>
            <view class="course-ops">
              <button class="course-op" hover-class="pressed" data-id="{{course.id}}" bindtap="openEdit">修改</button>
              <button class="course-op course-op-delete" hover-class="pressed" data-id="{{course.id}}" data-name="{{course.name}}" bindtap="removeCourse">删除</button>
            </view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <view class="tt-footer">周课表按节次展示；学校作息与具体时刻尚未核实，不臆造上课时间。点课程块可以修改或删除。</view>

  <!-- 动作条只在已就绪时出现：空态自己有导入/手工两个大按钮，避免同页出现两个 #import-entry。 -->
  <view wx:if="{{status === 'ready'}}" class="actionbar">
    <button id="import-entry" class="actionbar-item" hover-class="pressed" bindtap="openImport">导入课表</button>
    <button id="manual-add" class="actionbar-item" hover-class="pressed" bindtap="openCreate">手工新增</button>
  </view>

  <block wx:if="{{status !== 'loading' && status !== 'error'}}">
    <button wx:if="{{!assistantOpen}}" id="assistant-open" class="home-button tt-assistant-open" hover-class="pressed" bindtap="openAssistant">问问课表助手</button>
    <view wx:else class="qa-panel tt-qa" id="assistant-panel">
      <view class="qa-head">
        <view class="qa-title">课表助手</view>
        <button class="qa-close" hover-class="pressed" bindtap="closeAssistant">收起</button>
      </view>
      <view class="qa-messages">
        <!-- 与部门问答面板同一约定：助手回答带 qa-answer 标记，开发者工具验收靠它数气泡，测试锁住这个标记。 -->
        <view wx:for="{{assistantMessages}}" wx:key="index" class="qa-msg {{item.role === 'user' ? 'qa-msg-user' : 'qa-msg-ai'}} {{item.role === 'assistant' ? 'qa-answer' : ''}}">{{item.text}}</view>
      </view>
      <view class="qa-error" wx:if="{{assistantError !== ''}}">{{assistantError}}</view>
      <view id="assistant-safety-note" class="qa-warn" wx:if="{{assistantSafetyNote !== ''}}">{{assistantSafetyNote}}</view>
      <view class="qa-cap" wx:if="{{assistantCapWarning !== ''}}">{{assistantCapWarning}}</view>
      <view class="qa-input-row">
        <input id="assistant-input" class="qa-input" value="{{assistantInput}}" bindinput="onAssistantInput" placeholder="例如：周三第几节有课？" confirm-type="send" bindconfirm="sendAssistant" />
        <button id="assistant-send" class="qa-send" hover-class="pressed" disabled="{{assistantSending}}" bindtap="sendAssistant">发送</button>
      </view>
      <view class="qa-note">{{assistantNote}}</view>
    </view>
  </block>

  <button wx:if="{{status !== 'error'}}" id="back-home" class="home-button" hover-class="pressed" bindtap="goHome">返回首页</button>
</view>
