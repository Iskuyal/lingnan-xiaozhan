/* 页头不再挂品牌红横线：那条线归「本周课表」分区标题（对齐设计图 timetable-readability/03）。
   周次与日期区间合成一个整体，「最近保存于」移到底部说明句，头部两行读完。 */
.tt-heading { margin-bottom:22rpx; }
.head-top { display:flex; align-items:center; justify-content:space-between; }
.head-link { min-height:84rpx; display:flex; align-items:center; padding:0 4rpx; color:var(--brand-ink, #7a1a12); font-size:22rpx; }
/* 翻周箭头用 view 而不是原生 button：button 自带 184px 内在宽度与水平 auto 外边距，
   行里一旦有空余就把两个箭头推到两头，把「第 N 周」孤零零留在中间（实测箭头左右各被推开 37px）。 */
.week-nav {
  flex:0 0 84rpx; height:84rpx; display:flex; align-items:center; justify-content:center;
  border:1rpx solid rgba(43,36,34,0.2); color:var(--brand-deep, #8c1614); font-size:34rpx; line-height:1;
}
/* 周次、日期、左右翻周三件居中排成一行（设计图 timetable-readability/01）：选择器不再吃掉整行，
   否则「第 N 周」被留在最左、右箭头被推到最右，中间空出一大块，看着像排版坏了。 */
.week-row { display:flex; align-items:center; justify-content:center; gap:14rpx; margin-top:10rpx; }
.week-pick { flex:0 1 auto; min-width:0; text-align:center; }
.week-now { color:var(--brand-deep, #8c1614); font-size:48rpx; line-height:1.25; font-weight:700; white-space:nowrap; }
.week-range { margin-top:2rpx; color:var(--text-2, #6b5d57); font-size:22rpx; line-height:1.45; }
/* 课程数跟着周次一起居中：一行导航配一行左对齐的数字会显得两头不靠。 */
.tt-meta { margin-top:7rpx; color:var(--text-2, #6b5d57); font-size:22rpx; line-height:1.55; text-align:center; }
.today {
  display:flex; align-items:center; gap:14rpx; margin:18rpx 0 22rpx;
  padding:16rpx 18rpx; border-left:6rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9);
}
.today-dot { width:14rpx; height:14rpx; flex:none; background:var(--brand, #c41c23); }
.today-body { flex:1; min-width:0; }
.today-kicker { color:var(--brand-deep, #8c1614); font-size:22rpx; font-weight:700; }
.today-name { color:var(--text, #2b2422); font-size:23rpx; font-weight:600; }
.today-sub { color:var(--text-2, #6b5d57); font-size:20rpx; line-height:1.5; }
.today-pill { color:var(--brand-ink, #7a1a12); font-size:20rpx; white-space:nowrap; }
.today-next .today-dot { background:var(--gold, #c69a28); }
.today-next .today-kicker { color:var(--gold-deep, #a67f1c); }
.today-none .today-dot,.today-finished .today-dot { background:var(--text-3, #746760); }
.today-none .today-kicker,.today-finished .today-kicker { color:var(--text-2, #6b5d57); }
.setup-hint {
  margin:16rpx 0 20rpx; padding:15rpx 16rpx; display:flex; align-items:center; gap:16rpx;
  border-left:6rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9);
}
.setup-hint-text { flex:1; color:var(--text-2, #6b5d57); font-size:22rpx; line-height:1.65; }
.setup-hint-btn { min-width:100rpx; min-height:84rpx; flex:none; display:flex; align-items:center; justify-content:center; padding:0 8rpx; color:var(--brand-ink, #7a1a12); font-size:21rpx; font-weight:700; }
.tt-hint { margin-top:34rpx; }
.tt-hint-copy { margin:14rpx 0; color:var(--text-2, #6b5d57); font-size:26rpx; line-height:1.75; }
.tt-empty { margin-top:26rpx; }
.tt-guide {
  margin-top:18rpx; padding:17rpx 18rpx; border-left:6rpx solid var(--gold, #c69a28);
  background:var(--paper-shade, #faeee9); color:var(--text-2, #6b5d57); font-size:22rpx; line-height:1.7;
}
.tt-guide-note { margin-top:9rpx; border-left-color:var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); }
.tt-privacy { margin-top:15rpx; color:var(--text-3, #746760); font-size:20rpx; line-height:1.65; }
.section-head {
  /* 品牌红横线落在这里，明确「本周课表」这一段的起点。 */
  margin-top:24rpx; margin-bottom:12rpx; padding-top:22rpx; border-top:4rpx solid var(--brand, #c41c23);
}
.seg { margin-left:12rpx; display:flex; border:1rpx solid rgba(43,36,34,0.18); }
.seg-item { min-width:84rpx; min-height:84rpx; padding:7rpx 12rpx; display:flex; align-items:center; justify-content:center; color:var(--text-2, #6b5d57); font-size:20rpx; text-align:center; }
.seg-item-on { background:var(--brand, #c41c23); color:#fff; }
.tt-empty-week { margin:20rpx 0 0; padding:24rpx 22rpx; border-left:6rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9); }
.tt-empty-title { color:var(--brand-deep, #8c1614); font-size:26rpx; line-height:1.45; font-weight:700; }
.tt-empty-copy { margin-top:6rpx; color:var(--text-2, #6b5d57); font-size:22rpx; line-height:1.65; }
.grid-instruction { margin:4rpx 0 12rpx; color:var(--text-2, #6b5d57); font-size:22rpx; line-height:1.5; }

/* Course-grid geometry stays aligned to SECTION_ROW_RPX (84rpx) in services/timetable/view.ts.
   网格留在页面边距内，与上下文字同一条边线。七天都在表里：没课的天收成 32rpx 细列（原 48rpx）
   只写单字星期，省下的宽度给有课的天。整列消失会分不清「那天没课」和「表被截了」。 */
.grid { margin:8rpx 0 0; overflow:hidden; border:1rpx solid rgba(43,36,34,0.2); }
.grid-row { display:flex; }
.grid-head { min-height:80rpx; background:var(--paper-shade, #faeee9); }
.grid-head .grid-rail { flex:0 0 56rpx; }
.grid-rail { flex:0 0 56rpx; background:rgba(250,238,233,0.72); }
.grid-th {
  flex:1 1 0; min-width:0; min-height:80rpx; display:flex; flex-direction:column;
  align-items:center; justify-content:center; border-left:1rpx solid rgba(43,36,34,0.13);
  color:var(--text-2, #6b5d57); font-size:20rpx; line-height:1.2; text-align:center;
}
.grid-th-narrow { flex:0 0 32rpx; }
.grid-th-today { background:var(--brand, #c41c23); color:#fff; }
.grid-th-day { color:inherit; font-size:22rpx; }
.grid-th-narrow .grid-th-day { font-size:24rpx; }
.grid-th-date { margin-top:2rpx; color:inherit; font-size:20rpx; }
/* 32rpx 放不下日期数字，写上会挤成两行；日期区间在上方「第 N 周」下面已经给了。 */
.grid-th-narrow .grid-th-date { display:none; }
.grid-body { display:flex; background:rgba(255,255,255,0.42); }
.grid-body > .grid-rail { display:flex; flex-direction:column; }
.grid-no { height:84rpx; flex:none; display:flex; align-items:flex-start; justify-content:center; padding-top:8rpx; border-top:1rpx solid rgba(43,36,34,0.13); color:var(--text-2, #6b5d57); font-size:22rpx; }
.grid-cols { flex:1; min-width:0; display:flex; }
.grid-col { flex:1 1 0; min-width:0; height:1008rpx; position:relative; border-left:1rpx solid rgba(43,36,34,0.13); }
.grid-col-narrow { flex:0 0 32rpx; }
.grid-col-today { background:rgba(198,154,40,0.08); }
.grid-line { height:84rpx; border-bottom:1rpx solid rgba(43,36,34,0.13); }
/* 课块只留色条与浅底：再叠一圈外框，几列密排时整张表会糊成网格纸。
   文字在块内垂直居中——连排 4 节的高块不再「字堆在顶上、下面一大片空」。 */
.grid-block {
  position:absolute; box-sizing:border-box; overflow:hidden; padding:4rpx 5rpx 4rpx 8rpx;
  display:flex; flex-direction:column; justify-content:center;
  border-left:6rpx solid var(--blk-solid, rgba(148,134,127,0.55));
  background:var(--blk-tint, rgba(255,255,255,0.72));
}
.grid-block-name {
  color:var(--text, #2b2422); font-size:22rpx; line-height:1.3; font-weight:600;
  display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden;
}
/* 高块（3 节以上）放得下 4 行课名；2 节块 3 行 + 2 行地点正好铺满 165rpx 的块高。 */
.grid-block-name-full { -webkit-line-clamp:4; }
.grid-block-name-name { font-size:21rpx; line-height:1.28; -webkit-line-clamp:2; }
.grid-block-meta {
  margin-top:3rpx; color:var(--text-2, #6b5d57); font-size:19rpx; line-height:1.35;
  display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden;
}
.grid-block-badge {
  position:absolute; top:3rpx; right:3rpx; min-width:28rpx; height:28rpx; padding:0 5rpx;
  display:flex; align-items:center; justify-content:center; border:1rpx solid var(--gold, #c69a28);
  background:#fff; color:var(--brand-ink, #7a1a12); font-size:17rpx; font-weight:700;
}
.grid-block-review { border-left-color:var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); }
.grid-block-review .grid-block-name,.grid-block-review .grid-block-meta { color:var(--warn, #9a5b1e); }
.grid-block-now { outline:3rpx solid var(--gold, #c69a28); outline-offset:-3rpx; }

/* 列表视图：同一天一组，行底用纸面中性色，课色只留在左侧色条上。
   八种课色同时铺满行底会盖过正文，而列表本来就是拿来读的。 */
.day-list { margin-top:8rpx; }
.day-block { margin-bottom:28rpx; }
.day-title { margin-bottom:10rpx; display:flex; align-items:center; gap:12rpx; color:var(--brand-deep, #8c1614); font-size:24rpx; font-weight:700; }
.day-dot { width:12rpx; height:12rpx; flex:none; background:var(--gold, #c69a28); }
.day-date,.day-today { color:var(--text-3, #746760); font-size:20rpx; font-weight:400; }
.course-item {
  display:flex; justify-content:space-between; align-items:flex-start; gap:16rpx;
  margin-top:14rpx; padding:18rpx 16rpx 18rpx 14rpx;
  border:1rpx solid rgba(43,36,34,0.13); border-left:8rpx solid var(--blk-solid, rgba(148,134,127,0.55));
  background:rgba(255,255,255,0.55);
}
.course-item-review { border-color:var(--warn-line, rgba(214,160,90,0.55)); border-left-color:var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); }
.course-main { flex:1; min-width:0; }
.course-name { color:var(--text, #2b2422); font-size:25rpx; line-height:1.5; font-weight:700; }
.course-tag { margin-left:8rpx; padding:2rpx 8rpx; border:1rpx solid rgba(43,36,34,0.16); color:var(--text-2, #6b5d57); font-size:18rpx; font-weight:400; }
.course-tag-review { border-color:var(--warn-line, rgba(214,160,90,0.55)); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); }
.course-line { margin-top:4rpx; color:var(--text-2, #6b5d57); font-size:21rpx; line-height:1.5; }
.course-warning { margin-top:7rpx; color:var(--warn, #9a5b1e); font-size:20rpx; line-height:1.55; }
/* 原生 button 有 184px 内在宽度：宽度要写死在按钮上（列向 Flex 里 width:100% 不生效，
   实测仍是 184px），同时解除这一列的 min-width:auto，否则最小内容宽度会把整行挤成两半。 */
.course-ops { flex:0 0 100rpx; min-width:0; width:100rpx; display:flex; flex-direction:column; gap:6rpx; }
.course-op {
  flex:none; width:100rpx; max-width:100rpx; min-width:0; min-height:84rpx; padding:6rpx 4rpx;
  border:1rpx solid rgba(43,36,34,0.17); color:var(--brand-ink, #7a1a12); font-size:19rpx;
}
.course-op-delete { color:var(--warn, #9a5b1e); border-color:var(--warn-line, rgba(214,160,90,0.55)); }
.tt-footer { margin-top:24rpx; color:var(--text-3, #746760); font-size:20rpx; line-height:1.65; }
/* 工具区通栏，与网格同一套边距：让「看」和「改」分成两个清楚的横带。 */
.actionbar { display:flex; gap:12rpx; margin:32rpx -36rpx 0; padding:22rpx 36rpx 0; border-top:1rpx solid rgba(43,36,34,0.15); }
.actionbar-item { flex:1; min-height:84rpx; padding:10rpx 4rpx; border:1rpx solid rgba(43,36,34,0.18); color:var(--brand-ink, #7a1a12); font-size:20rpx; }
/* 与空态的 .home-button 同一个形状；这里只调上下留白，颜色继承全局的白字。 */
.tt-assistant { margin-top:22rpx; }
.tt-back-home { margin-top:22rpx; color:var(--brand-ink, #7a1a12); font-size:22rpx; text-align:center; }

.tt-qa { margin-top:20rpx; border:1rpx solid rgba(43,36,34,0.18); background:rgba(255,255,255,0.62); }
.qa-head { min-height:76rpx; display:flex; align-items:center; justify-content:space-between; padding:14rpx 18rpx; background:var(--brand-deep, #8c1614); }
.qa-title { color:#fff; font-size:25rpx; font-weight:700; }
.qa-close {
  /* 微信原生 button 会带 184px 内在宽度，弹性项需显式设宽并解除最小宽度。 */
  flex:0 0 84rpx; min-width:0; width:84rpx; min-height:84rpx; margin-left:8rpx; padding:8rpx;
  display:flex; align-items:center; justify-content:center; color:#fff; font-size:20rpx;
}
.qa-messages { padding:16rpx 18rpx 4rpx; }
.qa-msg { max-width:88%; margin:10rpx 0; padding:14rpx 16rpx; font-size:22rpx; line-height:1.65; }
.qa-msg-user { margin-left:auto; background:var(--brand, #c41c23); color:#fff; }
.qa-msg-ai { border-left:6rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9); color:var(--text, #2b2422); }
.qa-error,.qa-warn,.qa-cap { margin:10rpx 18rpx; padding:11rpx 14rpx; border-left:6rpx solid var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); font-size:20rpx; line-height:1.6; }
.qa-input-row { display:flex; gap:10rpx; margin:12rpx 18rpx; }
.qa-input { flex:1; min-width:0; min-height:72rpx; padding:14rpx; border:1rpx solid rgba(43,36,34,0.2); background:var(--paper, #fdf7f5); font-size:21rpx; }
.qa-send {
  /* 与部门答疑共用 68px 发送键尺寸；固定宽度并居中文字。 */
  flex:0 0 132rpx; min-width:0; width:132rpx; display:flex; align-items:center; justify-content:center;
  background:var(--brand, #c41c23); color:#fff; font-size:20rpx; font-weight:700; line-height:1.3;
}
.qa-note { margin:0 18rpx 16rpx; color:var(--text-3, #746760); font-size:19rpx; line-height:1.6; }

.sheet-mask { position:fixed; inset:0; z-index:20; background:rgba(24,12,12,0.44); }
.sheet {
  position:fixed; left:0; right:0; bottom:0; z-index:21; max-height:76vh;
  display:flex; flex-direction:column; overflow:hidden; border-top:4rpx solid var(--gold, #c69a28);
  background:var(--paper, #fdf7f5);
}
.sheet-handle { width:62rpx; height:5rpx; margin:12rpx auto 0; background:rgba(43,36,34,0.25); }
.sheet-head { padding:17rpx 30rpx 20rpx; background:var(--blk-solid, rgba(148,134,127,0.55)); }
.sheet-name { color:#fff; font-size:34rpx; line-height:1.4; font-weight:700; }
.sheet-sub { margin-top:4rpx; color:rgba(255,255,255,0.86); font-size:21rpx; }
.sheet-body { flex:1 1 auto; min-height:0; padding:8rpx 30rpx 0; }
.sheet-warn { margin:10rpx 0; padding:12rpx 14rpx; border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); font-size:21rpx; line-height:1.6; }
.sheet-row { display:flex; gap:22rpx; padding:12rpx 0; border-bottom:1rpx solid rgba(43,36,34,0.14); }
.sheet-key { flex:0 0 124rpx; color:var(--text-3, #746760); font-size:21rpx; }
.sheet-val { flex:1; min-width:0; color:var(--text, #2b2422); font-size:23rpx; word-break:break-all; }
.sheet-group { margin:14rpx 0 7rpx; color:var(--text-3, #746760); font-size:20rpx; }
.sheet-member { margin-bottom:8rpx; padding:13rpx 14rpx; border:1rpx solid rgba(43,36,34,0.15); background:rgba(255,255,255,0.56); }
.sheet-member-name { font-size:22rpx; font-weight:700; }
.sheet-member-sub { margin-top:2rpx; color:var(--text-2, #6b5d57); font-size:19rpx; }
.sheet-foot { display:flex; align-items:center; gap:10rpx; padding:14rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); }
.sheet-btn { flex:1; min-height:74rpx; color:#fff; background:var(--brand, #c41c23); font-size:22rpx; font-weight:700; }
.sheet-btn-warn { border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); }
.sheet-close { min-width:84rpx; min-height:84rpx; display:flex; align-items:center; justify-content:center; padding:8rpx 6rpx; color:var(--text-3, #746760); font-size:20rpx; }
