.tt-heading { margin-bottom:8px; }
.head-top { display:flex; align-items:center; justify-content:space-between; gap:10px; }
.head-top .eyebrow { flex:1; min-width:0; }
.head-link { flex:none; min-height:44px; padding:11px 10px; border:1px solid #b9847c; border-radius:7px; color:#8c1614; font-size:12px; }
.week-row { display:flex; align-items:center; gap:10px; margin:8px 0 6px; }
.week-nav { flex:none; width:44px; min-height:44px; display:flex; align-items:center; justify-content:center; border:1px solid #aa9990; border-radius:7px; background:#fff; font-size:23px; }
.week-pick { flex:1; min-width:0; text-align:center; }
.week-now { font-size:20px; line-height:1.5; font-weight:700; }
.week-range,.tt-meta { font-size:11px; line-height:1.7; color:#746760; }
.tt-meta { text-align:left; }
.section-head { margin-top:12px; }
.actionbar { display:flex; gap:8px; margin:12px 0; }
.actionbar-item { flex:1; width:0; min-width:0; min-height:44px; padding:10px 6px; border:1px solid #b9847c; border-radius:7px; background:#fff; color:#8c1614; font-size:12px; }
.today { display:flex; gap:12px; align-items:center; padding:16px; margin:16px 0; border:1px solid #bca99d; border-radius:10px; background:#fff; }
.today-dot { width:8px; height:8px; flex:none; background:#147a70; border-radius:50%; }
.today-body { flex:1; min-width:0; }
.today-kicker,.today-sub { font-size:11px; color:#746760; line-height:1.8; }
.today-name { margin:5px 0; font-size:15px; font-weight:600; }
.today-pill { color:#147a70; font-size:12px; }
.setup-hint { display:flex; align-items:center; gap:10px; margin:12px 0; padding:10px 12px; border-left:3px solid #ded4cf; background:#fff; color:#6b5d57; font-size:12px; line-height:1.8; }
.setup-hint-text { flex:1; min-width:0; }
.setup-hint-btn { flex:none; width:60px; min-height:44px; padding:11px 5px; color:#8c1614; text-align:center; border:1px solid #b9847c; border-radius:7px; white-space:nowrap; }
.tt-hint,.tt-empty,.tt-empty-week { padding:36px 0; }
.tt-hint-copy,.tt-empty-copy { margin-top:14px; color:#6b5d57; font-size:13px; line-height:1.9; }
.tt-guide,.tt-privacy { margin-top:16px; font-size:12px; line-height:1.9; color:#746760; }
.tt-guide-note { padding:14px 15px; background:#fff; border-left:3px solid #ded4cf; }
.tt-empty-title { font-size:22px; font-weight:700; }
.seg { display:flex; gap:6px; }
.seg-item { min-height:44px; min-width:54px; padding:10px; border:1px solid #aa9990; border-radius:7px; background:#fff; color:#6b5d57; font-size:12px; text-align:center; }
.seg-item-on { border-color:#8c1614; color:#fff; background:#8c1614; }
.grid-instruction { margin:8px 0; color:#6b5d57; font-size:11px; line-height:1.8; }
.grid-shell { display:flex; width:100%; border:1px solid #ded4cf; border-radius:9px; overflow:hidden; background:#fff; }
.grid-axis { flex:none; width:30px; border-right:1px solid #bca99d; background:#fff; }
.grid-axis-head { height:30px; display:flex; align-items:center; justify-content:center; color:#6b5d57; font-size:9px; }
.grid-no { display:flex; align-items:center; justify-content:center; color:#6b5d57; font-size:9px; white-space:nowrap; }
.grid-scroll { flex:1; width:0; min-width:0; }
.grid-row,.grid-cols { display:flex; }
.grid-head { height:30px; }
.grid-th { flex:0 0 66px; width:66px; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#fff; font-size:11px; line-height:1.3; }
.grid-th-today { color:#fff; background:#8c1614; border-radius:5px; }
.grid-th-date { font-size:9px; }
.grid-col { flex:0 0 66px; width:66px; position:relative; }
.grid-line { height:44px; border-bottom:1px solid #eee6e2; }
.grid-block { position:absolute; overflow:hidden; padding:4px; border-left:2px solid var(--blk-solid, rgba(148,134,127,0.55)); border-radius:5px; background:var(--blk-tint, rgba(255,255,255,0.72)); color:var(--blk-solid, rgba(148,134,127,0.55)); }
.grid-block-review { border-color:#9a5b1e; background:#fff4e4; }
.grid-block-now { outline:2px solid #147a70; }
.grid-block-name { font-size:12px; line-height:1.4; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; word-break:break-all; }
.grid-block-name-name { -webkit-line-clamp:2; }
.grid-block-meta { margin-top:4px; font-size:11px; line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.grid-block-badge { position:absolute; top:2px; right:2px; background:#fff; color:#8c1614; font-size:9px; padding:1px 3px; border-radius:3px; }
.grid-expand { min-height:44px; padding:12px; margin-top:12px; border:1px solid #b9847c; color:#8c1614; background:#fff; font-size:12px; line-height:1.8; }
.day-block { margin-top:20px; }
.day-title { display:flex; align-items:center; gap:8px; font-size:16px; font-weight:600; }
.day-dot { width:6px; height:6px; background:#8c1614; border-radius:50%; }
.day-date,.day-today { color:#746760; font-size:11px; }
.course-item { display:flex; gap:12px; padding:16px; margin-top:12px; border:1px solid #ded4cf; border-left:3px solid var(--blk-solid, rgba(148,134,127,0.55)); border-radius:10px; background:#fff; }
.course-item-review { border-color:#cbaa88; background:#fff4e4; }
.course-main { flex:1; min-width:0; }
.course-name { font-size:15px; line-height:1.6; font-weight:600; }
.course-tag { margin-left:6px; color:#746760; font-size:10px; }
.course-line { margin-top:7px; color:#6b5d57; font-size:12px; line-height:1.8; }
.course-warning { margin-top:8px; color:#9a5b1e; font-size:12px; }
.course-ops { width:54px; flex:none; }
.course-op { width:54px; min-height:44px; padding:8px 4px; margin-bottom:8px; border:1px solid #b9847c; color:#8c1614; font-size:12px; }
.tt-footer { margin-top:16px; padding:14px 15px; background:#fff; border-left:3px solid #ded4cf; color:#746760; font-size:11px; line-height:1.8; }
.tt-back-home { min-height:44px; width:100%; margin-top:14px; padding:12px; font-size:13px; color:#8c1614; text-align:center; }
.tt-qa { padding:16px; margin-top:16px; border:1px solid #ded4cf; background:#fff; border-radius:10px; }
.qa-head { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.qa-title { font-size:16px; font-weight:700; color:#8c1614; }
.qa-close { width:52px; min-height:44px; flex:none; border:1px solid #b9847c; color:#8c1614; font-size:12px; }
.qa-msg { padding:13px 15px; margin-top:12px; font-size:14px; line-height:1.9; border:1px solid #ded4cf; border-radius:10px; white-space:pre-wrap; }
.qa-msg-user { margin-left:16px; background:#faeee9; border-color:#d4b9ac; }
.qa-msg-ai { background:#e9eff6; border-color:#bdcde0; }
.qa-error,.qa-warn,.qa-cap { margin-top:12px; padding:12px; border-left:3px solid #9a5b1e; background:#fff4e4; color:#78420e; font-size:13px; line-height:1.8; }
.qa-input-row { display:flex; align-items:center; gap:8px; margin-top:16px; }
.qa-input { flex:1; min-width:0; height:48px; padding:10px 12px; border:1px solid #aa9990; background:#fff; border-radius:7px; font-size:14px; }
.qa-send { flex:none; width:64px; min-height:48px; padding:12px 8px; background:#c41c23; color:#fff; font-size:14px; }
.qa-note { margin-top:12px; color:#746760; font-size:11px; line-height:1.8; }
.sheet-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:50; background:rgba(43,36,34,.32); }
.sheet { position:fixed; left:0; right:0; bottom:0; z-index:51; width:100%; max-height:86vh; border-radius:16px 16px 0 0; background:#fdf7f5; overflow:hidden; display:flex; flex-direction:column; }
.sheet-handle { width:36px; height:4px; margin:10px auto 0; border-radius:3px; background:#bca99d; }
.sheet-head { padding:16px 20px; border-bottom:1px solid #ded4cf; }
.sheet-name { font-size:20px; font-weight:700; line-height:1.6; }
.sheet-sub { margin-top:6px; color:#746760; font-size:12px; }
.sheet-warn { padding:12px; margin-bottom:16px; background:#fff4e4; color:#78420e; font-size:12px; }
.sheet-key { flex:none; width:56px; color:#746760; }
.sheet-val { flex:1; min-width:0; word-break:break-all; }
.sheet-title { flex:1; font-size:20px; line-height:1.6; font-weight:700; }
.sheet-close { flex:none; min-width:44px; min-height:44px; padding:10px; color:#8c1614; font-size:13px; }
.sheet-scroll { max-height:56vh; }
.sheet-body { box-sizing:border-box; max-height:52vh; padding:16px 20px; }
.sheet-row { display:flex; gap:12px; margin-bottom:12px; font-size:13px; line-height:1.8; }
.sheet-label { flex:none; width:48px; color:#746760; }
.sheet-value { flex:1; min-width:0; word-break:break-all; }
.sheet-group { margin:14px 0 10px; color:#746760; font-size:12px; }
.sheet-member { padding:12px; margin-bottom:10px; border:1px solid #ded4cf; border-radius:8px; background:#fff; }
.sheet-member-name { font-size:14px; font-weight:600; }
.sheet-member-sub { margin-top:5px; color:#746760; font-size:12px; }
.sheet-foot { display:flex; gap:10px; padding:16px 20px calc(16px + env(safe-area-inset-bottom)); }
.sheet-btn { flex:1; width:0; min-height:48px; padding:12px; background:#c41c23; color:#fff; font-size:14px; }
.sheet-btn-warn { background:#fff; color:#8c1614; border:1px solid #b9847c; }

/* ------------------------------------------------------------------
 * 贴班群通知（设计图 02）：粘贴框、金色提案卡、逐条勾选、深色撤销提示条。
 * 金 = AI 产出须确认，红 = 学生动作；圆角与色值与 04 视觉语言一致。
 * ------------------------------------------------------------------ */
.notice-open { margin-top:12px; }
.notice-wrap { margin-top:12px; }
.paste { padding:10px 12px; border:1px dashed var(--control-line,#aa9990); border-radius:10px; background:#fff; }
.paste-from { margin-bottom:4px; color:var(--text-3,#746760); font-size:11px; }
.paste-input { width:100%; min-height:64px; padding:0; color:var(--text-2,#6b5d57); font-size:12.5px; line-height:1.7; background:transparent; }
.notice-read-row { display:flex; margin-top:10px; }
.notice-read { min-height:44px; }
.notice-error { margin-top:10px; padding:10px 12px; border-left:3px solid var(--warn,#9a5b1e); border-radius:6px; background:#fff4e4; color:#78420e; font-size:12.5px; line-height:1.8; }
.proposal { margin-top:12px; border:1px solid var(--ai-line,#e7d3a0); border-radius:12px; background:#fff; overflow:hidden; }
.proposal-head { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 12px; border-bottom:1px solid var(--ai-line,#e7d3a0); background:var(--ai-soft,#fbf4e2); }
.proposal-title { color:var(--text,#2b2422); font-size:14.5px; font-weight:700; }
.change { display:grid; grid-template-columns:22px 1fr; gap:8px; padding:11px 12px; border-bottom:1px solid #f0e6e2; }
.check { width:20px; height:20px; margin-top:2px; border-radius:5px; background:var(--brand,#c41c23); color:#fff; font-size:13px; line-height:20px; text-align:center; }
.check.off { background:#fff; border:1.5px solid var(--control-line,#aa9990); }
.change-body { min-width:0; }
.change-title { color:var(--text,#2b2422); font-size:14px; font-weight:600; line-height:1.6; }
.diff { margin-top:5px; font-size:12.5px; line-height:1.7; }
.diff-old { color:var(--text-3,#746760); text-decoration:line-through; }
.diff-new { color:var(--brand-ink,#7a1a12); font-weight:700; }
.diff-arrow { color:var(--text-3,#746760); }
.diff-lead { color:var(--text-2,#6b5d57); }
.warnline { margin-top:6px; padding:4px 8px; border-radius:6px; background:#fbf1e6; color:var(--warn,#9a5b1e); font-size:11.5px; line-height:1.75; }
.warnline.blocked { background:#f6ece8; color:#8c1614; }
.change-detail { margin-top:6px; color:var(--text-2,#6b5d57); font-size:11.5px; line-height:1.75; }
.quote { margin-top:6px; padding-left:7px; border-left:2px solid var(--ai-line,#e7d3a0); color:var(--text-3,#746760); font-size:11px; line-height:1.7; }
.proposal-actions { display:flex; gap:10px; padding:12px; }
.btn-secondary { min-height:44px; border:1px solid var(--control-line,#aa9990); border-radius:10px; background:#fff; color:var(--brand-ink,#7a1a12); font-size:15px; font-weight:600; }
.btn-primary { min-height:44px; border-radius:10px; background:var(--brand,#c41c23); color:#fff; font-size:15px; font-weight:600; }
.toast { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; padding:10px 12px; border-radius:10px; background:#2b2422; color:#fff; font-size:13px; }
.toast-text { flex:1; min-width:0; line-height:1.7; }
.toast-undo { flex:none; padding:2px 6px; color:#f2c96b; font-size:13px; font-weight:700; }
.diff-note { color:var(--text-3,#746760); }
/* 课表页的「贴班群通知」直接入口：与「问问课表助手」并排，金色底表示这是 AI 产出要人确认。 */
.tt-notice-entry { margin-top:10px; border-color:var(--ai-line,#e7d3a0); background:var(--ai-soft,#fbf4e2); color:var(--ai,#a67f1c); font-weight:600; }
