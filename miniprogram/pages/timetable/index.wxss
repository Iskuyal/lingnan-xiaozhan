/* 周课表页面样式：网格按节次与星期排布，不出现具体时刻。 */
.tt-heading { margin-bottom: 32rpx; }
.tt-meta { color: #547367; font-size: 25rpx; margin-top: 8rpx; }
.tt-hint { margin-top: 60rpx; }
.tt-hint-copy { color: #576c63; font-size: 28rpx; margin: 16rpx 0; line-height: 1.8; }
.tt-empty { margin-top: 40rpx; }
.tt-guide { border-left: 6rpx solid #bed1c5; padding: 16rpx 24rpx; margin: 28rpx 0 0; color: #35564a; font-size: 27rpx; background: #eef5f1; }
.tt-guide-note { border-left-color: #d7c9a6; background: #f7f4ea; }
.tt-privacy { color: #6b7f76; font-size: 24rpx; margin-top: 24rpx; }
.tt-actions { display: flex; gap: 20rpx; margin-bottom: 28rpx; }
.tt-action { flex: 1; background: #eef5f1; color: #23664e; border-radius: 16rpx; padding: 20rpx 0; font-size: 27rpx; font-weight: 600; margin: 0; }
.week-switch { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.week-button { background: #eef5f1; color: #23664e; border-radius: 14rpx; padding: 14rpx 22rpx; font-size: 25rpx; margin: 0; }
.week-picker { flex: 1; text-align: center; }
.week-current { font-size: 30rpx; font-weight: 600; color: #183c31; }
.tt-empty-week { margin-top: 20rpx; }
.grid { border: 2rpx solid #dbe7e0; border-radius: 16rpx; overflow: hidden; background: #fff; }
.grid-row { display: flex; border-top: 2rpx solid #eef2ef; }
.grid-row:first-child { border-top: 0; }
.grid-head { background: #f1f6f3; }
.grid-cell { flex: 1; min-width: 0; border-left: 2rpx solid #eef2ef; padding: 8rpx 6rpx; font-size: 20rpx; line-height: 1.4; }
.grid-cell:first-child { border-left: 0; }
.grid-corner { flex: 0 0 96rpx; color: #547367; font-size: 19rpx; display: flex; align-items: center; }
.grid-th { text-align: center; color: #35564a; font-weight: 600; }
.grid-course { color: #1d4c3c; margin-bottom: 6rpx; word-break: break-all; }
.grid-course-review { color: #9a5b1e; }
.day-list { margin-top: 36rpx; }
.day-head { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.day-block { margin-bottom: 24rpx; }
.day-title { color: #547367; font-size: 26rpx; margin-bottom: 8rpx; }
.course-item { background: #fff; border-radius: 16rpx; padding: 22rpx 24rpx; margin-bottom: 16rpx; display: flex; justify-content: space-between; gap: 20rpx; }
.course-main { flex: 1; min-width: 0; }
.course-name { font-size: 29rpx; font-weight: 600; }
.course-tag { font-size: 20rpx; font-weight: 400; color: #547367; background: #eef5f1; border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 10rpx; }
.course-tag-review { color: #9a5b1e; background: #f8efe2; }
.course-line { color: #576c63; font-size: 25rpx; margin-top: 6rpx; }
.course-warning { color: #9a5b1e; font-size: 23rpx; margin-top: 8rpx; }
.course-ops { display: flex; flex-direction: column; gap: 10rpx; }
.course-op { background: #eef5f1; color: #23664e; border-radius: 12rpx; padding: 10rpx 18rpx; font-size: 23rpx; margin: 0; }
.course-op-delete { background: #f8efe2; color: #9a5b1e; }
.tt-secondary { background: #eef5f1; color: #23664e; }
.tt-footer { color: #6b7f76; font-size: 23rpx; margin-top: 40rpx; }

.tt-assistant-open { margin-top: 24rpx; }
.tt-qa { margin-top: 24rpx; }
.qa-panel { background: #fff; border-radius: 22rpx; padding: 26rpx 28rpx; }
.qa-head { display: flex; align-items: center; justify-content: space-between; }
.qa-title { font-size: 30rpx; font-weight: 600; }
.qa-close { font-size: 24rpx; color: #547367; padding: 0; margin: 0; background: none; border: none; line-height: 1; }
.qa-close::after { border: none; }
.qa-messages { margin-top: 20rpx; }
.qa-msg { font-size: 26rpx; line-height: 1.7; padding: 14rpx 20rpx; border-radius: 16rpx; margin-bottom: 12rpx; }
.qa-msg-ai { background: #f2f6f3; color: #33483f; }
.qa-msg-user { background: #e3efe9; color: #33483f; }
.qa-error { color: #b3543a; font-size: 24rpx; margin: 8rpx 0; }
.qa-warn { color: #b3543a; font-size: 23rpx; line-height: 1.7; margin: 8rpx 0 12rpx; }
.qa-cap { color: #a5762b; font-size: 22rpx; margin: 4rpx 0 8rpx; }
.qa-input-row { display: flex; align-items: center; margin-top: 12rpx; }
.qa-input { flex: 1; background: #f2f6f3; border-radius: 999rpx; padding: 14rpx 26rpx; font-size: 26rpx; }
.qa-send { margin-left: 14rpx; background: #2e6e5b; color: #fff; font-size: 26rpx; border-radius: 999rpx; padding: 0 30rpx; line-height: 2.2; }
.qa-send[disabled] { background: #a9c4bb; color: #fff; }
.qa-note { margin-top: 16rpx; color: #63786d; font-size: 22rpx; line-height: 1.6; }
