/**
 * 周课表页面样式：液态玻璃——玻璃面板与玻璃网格，表头带金色薄层。
 * 标题沿用全局 .section-title / .eyebrow，在本页作用域内改色，不改标记。
 * 待核对与失败项一律琥珀色，刻意避开品牌红，避免与「重点」混淆。
 * 颜色与材质引用 app.wxss 的令牌（含回退值）；课块颜色的三个槽 --blk-* 由数据在内联样式里填，
 * 具体值见 services/timetable/palette.ts。
 */
.tt-heading {
  margin-bottom: 24rpx; padding: 28rpx 30rpx;
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 20rpx 52rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.tt-heading .eyebrow { color: var(--text-3, #94867f); letter-spacing: 1rpx; }
.tt-meta { color: var(--text-3, #94867f); font-size: 25rpx; margin-top: 8rpx; }
.tt-hint { margin-top: 60rpx; }
.tt-hint-copy { color: var(--text-2, #6b5d57); font-size: 28rpx; margin: 16rpx 0; line-height: 1.8; }
.tt-empty { margin-top: 40rpx; }
.tt-guide {
  border-radius: var(--r-control, 20rpx); padding: 20rpx 24rpx; margin: 28rpx 0 0;
  color: var(--brand-ink, #7a1a12); font-size: 27rpx; line-height: 1.8;
  background: linear-gradient(150deg, rgba(198,154,40,0.22), rgba(198,154,40,0.10));
  border: 1rpx solid rgba(198,154,40,0.30);
}
.tt-guide-note { background: var(--warn-soft, rgba(255,244,228,0.86)); border-color: var(--warn-line, rgba(214,160,90,0.55)); color: var(--warn, #9a5b1e); }
.tt-privacy { color: var(--text-3, #94867f); font-size: 24rpx; margin-top: 24rpx; }

/**
 * 周次与翻周。周次是头部的主角（学期副标题在上面一行），左右两个圆钮翻周，
 * 中间点开是周次选择器；「上一周/下一周」两字按钮会跟周次抢宽度，所以用符号。
 */
.week-row { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; }
.week-nav {
  flex: 0 0 76rpx; width: auto; text-align: center; padding: 6rpx 0; font-size: 34rpx; line-height: 1.2; margin: 0;
  color: var(--brand-deep, #8c1614);
  background: var(--glass, rgba(255,255,255,0.52));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-pill, 999rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92));
}
.week-pick { flex: 1 1 0%; min-width: 0; text-align: center; }
/* 「第 3 周」的数字两侧是空格，容器一窄就会在空格处折行，禁止换行。 */
.week-now { font-size: 40rpx; font-weight: 700; color: var(--brand-deep, #8c1614); letter-spacing: 1rpx; white-space: nowrap; }

/* 金杠小标题 + 右侧「课表 / 列表」切换 */
.section-head { margin: 8rpx 0 16rpx; }
.seg {
  margin-left: auto; display: flex; padding: 4rpx;
  background: rgba(255,255,255,0.42);
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-pill, 999rpx);
}
.seg-item { padding: 4rpx 26rpx; font-size: 24rpx; color: var(--text-2, #6b5d57); border-radius: var(--r-pill, 999rpx); }
.seg-item-on { background: rgba(196,28,35,0.90); color: #fff; font-weight: 600; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.36); }

/**
 * 周网格（设计图 01）。
 * 几何：单节行高 84rpx（= 43.7px）、左侧节次栏 84rpx；**列宽自适应**——有课的天均分剩余宽度，
 * 没课的天收窄到 44rpx。7 列均分时每列只有约 82rpx，课名两个字就折行，这是本版最关键的取舍。
 * 块的位置/高度/泳道由 view 层算好写在内联样式里，这里只负责长什么样。
 */
.grid {
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-control, 20rpx); overflow: hidden;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.grid-row { display: flex; align-items: center; }
.grid-head { height: 64rpx; background: linear-gradient(150deg, rgba(198,154,40,0.24), rgba(198,154,40,0.12)); border-bottom: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); }
.grid-rail { flex: 0 0 84rpx; }
.grid-th { flex: 1 1 0; min-width: 0; text-align: center; color: var(--brand-deep, #8c1614); font-size: 24rpx; font-weight: 700; line-height: 1.15; }
.grid-th-narrow { flex: 0 0 44rpx; }
.grid-th-narrow .grid-th-date { font-size: 18rpx; }
.grid-th-date { display: block; color: var(--text-3, #94867f); font-size: 20rpx; font-weight: 400; }
.grid-th-today .grid-th-day {
  display: inline-flex; align-items: center; justify-content: center;
  width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--brand, #c41c23); color: #fff;
}
.grid-th-today .grid-th-date { color: var(--brand-ink, #7a1a12); font-weight: 600; }
.grid-body { display: flex; background: rgba(255,255,255,0.30); }
.grid-no {
  height: 84rpx; display: flex; align-items: center; justify-content: center;
  color: var(--text-3, #94867f); font-size: 22rpx; font-weight: 600;
  border-bottom: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70));
}
.grid-cols { flex: 1 1 0; min-width: 0; display: flex; }
.grid-col { flex: 1 1 0; min-width: 0; position: relative; border-left: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); }
.grid-col:first-child { border-left: 0; }
.grid-col-narrow { flex: 0 0 44rpx; background: rgba(255,255,255,0.14); }
.grid-col-today { background: rgba(198,154,40,0.14); }
.grid-line { height: 84rpx; border-bottom: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); }

.grid-block {
  position: absolute; box-sizing: border-box; padding: 6rpx 8rpx 6rpx 14rpx; overflow: hidden;
  border: 1rpx solid var(--blk-line, rgba(255,255,255,0.62));
  border-left-width: 6rpx; border-left-style: solid;
  border-left-color: var(--blk-solid, rgba(148,134,127,0.55));
  background: var(--blk-tint, rgba(255,255,255,0.72));
  border-radius: var(--r-chip, 12rpx);
}
.grid-block-name {
  font-size: 20rpx; font-weight: 600; line-height: 1.28; color: var(--text, #2b2422);
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
}
.grid-block-meta {
  font-size: 18rpx; color: var(--text-2, #6b5d57); line-height: 1.3; margin-top: 2rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.grid-block-badge {
  position: absolute; top: 4rpx; right: 4rpx; min-width: 28rpx; height: 28rpx; padding: 0 6rpx;
  border-radius: var(--r-pill, 999rpx); background: #fff; color: var(--brand-ink, #7a1a12);
  border: 1rpx solid var(--gold, #c69a28); font-size: 18rpx; font-weight: 700; text-align: center; line-height: 28rpx;
}
/* 待核对：琥珀虚线 + 琥珀底，与列表里的警示行同一语义（只标记不猜）。 */
.grid-block-review {
  border-style: dashed;
  background: var(--warn-soft, rgba(255,244,228,0.86));
  border-color: var(--warn-line, rgba(214,160,90,0.55));
  border-left-color: var(--warn, #9a5b1e);
}
.grid-block-review .grid-block-name { color: var(--warn, #9a5b1e); }
/* 正在上：金描边，与今日速查条指的是同一节课。 */
.grid-block-now { box-shadow: 0 0 0 3rpx rgba(198,154,40,0.75); }

.tt-empty-week { margin: 20rpx 0 0; }
.day-list { margin-top: 8rpx; }
.day-block { margin-bottom: 24rpx; }
.day-title { color: var(--text-3, #94867f); font-size: 26rpx; margin-bottom: 8rpx; }
.course-item {
  padding: 22rpx 24rpx; margin-bottom: 16rpx; display: flex; justify-content: space-between; gap: 20rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-card, 24rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.course-main { flex: 1; min-width: 0; }
.course-name { font-size: 29rpx; font-weight: 600; }
.course-tag { font-size: 20rpx; font-weight: 400; color: var(--text-2, #6b5d57); background: rgba(255,255,255,0.75); border-radius: var(--r-pill, 999rpx); padding: 2rpx 12rpx; margin-left: 10rpx; }
.course-tag-review { color: var(--warn, #9a5b1e); background: var(--warn-soft, rgba(255,244,228,0.86)); }
.course-line { color: var(--text-2, #6b5d57); font-size: 25rpx; margin-top: 6rpx; }
.course-warning { color: var(--warn, #9a5b1e); font-size: 23rpx; margin-top: 8rpx; }
.course-ops { display: flex; flex-direction: column; gap: 10rpx; }
.course-op {
  padding: 10rpx 20rpx; font-size: 23rpx; margin: 0; color: #fff;
  background: rgba(196,28,35,0.90); border-radius: var(--r-pill, 999rpx);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.36);
}
.course-op-delete { background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e); box-shadow: none; }
.tt-secondary { background: var(--glass, rgba(255,255,255,0.52)); color: var(--brand-ink, #7a1a12); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); }
.tt-footer { color: var(--text-3, #94867f); font-size: 23rpx; margin-top: 32rpx; }

/* 底部动作条：导入与手工新增不再占头部，进来第一眼是本周课表。 */
.actionbar { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actionbar-item {
  flex: 1; padding: 18rpx 0; font-size: 26rpx; font-weight: 600; margin: 0;
  color: var(--brand-ink, #7a1a12);
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-control, 20rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92));
}

/* 课表助手（Ticket 06）：与部门问答共用一套对话语言，材质随主题。 */
.tt-assistant-open { margin-top: 24rpx; }
.tt-qa { margin-top: 24rpx; }
.qa-panel {
  padding: 26rpx 28rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.qa-head { display: flex; align-items: center; justify-content: space-between; }
.qa-title { font-size: 30rpx; font-weight: 600; color: var(--brand-deep, #8c1614); }
.qa-close { font-size: 24rpx; color: var(--text-3, #94867f); padding: 0; margin: 0; background: none; border: none; line-height: 1; }
.qa-close::after { border: none; }
.qa-messages { margin-top: 20rpx; }
.qa-msg { font-size: 26rpx; line-height: 1.7; padding: 14rpx 20rpx; border-radius: var(--r-control, 20rpx); margin-bottom: 12rpx; }
.qa-msg-ai { background: rgba(198,154,40,0.16); border: 1rpx solid rgba(198,154,40,0.28); color: var(--text, #2b2422); }
.qa-msg-user { background: rgba(196,28,35,0.12); border: 1rpx solid rgba(196,28,35,0.22); color: var(--brand-ink, #7a1a12); }
.qa-error { color: var(--warn, #9a5b1e); font-size: 24rpx; margin: 8rpx 0; }
.qa-warn { color: var(--warn, #9a5b1e); font-size: 23rpx; line-height: 1.7; margin: 8rpx 0 12rpx; }
.qa-cap { color: var(--warn, #9a5b1e); font-size: 22rpx; margin: 4rpx 0 8rpx; }
.qa-input-row { display: flex; align-items: center; margin-top: 12rpx; }
.qa-input { flex: 1; background: rgba(255,255,255,0.86); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); border-radius: var(--r-pill, 999rpx); padding: 14rpx 26rpx; font-size: 26rpx; }
.qa-send { margin-left: 14rpx; font-size: 26rpx; border-radius: var(--r-pill, 999rpx); padding: 0 30rpx; line-height: 2.2; color: #fff; background: rgba(196,28,35,0.92); border: 1rpx solid rgba(255,255,255,0.34); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40); }
.qa-send[disabled] { background: rgba(196,28,35,0.35); color: #fff; box-shadow: none; }
.qa-note { margin-top: 16rpx; color: var(--text-3, #94867f); font-size: 22rpx; line-height: 1.6; }
