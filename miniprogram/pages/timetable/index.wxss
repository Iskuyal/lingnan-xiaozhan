/**
 * 周课表页面样式：液态玻璃——玻璃面板与玻璃网格，表头带金色薄层。
 * 单视图收纳版：网格是唯一视图，点课程弹编辑滑层；导入与手工入口收进页脚；
 * 课表助手改为悬浮入口 + 独立滑层。标题沿用全局 .section-title，在本页作用域内改色。
 * 待核对与失败项一律琥珀色，刻意避开品牌红，避免与「重点」混淆。
 * 颜色与材质引用 app.wxss 的令牌（含回退值）。
 */
.tt-heading {
  margin-bottom: 28rpx; padding: 22rpx 28rpx;
  display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx;
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 20rpx 52rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.tt-heading .section-title { color: var(--brand-deep, #8c1614); font-size: 36rpx; font-weight: 700; letter-spacing: 2rpx; }
.tt-heading .tt-meta { color: var(--text-3, #94867f); font-size: 23rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tt-hint { margin-top: 60rpx; }
.tt-hint-copy { color: var(--text-2, #6b5d57); font-size: 28rpx; margin: 16rpx 0; line-height: 1.8; }
.tt-empty { margin-top: 40rpx; }
.tt-guide {
  border-radius: var(--r-control, 20rpx); padding: 20rpx 24rpx; margin: 28rpx 0 0;
  color: var(--brand-ink, #7a1a12); font-size: 27rpx; line-height: 1.8;
  background: linear-gradient(150deg, rgba(198,154,40,0.22), rgba(198,154,40,0.10));
  border: 1rpx solid rgba(198,154,40,0.30);
}
.tt-guide-note { background: var(--warn-soft, rgba(255,244,228,0.86)); border-color: var(--warn-line, rgba(214,160,90,0.55)); color: var(--warn, #9a5b1e); }
.tt-privacy { color: var(--text-3, #94867f); font-size: 24rpx; margin-top: 24rpx; }
.tt-secondary { background: var(--glass, rgba(255,255,255,0.52)); color: var(--brand-ink, #7a1a12); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); }

.week-switch { display: flex; align-items: center; margin-bottom: 24rpx; gap: 20rpx; }
/**
 * 小程序 button 的默认宽度按容器撑开，两个按钮把中间的周次挤到只剩 26pt（「第 1 周」折行），
 * 而禁止收缩又会让整行溢出（「下一周」被裁）。
 * 用 flex-basis 定宽而不是 width：在 flex 布局里 flex-basis 优先于 width，
 * 不会被 button 的默认宽度盖掉。两个按钮各 152rpx，剩下全给中间。
 */
.week-button {
  flex: 0 0 152rpx; width: auto; text-align: center;
  padding: 14rpx 0; font-size: 25rpx; margin: 0; color: var(--brand-deep, #8c1614);
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-pill, 999rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92));
}
.week-picker { flex: 1 1 0%; min-width: 0; text-align: center; }
/* 「第 3 周」的数字两侧是空格，容器一窄就会在空格处折成三行，禁止换行。 */
.week-current { font-size: 30rpx; font-weight: 700; color: var(--brand-deep, #8c1614); letter-spacing: 1rpx; white-space: nowrap; }
.tt-empty-week { margin-top: 20rpx; }

.grid {
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-control, 20rpx); overflow: hidden;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.grid-row { display: flex; border-top: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); }
.grid-row:first-child { border-top: 0; }
.grid-head { background: linear-gradient(150deg, rgba(198,154,40,0.24), rgba(198,154,40,0.12)); }
.grid-cell { flex: 1; min-width: 0; border-left: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); padding: 8rpx 6rpx; font-size: 20rpx; line-height: 1.4; }
.grid-cell:first-child { border-left: 0; }
.grid-corner { flex: 0 0 96rpx; color: var(--text-3, #94867f); font-size: 19rpx; display: flex; align-items: center; }
.grid-th { text-align: center; color: var(--brand-deep, #8c1614); font-weight: 700; }
.grid-course { color: var(--text, #2b2422); margin-bottom: 6rpx; word-break: break-all; border-radius: 8rpx; padding: 4rpx 6rpx; }
/* 有课的格子按红/金交替着色，同一格内相邻课程一眼可分；待核对仍用琥珀色，不与主题色混同。 */
.grid-course-red { background: rgba(196,28,35,0.10); color: var(--brand-ink, #7a1a12); }
.grid-course-gold { background: rgba(198,154,40,0.20); color: #5c4714; }
.grid-course-review { color: var(--warn, #9a5b1e); background: var(--warn-soft, rgba(255,244,228,0.86)); }
.course-tag { font-size: 20rpx; font-weight: 400; color: var(--text-2, #6b5d57); background: rgba(255,255,255,0.75); border-radius: var(--r-pill, 999rpx); padding: 2rpx 12rpx; }
.course-tag-review { color: var(--warn, #9a5b1e); background: var(--warn-soft, rgba(255,244,228,0.86)); }

.tt-footer { color: var(--text-3, #94867f); font-size: 23rpx; margin-top: 28rpx; }
/* 学期级动作收纳在课表下方：仍是独立按钮，但不压在日常视野顶部；空状态才做主角。 */
.tt-foot-actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 20rpx; }
.tt-foot-actions .home-button { margin: 0; }
.tt-back-link { display: block; text-align: center; color: var(--text-3, #94867f); font-size: 24rpx; margin-top: 36rpx; }

/* 底部滑层：课程编辑与课表助手共用；scrim 负责压暗背后内容。 */
.tt-scrim {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 20;
  background: rgba(43,36,34,0.38);
}
.tt-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 21;
  max-height: 82vh; overflow-y: auto;
  padding: 14rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px)); backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-bottom: 0;
  border-radius: var(--r-panel, 32rpx) var(--r-panel, 32rpx) 0 0;
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 -12rpx 40rpx rgba(43,36,34,0.28);
  animation: tt-sheet-in 0.22s ease;
}
@keyframes tt-sheet-in { from { transform: translateY(40rpx); opacity: 0.6; } to { transform: none; opacity: 1; } }
.tt-sheet-handle { width: 64rpx; height: 8rpx; border-radius: var(--r-pill, 999rpx); background: rgba(43,36,34,0.16); margin: 8rpx auto 20rpx; }
.tt-sheet-title { font-size: 31rpx; font-weight: 700; color: var(--brand-deep, #8c1614); display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
/* 课程详情逐字段成行：左侧灰色标签、右侧取值；节次是核心字段，用深红加重。 */
.tt-sheet-fields { margin-top: 16rpx; }
.tt-field { display: flex; align-items: baseline; margin-top: 12rpx; }
.tt-field-label { flex: 0 0 120rpx; color: var(--text-3, #94867f); font-size: 24rpx; }
.tt-field-value { flex: 1; min-width: 0; color: var(--text, #2b2422); font-size: 26rpx; word-break: break-all; }
.tt-field-key { color: var(--brand-deep, #8c1614); font-weight: 700; }
.tt-field-empty { color: var(--text-3, #94867f); }
.tt-sheet-warn { margin-top: 12rpx; background: var(--warn-soft, rgba(255,244,228,0.86)); border: 1rpx solid var(--warn-line, rgba(214,160,90,0.55)); color: var(--warn, #9a5b1e); border-radius: var(--r-control, 20rpx); padding: 12rpx 18rpx; font-size: 23rpx; line-height: 1.7; }
.tt-sheet-actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
/* 全局 .home-button 自带 64rpx 上边距，滑层内不需要。 */
.tt-sheet-actions .home-button { margin: 0; }
.tt-sheet-warn-btn { background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e); box-shadow: none; border-color: var(--warn-line, rgba(214,160,90,0.55)); }

/* 课表助手悬浮入口：课表可问时出现，问完即收，不占课表视野。 */
.tt-fab {
  position: fixed; right: 32rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); z-index: 15;
  margin: 0; padding: 0 32rpx; line-height: 2.6; font-size: 26rpx; font-weight: 600;
  color: #fff; background: linear-gradient(150deg, rgba(196,28,35,0.96) 0%, rgba(140,22,20,0.92) 100%);
  border: 1rpx solid rgba(255,255,255,0.34); border-radius: var(--r-pill, 999rpx);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.42), 0 16rpx 40rpx rgba(140,22,20,0.36);
}

/* 课表助手（Ticket 06）：与部门问答共用一套对话语言，材质随主题，装在滑层里。 */
.tt-qa .qa-messages { max-height: 40vh; overflow-y: auto; margin-top: 20rpx; }
.qa-head { display: flex; align-items: center; justify-content: space-between; }
.qa-title { font-size: 30rpx; font-weight: 600; color: var(--brand-deep, #8c1614); }
.qa-close { font-size: 24rpx; color: var(--text-3, #94867f); padding: 0; margin: 0; background: none; border: none; line-height: 1; }
.qa-close::after { border: none; }
.qa-msg { font-size: 26rpx; line-height: 1.7; padding: 14rpx 20rpx; border-radius: var(--r-control, 20rpx); margin-bottom: 12rpx; }
.qa-msg-ai { background: rgba(198,154,40,0.16); border: 1rpx solid rgba(198,154,40,0.28); color: var(--text, #2b2422); }
.qa-msg-user { background: rgba(196,28,35,0.12); border: 1rpx solid rgba(196,28,35,0.22); color: var(--brand-ink, #7a1a12); }
.qa-error { color: var(--warn, #9a5b1e); font-size: 24rpx; margin: 8rpx 0; }
.qa-warn { color: var(--warn, #9a5b1e); font-size: 23rpx; line-height: 1.7; margin: 8rpx 0 12rpx; }
.qa-cap { color: var(--warn, #9a5b1e); font-size: 22rpx; margin: 4rpx 0 8rpx; }
.qa-input-row { display: flex; align-items: center; margin-top: 12rpx; }
.qa-input { flex: 1; background: rgba(255,255,255,0.86); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); border-radius: var(--r-pill, 999rpx); padding: 14rpx 26rpx; font-size: 26rpx; }
.qa-send { margin-left: 14rpx; font-size: 26rpx; border-radius: var(--r-pill, 999rpx); padding: 0 30rpx; line-height: 2.2; color: #fff; background: rgba(196,28,35,0.92); border: 1rpx solid rgba(255,255,255,0.34); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.40); }
.qa-send[disabled] { background: rgba(196,28,35,0.35); color: #fff; box-shadow: none; }
.qa-note { margin-top: 16rpx; color: var(--text-3, #94867f); font-size: 22rpx; line-height: 1.6; }
