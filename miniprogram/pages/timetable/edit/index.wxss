.edit-block { padding-top:36px; }
.edit-copy,.edit-error { margin-top:14px; color:#6b5d57; font-size:13px; line-height:1.9; }
.edit-error { color:#9a5b1e; }
.edit-heading { margin-bottom:16px; }
.edit-heading .section-title { font-size:22px; }
.edit-group { margin-top:22px; }
.edit-group .section-head { margin:22px 0 12px; }
.edit-group-title { font-size:17px; font-weight:700; }
.edit-field { margin-top:16px; }
.edit-label { margin-bottom:8px; font-size:13px; font-weight:600; }
.edit-input { width:100%; min-height:48px; padding:12px 13px; background:#fff; border:1px solid #aa9990; border-radius:7px; font-size:14px; line-height:1.7; }
.edit-input-row { display:flex; gap:8px; align-items:center; }
.edit-input-num { flex:1; min-width:0; width:54px; text-align:center; }
.edit-unit,.edit-unit-to { flex:none; font-size:12px; color:#746760; }
.edit-hint,.edit-quiet { margin-top:7px; color:#746760; font-size:11px; line-height:1.8; }
.edit-hint-warn { color:#9a5b1e; }
.edit-callout { margin-top:14px; padding:14px 15px; border-left:3px solid #9a5b1e; background:#fff4e4; color:#78420e; font-size:13px; line-height:1.8; }
.edit-callout-strong { font-weight:600; }
.edit-callout-raw { margin-top:8px; font-size:12px; }
.edit-pills { display:flex; gap:6px; flex-wrap:wrap; }
.edit-pill { flex:1; min-width:0; min-height:44px; padding:10px 5px; border:1px solid #aa9990; border-radius:7px; background:#fff; color:#2b2422; font-size:13px; text-align:center; }
.edit-pill-on { background:#8c1614; border-color:#8c1614; color:#fff; }
.edit-pills-mid { align-items:center; }
.edit-swatch-note { flex-basis:100%; margin-top:6px; }
.edit-chips { display:flex; gap:8px; margin:12px 0; }
.edit-chip { flex:1; min-height:44px; padding:10px 6px; text-align:center; border:1px solid #b9847c; border-radius:7px; background:#fff; color:#8c1614; font-size:12px; }
.edit-weeks { display:flex; flex-wrap:wrap; gap:6px; }
.edit-wk { width:calc((100% - 24px) / 5); min-height:44px; display:flex; align-items:center; justify-content:center; border:1px solid #aa9990; border-radius:6px; background:#fff; font-size:13px; }
.edit-wk-on { background:#8c1614; border-color:#8c1614; color:#fff; }
.edit-wk-off { color:#746760; }
.edit-swatches { display:flex; flex-wrap:wrap; gap:10px; margin-top:12px; }
.edit-swatch { width:44px; height:44px; border-radius:8px; border:3px solid #fff; background:var(--blk-solid, rgba(148,134,127,0.55)); }
.edit-swatch-on { outline:2px solid #8c1614; }
.edit-mini { margin-top:14px; border:1px solid #ded4cf; background:#fff; border-radius:8px; padding:6px; }
.edit-mini-grid { display:flex; }
.edit-mini-col { flex:1; min-width:0; }
.edit-mini-th { font-size:11px; text-align:center; line-height:28px; }
.edit-mini-cell { height:30rpx; margin-bottom:4rpx; border-bottom:1px solid #eee6e2; }
.edit-mini-block { margin-bottom:4rpx; background:var(--blk-tint, rgba(255,255,255,0.72)); border-left:2px solid var(--blk-solid, rgba(148,134,127,0.55)); }
.edit-mini-note { margin-top:8px; }
.edit-delete,.edit-cancel { min-height:44px; padding:12px; margin-top:12px; color:#8c1614; background:transparent; border:1px solid #b9847c; border-radius:8px; font-size:13px; text-align:center; }
.edit-footnote { margin-top:18px; font-size:11px; line-height:1.8; color:#746760; }
