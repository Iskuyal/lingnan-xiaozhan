/**
 * 课程表单样式（设计图 06）：金杠小标题分四组，玻璃卡上的输入面自带一条暖描边
 * （表单页比主页长，玻璃面到下半页接近纯白，白盒子压在白卡上就读不出「这里可以填」）。
 *
 * 颜色与材质引用 app.wxss 的令牌（含回退值）；课块颜色的三个槽 --blk-* 由数据在内联样式里填，
 * 具体值见 services/timetable/palette.ts。待核对与校验问题一律琥珀，品牌红只用于选中态与主按钮。
 * 尺寸从 06-course-edit.html 按 1rpx = 0.52px 换算。
 */
.edit-block { margin-top: 40rpx; }
.edit-copy { color: var(--text-2, #6b5d57); font-size: 28rpx; margin-top: 12rpx; }
.edit-error {
  background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e);
  border-radius: var(--r-control, 20rpx); padding: 20rpx 24rpx; font-size: 27rpx; line-height: 1.7; margin: 20rpx 0;
}
.edit-heading { margin-bottom: 24rpx; }

/* 玻璃分组卡：一屏四组，组间留白 24rpx（图上 12.5px）。 */
.edit-group {
  margin-bottom: 24rpx; padding: 25rpx 30rpx 30rpx;
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 20rpx 52rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.edit-group .section-head { margin-bottom: 22rpx; }
.edit-group-title { font-size: 32rpx; font-weight: 600; color: var(--brand-deep, #8c1614); }

/* 字段与输入面 */
.edit-field { margin-bottom: 28rpx; }
.edit-field-last { margin-bottom: 0; }
.edit-label { color: var(--text-2, #6b5d57); font-size: 24rpx; margin-bottom: 10rpx; }
.edit-input {
  padding: 16rpx 24rpx; font-size: 28rpx; color: var(--text, #2b2422);
  background: var(--glass-strong, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-drop, rgba(92,28,26,0.13));
  border-radius: var(--r-control, 20rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92));
}
.edit-input-row { display: flex; align-items: center; gap: 16rpx; }
.edit-input-num { flex: 0 0 162rpx; text-align: center; padding-left: 0; padding-right: 0; }
.edit-unit { color: var(--text-2, #6b5d57); font-size: 26rpx; }
.edit-unit-to { color: var(--text-3, #94867f); font-size: 24rpx; }
.edit-hint { color: var(--text-3, #94867f); font-size: 24rpx; margin-top: 8rpx; line-height: 1.7; }
.edit-hint-warn { color: var(--warn, #9a5b1e); }
.edit-quiet { color: var(--text-3, #94867f); font-size: 24rpx; line-height: 1.7; }

/* 琥珀提示条：原文与待核对项只读摆在这里 */
.edit-callout {
  margin-bottom: 28rpx; padding: 20rpx 24rpx;
  border-radius: var(--r-control, 20rpx); font-size: 26rpx; line-height: 1.75;
  color: var(--warn, #9a5b1e);
  background: var(--warn-soft, rgba(255,244,228,0.86));
  border: 1rpx solid var(--warn-line, rgba(214,160,90,0.55));
}
.edit-callout-strong { font-weight: 600; }
.edit-callout-raw { margin-top: 8rpx; font-size: 23rpx; word-break: break-all; opacity: 0.86; }

/* pill：星期、周次改法、配色方式共用一套 */
.edit-pills { display: flex; flex-wrap: wrap; gap: 14rpx; }
.edit-pills-mid { align-items: center; }
.edit-pill {
  padding: 8rpx 22rpx; font-size: 24rpx; color: var(--brand-ink, #7a1a12);
  background: var(--glass-strong, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-pill, 999rpx);
}
.edit-pill-on { color: #fff; background: rgba(196,28,35,0.90); border-color: rgba(255,255,255,0.32); font-weight: 600; }
.edit-swatch-note { margin-left: auto; }

/* 自选周次的批量按钮与 1-20 格 */
.edit-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.edit-chip {
  padding: 6rpx 18rpx; font-size: 22rpx; color: var(--text-2, #6b5d57);
  background: var(--glass-strong, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-pill, 999rpx);
}
.edit-weeks { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.edit-wk {
  flex: 0 0 auto; width: calc((100% - 72rpx) / 10); height: 44rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 21rpx; color: var(--text-2, #6b5d57);
  background: var(--glass-strong, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-chip, 12rpx);
}
.edit-wk-on { color: #fff; background: rgba(196,28,35,0.88); border-color: rgba(255,255,255,0.30); font-weight: 700; }
.edit-wk-off { opacity: 0.38; }

/* 色块：实色在内联样式里（数据驱动），选中态加一圈白 + 品牌红描边 */
.edit-swatches { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.edit-swatch {
  width: 58rpx; height: 58rpx; border-radius: var(--r-chip, 12rpx);
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  background: var(--blk-solid, rgba(148,134,127,0.55));
}
.edit-swatch-on { box-shadow: 0 0 0 4rpx #fff, 0 0 0 7rpx var(--brand, #c41c23); }

/* 迷你课表预览：7 列 × 6 行，格与块都由数据决定（只画正在编辑的这节课） */
.edit-mini { padding: 20rpx 0 0; }
.edit-mini-grid { display: flex; gap: 4rpx; }
.edit-mini-col { flex: 1 1 0%; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.edit-mini-th {
  height: 34rpx; display: flex; align-items: center; justify-content: center;
  font-size: 18rpx; color: var(--brand-deep, #8c1614); font-weight: 700;
}
.edit-mini-cell {
  height: 30rpx; border-radius: 4rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-drop, rgba(92,28,26,0.13));
}
.edit-mini-block {
  background: var(--blk-tint, rgba(255,255,255,0.72));
  border: 0; border-left: 4rpx solid var(--blk-solid, rgba(148,134,127,0.55));
}
.edit-mini-note { margin-top: 16rpx; }

/* 底部动作：保存（品牌红）→ 删除这节课（琥珀）→ 取消（下划线文字） */
.edit-save { margin-top: 40rpx; }
.edit-delete {
  margin-top: 24rpx; box-shadow: none;
  color: var(--warn, #9a5b1e); background: var(--warn-soft, rgba(255,244,228,0.86));
  border-color: var(--warn-line, rgba(214,160,90,0.55));
}
.edit-cancel {
  margin-top: 24rpx; text-align: center; color: var(--text-3, #94867f); font-size: 26rpx;
  text-decoration: underline; text-decoration-color: rgba(148,134,127,0.5);
}
.edit-footnote { color: var(--text-3, #94867f); font-size: 23rpx; margin-top: 20rpx; }
