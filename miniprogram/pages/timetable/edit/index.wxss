/* 课程表单样式：字段清晰，待核对原文单独展示。 */
.edit-block { margin-top: 40rpx; }
.edit-copy { color: #576c63; font-size: 28rpx; margin-top: 12rpx; }
.edit-error { background: #f8efe2; color: #7a4a12; border-radius: 14rpx; padding: 20rpx 24rpx; font-size: 27rpx; line-height: 1.7; margin: 20rpx 0; }
.edit-raw { background: #f4f7f5; color: #576c63; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 23rpx; margin: 20rpx 0 8rpx; word-break: break-all; }
.edit-warning { background: #f8efe2; color: #9a5b1e; border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 24rpx; margin-bottom: 12rpx; }
.edit-field { margin-top: 24rpx; }
.edit-label { color: #547367; font-size: 24rpx; margin-bottom: 8rpx; }
.edit-input { background: #fff; border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 28rpx; }
.edit-picker { background: #fff; border-radius: 14rpx; padding: 22rpx; font-size: 28rpx; margin-top: 16rpx; }
.edit-note { color: #6b7f76; font-size: 24rpx; line-height: 1.8; margin-top: 28rpx; }
.edit-delete { background: #f8efe2; color: #9a5b1e; }
.edit-secondary { background: #eef5f1; color: #23664e; }
.edit-footnote { color: #6b7f76; font-size: 23rpx; margin-top: 20rpx; }
