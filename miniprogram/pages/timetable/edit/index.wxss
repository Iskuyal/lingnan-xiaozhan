.edit-block { margin-top:24rpx; }
.edit-copy { margin-top:12rpx; color:var(--text-2, #6b5d57); font-size:25rpx; line-height:1.7; }
.edit-error { margin-top:12rpx; padding:14rpx; border-left:6rpx solid var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); font-size:22rpx; line-height:1.65; }
.edit-heading { margin:2rpx 0 14rpx; padding-left:18rpx; position:relative; }
.edit-heading::before { content:""; position:absolute; left:0; top:3rpx; width:8rpx; height:58rpx; background:var(--gold, #c69a28); }
.edit-heading .section-title { margin:0; font-size:34rpx; line-height:1.35; color:var(--brand-deep, #8c1614); }
.edit-group { margin-top:16rpx; padding:22rpx; border:1rpx solid rgba(43,36,34,0.15); background:rgba(255,255,255,0.5); }
.edit-group .section-head { margin:0 0 15rpx; }
.edit-group-title { color:var(--brand-deep, #8c1614); font-size:27rpx; font-weight:700; }
.edit-field { margin-top:15rpx; }
.edit-field-last { padding-bottom:2rpx; }
.edit-label { margin-bottom:8rpx; color:var(--text-2, #6b5d57); font-size:24rpx; }
.edit-input {
  min-height:84rpx; padding:12rpx 15rpx; border:1rpx solid rgba(43,36,34,0.2);
  background:var(--paper, #fdf7f5); color:var(--text, #2b2422); font-size:23rpx;
}
.edit-input-row { display:flex; align-items:center; gap:8rpx; }
.edit-input-num { width:88rpx; min-width:88rpx; padding:10rpx 6rpx; text-align:center; }
.edit-unit { color:var(--text-2, #6b5d57); font-size:21rpx; }
.edit-unit-to { margin:0 2rpx; color:var(--text-3, #746760); font-size:19rpx; }
.edit-hint,.edit-quiet { margin-top:7rpx; color:var(--text-3, #746760); font-size:19rpx; line-height:1.6; }
.edit-hint-warn { color:var(--warn, #9a5b1e); }
.edit-callout { margin:10rpx 0 14rpx; padding:13rpx 14rpx; border-left:6rpx solid var(--warn, #9a5b1e); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); font-size:21rpx; line-height:1.65; }
.edit-callout-strong { font-weight:700; }
.edit-callout-raw { margin-top:6rpx; color:var(--text-2, #6b5d57); font-size:19rpx; word-break:break-all; }
.edit-pills { display:flex; flex-wrap:wrap; gap:7rpx; }
.edit-pill {
  min-width:84rpx; min-height:84rpx; padding:8rpx 12rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(43,36,34,0.16);
  background:transparent; color:var(--text-2, #6b5d57); font-size:19rpx; text-align:center;
}
.edit-pill-on { border-color:var(--brand, #c41c23); background:var(--brand, #c41c23); color:#fff; }
.edit-pills-mid { align-items:center; }
.edit-swatch-note { margin-left:auto; }
.edit-chips { display:flex; flex-wrap:wrap; gap:7rpx; margin-top:8rpx; }
.edit-chip { min-height:72rpx; padding:8rpx 14rpx; display:flex; align-items:center; border:1rpx solid rgba(43,36,34,0.17); color:var(--brand-ink, #7a1a12); font-size:18rpx; }
.edit-weeks { display:flex; flex-wrap:wrap; gap:5rpx; margin-top:9rpx; }
.edit-wk { width:84rpx; height:84rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(43,36,34,0.15); color:var(--text-2, #6b5d57); font-size:20rpx; }
.edit-wk-on { border-color:rgba(198,154,40,0.65); background:rgba(198,154,40,0.18); color:var(--brand-ink, #7a1a12); }
.edit-wk-off { color:var(--text-3, #746760); background:rgba(43,36,34,0.04); }
.edit-swatches { display:grid; grid-template-columns:repeat(4,1fr); gap:8rpx; margin-top:13rpx; }
.edit-swatch { width:100%; height:84rpx; background:var(--blk-solid, rgba(148,134,127,0.55)); border:2rpx solid rgba(43,36,34,0.12); }
.edit-swatch-on { outline:3rpx solid var(--brand, #c41c23); outline-offset:3rpx; }
.edit-mini { margin-top:10rpx; padding:12rpx; border:1rpx solid rgba(43,36,34,0.14); background:var(--paper, #fdf7f5); }
.edit-mini-grid { display:flex; }
.edit-mini-col { flex:1; min-width:0; border-left:1rpx solid rgba(43,36,34,0.12); }
.edit-mini-th { min-height:36rpx; display:flex; align-items:center; justify-content:center; color:var(--text-3, #746760); font-size:17rpx; }
.edit-mini-cell { height:34rpx; border-top:1rpx solid rgba(43,36,34,0.12); }
.edit-mini-block { background:var(--blk-tint, rgba(255,255,255,0.72)); border-left:4rpx solid var(--blk-solid, rgba(148,134,127,0.55)); }
.edit-mini-note { margin-top:8rpx; }
.edit-save { margin-top:20rpx; }
.edit-delete { margin-top:10rpx; border:1rpx solid var(--warn-line, rgba(214,160,90,0.55)); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); }
.edit-cancel { margin-top:17rpx; color:var(--brand-ink, #7a1a12); font-size:21rpx; text-align:center; }
.edit-footnote { margin-top:14rpx; color:var(--text-3, #746760); font-size:19rpx; line-height:1.6; }
