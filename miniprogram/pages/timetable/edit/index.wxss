/**
 * 课程表单样式：字段清晰，待核对原文单独展示。
 * 液态玻璃——玻璃输入面与金色薄层原文块；错误与警告用琥珀色，不用品牌红。
 */
.edit-block { margin-top: 40rpx; }
.edit-copy { color: var(--text-2, #6b5d57); font-size: 28rpx; margin-top: 12rpx; }
.edit-error { background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e); border-radius: var(--r-control, 20rpx); padding: 20rpx 24rpx; font-size: 27rpx; line-height: 1.7; margin: 20rpx 0; }
.edit-raw {
  color: var(--text-2, #6b5d57); border-radius: var(--r-control, 20rpx); padding: 16rpx 20rpx; font-size: 23rpx; margin: 20rpx 0 8rpx; word-break: break-all;
  background: linear-gradient(150deg, rgba(198,154,40,0.20), rgba(198,154,40,0.09));
  border: 1rpx solid rgba(198,154,40,0.30);
}
.edit-warning { background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e); border-radius: var(--r-control, 20rpx); padding: 14rpx 20rpx; font-size: 24rpx; margin-bottom: 12rpx; }
.edit-field { margin-top: 24rpx; }
.edit-label { color: var(--text-3, #94867f); font-size: 24rpx; margin-bottom: 8rpx; }
.edit-input {
  padding: 20rpx 22rpx; font-size: 28rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-control, 20rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92));
}
.edit-picker {
  padding: 22rpx; font-size: 28rpx; margin-top: 16rpx;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-control, 20rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92));
}
.edit-note { color: var(--text-3, #94867f); font-size: 24rpx; line-height: 1.8; margin-top: 28rpx; }
.edit-delete { background: var(--warn-soft, rgba(255,244,228,0.86)); color: var(--warn, #9a5b1e); }
.edit-secondary { background: var(--glass, rgba(255,255,255,0.52)); color: var(--brand-ink, #7a1a12); border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62)); }
.edit-footnote { color: var(--text-3, #94867f); font-size: 23rpx; margin-top: 20rpx; }
