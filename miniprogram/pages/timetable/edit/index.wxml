<view class="tt2-page edit2-page">
  <view wx:if="{{status === 'loading'}}" class="tt2-state">
    <text class="tt2-state-title">正在读取课程</text>
    <text class="tt2-state-copy">正在从云端读取这门课程…</text>
  </view>

  <view wx:elif="{{status === 'error'}}" class="tt2-state">
    <text class="tt2-state-title">打不开这门课程</text>
    <text class="tt2-state-error">{{errorMessage}}</text>
    <button id="back-from-edit" class="tt2-btn tt2-btn-secondary" hover-class="pressed" bindtap="goBack">返回</button>
  </view>

  <block wx:else>
    <view class="edit2-kicker">课程编辑 · 只改自己的课表</view>
    <view class="edit2-title">{{title}}</view>
    <view class="tt2-muted edit2-intro">修改自己的课表记录，保存后才会生效。</view>

    <!-- 原文与来源只读：识别出的文字不丢，不确定的只标记，不在这里改。 -->
    <view wx:if="{{hasOriginal}}" class="tt2-warn edit2-original">
      <view wx:if="{{calloutText !== ''}}">{{calloutLead}}<text class="edit2-original-strong">原文已保留</text>，保存前请确认</view>
      <view wx:if="{{rawText !== ''}}" class="edit2-original-raw">原文：{{rawText}}</view>
      <view wx:if="{{warningText !== ''}}" class="edit2-original-raw">待核对：{{warningText}}</view>
    </view>

    <view class="edit2-group">
      <view class="edit2-label">课程名称 <text class="edit2-required">必填</text></view>
      <input id="field-name" class="edit2-input {{fieldErrors.name !== '' ? 'invalid' : ''}}" value="{{form.name}}" bindinput="onNameInput" placeholder="例如：高等数学" />
      <view wx:if="{{fieldErrors.name !== ''}}" class="edit2-field-error">{{fieldErrors.name}}</view>
    </view>

    <view class="edit2-group">
      <view class="edit2-label">教师（选填）</view>
      <input id="field-teacher" class="edit2-input" value="{{form.teacher}}" bindinput="onTeacherInput" placeholder="不知道可以留空" />
    </view>

    <view class="edit2-pair">
      <view class="edit2-group">
        <view class="edit2-label">星期</view>
        <picker id="field-weekday" mode="selector" range="{{weekdayLabels}}" value="{{form.weekdayIndex}}" bindchange="onWeekdayChange">
          <view class="edit2-select">{{weekdayLabels[form.weekdayIndex]}} <text class="tt2-caret">▾</text></view>
        </picker>
      </view>
      <view class="edit2-group">
        <view class="edit2-label">节次</view>
        <view class="edit2-section-row">
          <input id="field-start" class="edit2-input edit2-number" type="number" value="{{sectionStartText}}" bindinput="onStartInput" bindblur="onStartCommit" bindconfirm="onStartCommit" />
          <text class="edit2-section-join">到</text>
          <input id="field-end" class="edit2-input edit2-number" type="number" value="{{sectionEndText}}" bindinput="onEndInput" bindblur="onEndCommit" bindconfirm="onEndCommit" />
        </view>
        <view wx:if="{{fieldErrors.sections !== ''}}" class="edit2-field-error">{{fieldErrors.sections}}</view>
        <view wx:else class="edit2-hint">按节次填写；具体时刻只来自作息设置。</view>
      </view>
    </view>

    <view class="edit2-group">
      <view class="edit2-label">上课地点</view>
      <input id="field-location" class="edit2-input" value="{{form.location}}" bindinput="onLocationInput" placeholder="例如：博雅楼 B604" />
      <view wx:if="{{form.location === ''}}" class="edit2-hint">未填写地点；课表上会如实显示未填写，不会编造。</view>
    </view>

    <view id="field-weeks" class="edit2-group">
      <view class="edit2-label">上课周次 · 支持不连续选择</view>
      <view class="edit2-pills">
        <view
          class="edit2-pill {{item.on ? 'on' : ''}}"
          wx:for="{{weeksPills}}"
          wx:key="key"
          data-mode="{{item.key}}"
          bindtap="onWeeksMode"
        >{{item.label}}</view>
      </view>
      <view id="weeks-grid" class="edit2-weeks">
        <view
          id="weeks-all"
          class="edit2-wk edit2-wk-action"
          hover-class="pressed"
          bindtap="onWeeksAll"
        >全选</view>
        <view
          id="weeks-none"
          class="edit2-wk edit2-wk-action"
          hover-class="pressed"
          bindtap="onWeeksNone"
        >清空</view>
        <view
          id="weeks-odd"
          class="edit2-wk edit2-wk-action"
          hover-class="pressed"
          bindtap="onWeeksOdd"
        >取奇</view>
        <view
          id="weeks-even"
          class="edit2-wk edit2-wk-action"
          hover-class="pressed"
          bindtap="onWeeksEven"
        >取偶</view>
        <view
          class="edit2-wk {{item.on ? 'on' : ''}} {{item.outside ? 'outside' : ''}}"
          wx:for="{{weeksGrid}}"
          wx:key="week"
          data-week="{{item.week}}"
          bindtap="onWeeksGridTap"
        >{{item.week}}</view>
      </view>
      <view class="edit2-hint">{{weeksHint}}</view>
      <view wx:if="{{weeksError !== ''}}" class="tt2-warn">{{weeksError}}</view>
    </view>

    <view class="edit2-group">
      <view class="edit2-label">更多信息（选填）</view>
      <input id="field-credits" class="edit2-input edit2-input-gap" value="{{form.credits}}" bindinput="onCreditsInput" placeholder="学分，可不填" />
      <input id="field-note" class="edit2-input" value="{{form.note}}" bindinput="onNoteInput" placeholder="教学班、方向等备注，可不填" />
    </view>

    <view wx:if="{{saveError !== ''}}" class="tt2-warn edit2-save-error">{{saveError}}</view>

    <view class="tt2-actions edit2-actions">
      <button id="save-course" class="tt2-btn tt2-btn-primary" hover-class="pressed" disabled="{{saving}}" bindtap="save">{{errorCount > 0 ? '修正上述 ' + errorCount + ' 项后保存' : (saving ? '正在保存…' : '保存课程')}}</button>
      <button id="delete-course" wx:if="{{deletable}}" class="tt2-btn tt2-btn-danger" hover-class="pressed" bindtap="remove">删除这门课</button>
      <view id="back-from-edit" class="tt2-text-link" hover-class="pressed" bindtap="goBack">取消，返回课表</view>
    </view>
    <view class="tt2-muted edit2-footnote">{{footnote}}</view>
  </block>
</view>
