<view class="page">
  <view wx:if="{{status === 'loading'}}" class="edit-block">
    <view class="section-title">加载中</view>
    <view class="edit-copy">正在读取课程信息…</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="edit-block">
    <view class="section-title">打不开这门课程</view>
    <view class="edit-error">{{errorMessage}}</view>
    <button id="back-from-edit" class="home-button" hover-class="pressed" bindtap="goBack">返回</button>
  </view>

  <block wx:else>
    <view class="eyebrow">按节次保存 · 不填具体时刻</view>
    <view class="section-title">{{title}}</view>

    <view class="edit-raw" wx:if="{{rawText !== ''}}">原始条目：{{rawText}}</view>
    <view class="edit-warning" wx:if="{{warningText !== ''}}">待核对：{{warningText}}</view>

    <view class="edit-field">
      <view class="edit-label">课程名（必填）</view>
      <input id="field-name" class="edit-input" value="{{form.name}}" bindinput="onNameInput" placeholder="例如：高等数学" />
    </view>
    <view class="edit-field">
      <view class="edit-label">教师</view>
      <input id="field-teacher" class="edit-input" value="{{form.teacher}}" bindinput="onTeacherInput" placeholder="不知道可以留空" />
    </view>
    <view class="edit-field">
      <view class="edit-label">地点</view>
      <input id="field-location" class="edit-input" value="{{form.location}}" bindinput="onLocationInput" placeholder="例如：博雅楼-B602-创新实验室" />
    </view>
    <view class="edit-field">
      <view class="edit-label">学分</view>
      <input id="field-credits" class="edit-input" value="{{form.credits}}" bindinput="onCreditsInput" placeholder="可留空" />
    </view>

    <picker id="field-weekday" mode="selector" range="{{weekdayOptions}}" value="{{form.weekdayIndex}}" bindchange="onWeekdayChange">
      <view class="edit-picker">星期：{{weekdayOptions[form.weekdayIndex]}} ▾</view>
    </picker>
    <picker id="field-start" mode="selector" range="{{sectionOptions}}" value="{{form.startIndex}}" bindchange="onStartChange">
      <view class="edit-picker">起始节：{{sectionOptions[form.startIndex]}} ▾</view>
    </picker>
    <picker id="field-end" mode="selector" range="{{sectionOptions}}" value="{{form.endIndex}}" bindchange="onEndChange">
      <view class="edit-picker">结束节：{{sectionOptions[form.endIndex]}} ▾</view>
    </picker>

    <view class="edit-field">
      <view class="edit-label">周次</view>
      <input id="field-weeks" class="edit-input" value="{{form.weeksText}}" bindinput="onWeeksInput" placeholder="如 1-16 或 2-6,8-17；留空表示每周" />
    </view>

    <view class="edit-note">课表按节次展示：学校作息与具体时刻尚未核实，这里不需要也不能填上课时间。写得不认识的周次会保留原文并标注待核对，不会替你做判断。</view>

    <button id="save-course" class="home-button" hover-class="pressed" disabled="{{saving}}" bindtap="save">保存</button>
    <button id="delete-course" wx:if="{{deletable}}" class="home-button edit-delete" hover-class="pressed" bindtap="remove">删除课程</button>
    <button id="back-from-edit" class="home-button edit-secondary" hover-class="pressed" bindtap="goBack">返回</button>
    <view class="edit-footnote" wx:if="{{footnote !== ''}}">{{footnote}}</view>
  </block>
</view>
