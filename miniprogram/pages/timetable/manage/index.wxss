/**
 * 课程管理页面样式（设计图 08）。尺寸按 390px 宽的设计图换算：1rpx = 0.52px。
 * 材质与主页同一套：玻璃面板 + 高斯模糊 + 白描边 + 内高光 + 投影，只改圆角档次。
 * 颜色一律取 app.wxss 的令牌（带回退值）；课程色条的颜色槽 --blk-solid 由数据在内联样式里填，
 * 取值见 services/timetable/palette.ts。待核对一律琥珀，品牌红只用于选中态与主要动作。
 */
.mg-hint { margin-top: 60rpx; }
.mg-hint-copy { color: var(--text-2, #6b5d57); font-size: 28rpx; margin: 16rpx 0; line-height: 1.8; }

/* 顶部玻璃统计卡：三个数字等宽分栏，数字用品牌深红，标签走文字第三级。 */
/* 玻璃配方按 app.wxss 的说明在本页实现——全项目不抽公共 .glass 类，各处圆角档次与不透明度本就不同。 */
.mg-head {
  padding: 28rpx 30rpx;
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.mg-head .eyebrow { color: var(--text-3, #94867f); letter-spacing: 1rpx; }
.mg-stat { display: flex; gap: 40rpx; margin-top: 24rpx; }
.mg-stat-item { flex: 1; min-width: 0; }
.mg-stat-num { color: var(--brand-deep, #8c1614); font-size: 40rpx; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.2; }
.mg-stat-label { color: var(--text-3, #94867f); font-size: 23rpx; }

/* 筛选 pills：数字来自当前数据，选中态是品牌红的实底。 */
.mg-pills { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }
.mg-pill {
  padding: 8rpx 22rpx; font-size: 24rpx; color: var(--brand-ink, #7a1a12);
  border-radius: var(--r-pill, 999rpx);
  background: rgba(255,255,255,0.72);
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
}
.mg-pill-on { color: #fff; background: rgba(196,28,35,0.90); border-color: rgba(255,255,255,0.32); font-weight: 600; }

/* 列表：承载长文本，用 strong 面；行与行之间一条白分割线。 */
.mg-list {
  margin-top: 24rpx; overflow: hidden;
  background: var(--glass-strong, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-card, 24rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.mg-row { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 24rpx; position: relative; }
.mg-row + .mg-row { border-top: 1rpx solid var(--glass-divide, rgba(255,255,255,0.70)); }
.mg-row-on { background: rgba(196,28,35,0.05); }

/* 勾选圈：未勾选时描边压到文字第三级，否则在玻璃面上是「白描白」，看不出还能勾。 */
.mg-check {
  flex: 0 0 36rpx; width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 2rpx solid var(--text-3, #94867f);
  background: rgba(255,255,255,0.80);
  color: #fff; font-size: 23rpx; line-height: 32rpx; text-align: center;
}
.mg-check-on { background: rgba(196,28,35,0.92); border-color: rgba(255,255,255,0.40); }

.mg-bar { flex: 0 0 6rpx; height: 65rpx; border-radius: var(--r-pill, 999rpx); background: var(--blk-solid, rgba(148,134,127,0.55)); }
.mg-main { flex: 1; min-width: 0; }
.mg-name { font-size: 28rpx; font-weight: 600; }
.mg-sub { color: var(--text-2, #6b5d57); font-size: 23rpx; margin-top: 4rpx; }

.mg-chip {
  display: inline-block; font-size: 20rpx; font-weight: 400; border-radius: var(--r-pill, 999rpx);
  padding: 2rpx 12rpx; margin-left: 10rpx; vertical-align: 2rpx;
}
.mg-chip-review { color: var(--warn, #9a5b1e); background: var(--warn-soft, rgba(255,244,228,0.86)); }
.mg-chip-plain { color: var(--text-2, #6b5d57); background: rgba(255,255,255,0.75); }

/* 空态：没有课程与筛选后为空共用版式，文案由模板区分。 */
.mg-empty {
  margin-top: 24rpx; padding: 32rpx 30rpx;
  background: var(--glass, rgba(255,255,255,0.52));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92));
}
.mg-empty-title { font-size: 36rpx; font-weight: 700; color: var(--brand-deep, #8c1614); }
.mg-empty-copy { color: var(--text-2, #6b5d57); font-size: 26rpx; line-height: 1.8; margin-top: 12rpx; }
.mg-empty-btn { margin-top: 32rpx; }

/* 底部动作条：固定在底部，先写后果（quiet）再给两个动作。
   固定它是因为 45 门课要滑很久才到页尾，而删除是这一页的主要用途。 */
.mg-actions {
  position: fixed; left: 36rpx; right: 36rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); z-index: 20;
  padding: 28rpx 30rpx;
  background: var(--glass, rgba(255,255,255,0.52));
  -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
  backdrop-filter: blur(var(--glass-blur, 16px));
  border: 1rpx solid var(--glass-line, rgba(255,255,255,0.62));
  border-radius: var(--r-panel, 32rpx);
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92)), 0 16rpx 40rpx var(--glass-drop, rgba(92,28,26,0.13));
}
.mg-quiet { color: var(--text-3, #94867f); font-size: 23rpx; line-height: 1.7; }
.mg-btn-row { display: flex; gap: 20rpx; margin-top: 15rpx; }
.mg-btn {
  flex: 1; margin: 0; padding: 24rpx 0; font-size: 28rpx; font-weight: 600; line-height: 1.4; text-align: center;
  color: #fff; border-radius: var(--r-pill, 999rpx); border: 1rpx solid rgba(255,255,255,0.30);
  background: linear-gradient(150deg, rgba(196,28,35,0.95) 0%, rgba(140,22,20,0.92) 100%);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.42), 0 16rpx 40rpx var(--glass-drop-strong, rgba(140,22,20,0.26));
}
.mg-btn-secondary {
  color: var(--brand-ink, #7a1a12); background: var(--glass, rgba(255,255,255,0.52));
  border-color: var(--glass-line, rgba(255,255,255,0.62));
  box-shadow: inset 0 2rpx 0 var(--glass-edge, rgba(255,255,255,0.92));
}
.mg-btn-warn { color: var(--warn, #9a5b1e); background: var(--warn-soft, rgba(255,244,228,0.86)); border-color: var(--warn-line, rgba(214,160,90,0.55)); box-shadow: none; }
.mg-btn[disabled] { opacity: 0.5; }

/* 动作条固定时给页面留出让位空间，页尾的「返回课表」不会被压住。 */
.mg-page-bar { padding-bottom: calc(300rpx + env(safe-area-inset-bottom)); }
.mg-back { margin-top: 32rpx; text-align: center; }
.mg-back-text { color: var(--text-3, #94867f); font-size: 25rpx; text-decoration: underline; }
