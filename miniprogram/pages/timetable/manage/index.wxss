.mg-page-bar { padding-bottom:210rpx; }
.mg-hint { margin-top:24rpx; }
.mg-hint-copy { margin-top:12rpx; color:var(--text-2, #6b5d57); font-size:24rpx; line-height:1.7; }
.mg-head { margin:2rpx 0 15rpx; display:flex; align-items:stretch; gap:13rpx; }
.mg-main-stat { flex:1; min-width:0; display:flex; align-items:center; gap:16rpx; padding:12rpx 16rpx; border-left:7rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9); }
.mg-total-num { color:var(--brand-deep, #8c1614); font-size:58rpx; line-height:1; font-weight:700; }
.mg-total-copy { min-width:0; }
.mg-total-label { color:var(--text, #2b2422); font-size:22rpx; line-height:1.35; font-weight:700; }
.mg-total-term { margin-top:4rpx; color:var(--text-2, #6b5d57); font-size:18rpx; line-height:1.4; }
.mg-stat { min-width:188rpx; display:flex; flex-direction:column; justify-content:center; gap:6rpx; }
.mg-stat-item { min-width:0; display:flex; justify-content:space-between; align-items:center; gap:8rpx; padding:5rpx 0; border-bottom:1rpx solid rgba(43,36,34,0.15); }
.mg-stat-num { color:var(--brand-deep, #8c1614); font-size:25rpx; line-height:1.2; font-weight:700; }
.mg-stat-label { color:var(--text-2, #6b5d57); font-size:20rpx; line-height:1.4; }
.mg-pills { display:flex; gap:7rpx; overflow-x:auto; margin:14rpx 0 8rpx; }
.mg-pill { flex:none; min-height:84rpx; padding:8rpx 12rpx; display:flex; align-items:center; border:1rpx solid rgba(43,36,34,0.18); color:var(--text-2, #6b5d57); font-size:19rpx; }
.mg-pill-on { border-color:var(--brand, #c41c23); background:var(--brand, #c41c23); color:#fff; }
.mg-list { border-top:1rpx solid rgba(43,36,34,0.15); }
.mg-row { min-height:112rpx; display:flex; align-items:center; gap:13rpx; padding:13rpx 0; border-bottom:1rpx solid rgba(43,36,34,0.15); }
.mg-row-on { background:rgba(198,154,40,0.1); }
.mg-check { width:32rpx; height:32rpx; flex:none; display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(43,36,34,0.3); color:#fff; font-size:19rpx; }
.mg-check-on { border-color:var(--brand, #c41c23); background:var(--brand, #c41c23); }
.mg-bar { width:6rpx; height:74rpx; flex:none; background:var(--blk-solid, rgba(148,134,127,0.55)); }
.mg-main { flex:1; min-width:0; }
.mg-name { color:var(--text, #2b2422); font-size:22rpx; line-height:1.5; font-weight:700; }
.mg-sub { margin-top:4rpx; color:var(--text-2, #6b5d57); font-size:20rpx; line-height:1.5; }
.mg-chip { margin-left:6rpx; padding:2rpx 6rpx; border:1rpx solid rgba(43,36,34,0.16); font-size:16rpx; }
.mg-chip-review { border-color:var(--warn-line, rgba(214,160,90,0.55)); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); }
.mg-chip-plain { color:var(--brand-ink, #7a1a12); }
.mg-empty { margin-top:28rpx; padding:20rpx; border-left:6rpx solid var(--gold, #c69a28); background:var(--paper-shade, #faeee9); }
.mg-empty-title { color:var(--brand-deep, #8c1614); font-size:27rpx; font-weight:700; }
.mg-empty-copy { margin-top:7rpx; color:var(--text-2, #6b5d57); font-size:22rpx; line-height:1.7; }
.mg-empty-btn { margin-top:12rpx; }
.mg-actions {
  position:fixed; left:0; right:0; bottom:0; z-index:5;
  padding:14rpx 36rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top:1rpx solid rgba(43,36,34,0.18); background:var(--paper, #fdf7f5);
}
.mg-quiet { margin-bottom:8rpx; color:var(--text-2, #6b5d57); font-size:19rpx; line-height:1.55; }
.mg-btn-row { display:flex; gap:10rpx; }
.mg-btn { flex:1; min-height:72rpx; padding:12rpx; border:1rpx solid rgba(43,36,34,0.18); color:var(--brand-ink, #7a1a12); font-size:20rpx; font-weight:700; }
.mg-btn-warn { border-color:var(--warn-line, rgba(214,160,90,0.55)); background:var(--warn-soft, rgba(255,244,228,0.86)); color:var(--warn, #9a5b1e); }
.mg-btn-secondary { background:transparent; }
.mg-back { margin-top:20rpx; color:var(--brand-ink, #7a1a12); text-align:center; font-size:21rpx; }
.mg-back-text { color:inherit; }
