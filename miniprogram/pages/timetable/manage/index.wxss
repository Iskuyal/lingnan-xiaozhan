.mg-hint,.mg-empty { padding-top:36px; }
.mg-hint-copy,.mg-empty-copy { margin-top:14px; color:#6b5d57; font-size:13px; line-height:1.9; }
.mg-empty-title { font-size:22px; font-weight:700; }
.mg-head { margin-bottom:18px; }
.mg-main-stat { display:flex; gap:12px; align-items:baseline; }
.mg-total-num { font-size:28px; font-weight:700; }
.mg-total-copy { flex:1; }
.mg-total-label { font-size:15px; font-weight:600; }
.mg-total-term { margin-top:5px; color:#746760; font-size:11px; }
.mg-stat { display:flex; gap:12px; margin-top:16px; }
.mg-stat-item { flex:1; min-width:0; padding:12px 8px; border:1px solid #ded4cf; border-radius:8px; background:#fff; }
.mg-stat-num { font-size:19px; font-weight:600; color:#8c1614; }
.mg-stat-label { margin-top:5px; color:#746760; font-size:11px; }
.mg-pills { display:flex; flex-wrap:wrap; gap:8px; margin:18px 0; }
.mg-pill { min-height:44px; padding:10px 14px; border:1px solid #aa9990; border-radius:8px; background:#fff; font-size:12px; }
.mg-pill-on { color:#fff; background:#8c1614; border-color:#8c1614; }
.mg-row { display:flex; gap:10px; padding:15px; margin-top:12px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.mg-row-on { border-color:#8c1614; background:#faeee9; }
.mg-check { flex:none; width:22px; height:22px; border:1px solid #aa9990; border-radius:50%; color:#fff; font-size:13px; line-height:20px; text-align:center; margin-top:3px; }
.mg-check-on { background:#8c1614; border-color:#8c1614; }
.mg-bar { display:none; }
.mg-main { flex:1; min-width:0; }
.mg-name { font-size:15px; font-weight:600; line-height:1.6; }
.mg-sub { margin-top:7px; color:#746760; font-size:12px; line-height:1.8; }
.mg-chip { margin-left:6px; color:#9a5b1e; font-size:10px; }
.mg-chip-plain { color:#746760; }
.mg-row-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:12px; }
.mg-row-action { flex:none; min-width:64px; min-height:44px; padding:10px 12px; border:1px solid #b9847c; border-radius:7px; color:#8c1614; background:#fff; font-size:13px; }
.mg-actions { margin-top:22px; padding-top:16px; border-top:1px solid #ded4cf; }
.mg-quiet { color:#746760; font-size:11px; line-height:1.8; }
.mg-btn-row { display:flex; gap:10px; margin-top:12px; }
.mg-btn { flex:1; width:100%; min-width:0; min-height:48px; padding:12px; border-radius:8px; background:#c41c23; color:#fff; font-size:14px; }
.mg-btn-secondary { border:1px solid #b9847c; background:#fff; color:#8c1614; }
.mg-empty-btn { margin-top:16px; }
.mg-back { min-height:44px; margin-top:16px; padding:12px; text-align:center; color:#8c1614; font-size:13px; }
