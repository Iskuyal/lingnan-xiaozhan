@import "../../ui/study/study.wxss";

/* Project-defense page styles (design 31-35, 42, 56-62, 77/78).
   Shared pieces use u2- from styles/ui.wxss and st- from ui/study/study.wxss;
   only the shapes unique to this page live here under the df- prefix. */

.df-screen { padding-bottom: calc(20px + env(safe-area-inset-bottom)); }
.df-screen-dock { padding-bottom: 0; }

.df-gap { margin-top: 14px; }
.df-gap-sm { margin-top: 10px; }
.df-gap-xs { margin-top: 4px; }

.df-row-between { display: flex; align-items: center; justify-content: space-between; gap: 10px; }

.df-em { color: var(--text, #2b2422); font-weight: 650; }

/* 78 copied state */
.df-result-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  margin-bottom: 18px;
  border-radius: 50%;
  background: var(--success-soft, #e8f3f0);
  color: var(--success, #147a70);
  font-size: 22px;
  line-height: 1;
}

/* 77 record cards */
.df-record + .df-record { margin-top: 14px; }
.df-record-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.df-record-label {
  margin: 15px 0 6px;
  color: var(--brand, #c41c23);
  font-size: 11px;
  font-weight: 650;
  line-height: 1.6;
}
.df-record-text { display: block; color: var(--text, #2b2422); font-size: 13px; line-height: 1.85; white-space: pre-wrap; word-break: break-word; }
.df-record-line { display: block; padding: 14px 0 0; margin-top: 14px; border-top: 1px solid var(--line-soft, #ececef); }
.df-record-line-head { display: block; color: var(--text, #2b2422); font-size: 13px; font-weight: 650; line-height: 1.7; }

/* 31 material options */
.df-options { margin-top: 4px; }
/* `.material` is also the selector the repo's e2e verifier hooks onto; keep it on
   the option card and give it the same minimum height the card had before. */
.material { min-height: 120px; }
.df-option { margin-top: 14px; border: 1px solid #e0e1e6; }
.df-option-on { border-color: #d98287; background: #fffafa; }
.df-option-head { display: flex; align-items: flex-start; gap: 10px; }
.df-option-pick { flex: none; color: var(--brand, #c41c23); font-size: 13px; line-height: 1.7; }
.df-option-main { flex: 1; min-width: 0; }
.df-option-name { display: block; color: var(--text, #2b2422); font-size: 16px; font-weight: 650; line-height: 1.55; }
.df-option-kind { display: block; margin-top: 2px; }
.df-option-fact {
  margin-top: 10px;
  padding: 8px 10px;
  border-radius: 8px;
  background: var(--chip, #f0f1f4);
  color: var(--text, #2b2422);
  font-size: 12px;
  line-height: 1.75;
}
.df-option-note { display: block; margin-top: 10px; line-height: 1.75; }
.df-option-link { margin-top: 10px; }

.df-bounds { margin-top: 18px; border-top: 1px solid var(--line-soft, #ececef); }
.df-bounds-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 44px;
  padding: 11px 0;
}
.df-bounds-body { padding-bottom: 12px; }

/* 32 / 56 / 58 practice: progress and question */
.df-track { display: flex; gap: 4px; height: 4px; margin: 14px 0 0; }
.df-track-cell { flex: 1; height: 4px; border-radius: 2px; background: #e8e9ed; }
.df-track-done { background: var(--brand, #c41c23); }

.df-question-card {
  margin-top: 20px;
  padding: 24px;
  border-radius: 18px;
  background: var(--brand, #c41c23);
  color: var(--surface, #ffffff);
}
.df-question-card .u2-xs { color: #ffe1e2; }
.df-question-text { margin-top: 10px; font-size: 21px; font-weight: 650; line-height: 1.7; }

/* 33 pending */
.df-pending { margin-top: 18px; }
.df-pending-head { display: flex; align-items: center; gap: 12px; }
.df-orb {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 11px;
  background: var(--brand, #c41c23);
  color: #ffffff;
  font-size: 16px;
  line-height: 1;
  box-shadow: 0 6px 14px rgba(196, 28, 35, 0.24);
}
.df-pending-main { flex: 1; min-width: 0; }

/* 34 / 35 / 61 feedback blocks */
.df-feedback-block { padding: 16px 0; border-top: 1px solid #e9e9ed; }
.df-feedback-block:first-child { border-top: 0; padding-top: 0; }
.df-feedback-text {
  margin-top: 8px;
  color: var(--text, #2b2422);
  font-size: 13px;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
}
.df-green { color: var(--success, #147a70); }

/* failure keeps the answered text visible and verbatim */
.df-kept { margin-top: 8px; white-space: pre-wrap; word-break: break-word; }

/* 42 in-page material reader overlay */
.df-reader-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  background: rgba(43, 36, 34, 0.36);
}
.df-reader {
  position: absolute;
  top: 4%;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  border-radius: 16px 16px 0 0;
  background: var(--paper, #fdf7f5);
  overflow: hidden;
}
.df-reader-head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 18px 20px 12px;
  background: var(--surface, #ffffff);
  border-bottom: 1px solid var(--line-soft, #ececef);
}
.df-reader-head-main { flex: 1; min-width: 0; }
.df-reader-close {
  flex: none;
  min-width: 52px;
  min-height: 44px;
  padding: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--brand-line, #e8a5a8);
  border-radius: 10px;
  color: var(--brand-deep, #8c1614);
  background: var(--surface, #ffffff);
  font-size: 13px;
  line-height: 1.4;
}
.df-reader-lead { padding: 12px 20px; background: var(--surface, #ffffff); color: var(--text-2, #6b5d57); font-size: 12px; line-height: 1.8; }
.df-reader-index-toggle {
  min-height: 44px;
  padding: 10px 20px;
  border-radius: 0;
  border-bottom: 1px solid var(--line-soft, #ececef);
  background: var(--surface, #ffffff);
  color: var(--brand-deep, #8c1614);
  font-size: 12px;
  line-height: 1.6;
  text-align: left;
}
.df-reader-index { display: flex; flex-wrap: wrap; gap: 6px; padding: 12px 20px; background: var(--surface, #ffffff); }
.df-reader-index-item {
  width: calc((100% - 18px) / 4);
  min-height: 44px;
  padding: 10px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--brand-line, #e8a5a8);
  border-radius: 8px;
  background: var(--surface, #ffffff);
  color: var(--brand-deep, #8c1614);
  font-size: 12px;
  line-height: 1.4;
}
.df-reader-scroll { flex: 1; height: 0; min-height: 0; }
.df-reader-entry { margin: 14px 20px; padding: 16px; border: 1px solid var(--line-soft, #ececef); border-radius: 12px; background: var(--surface, #ffffff); }
.df-reader-ref { display: block; color: var(--brand, #c41c23); font-size: 12px; font-weight: 650; line-height: 1.6; }
.df-reader-body { margin-top: 8px; white-space: pre-wrap; word-break: break-word; }
.df-reader-note { margin: 16px 20px; }
.df-reader-foot {
  padding: 12px 20px calc(14px + env(safe-area-inset-bottom));
  background: var(--surface, #ffffff);
  border-top: 1px solid var(--line-soft, #ececef);
}

/* u2-btn already carries the visual weight; these aliases keep the older
   `.primary` / `.secondary` selectors (used by the verifier scripts) working. */
.primary,
.secondary { display: block; width: 100%; }

@media (max-width: 350px) {
  .df-question-card { padding: 20px; }
  .df-question-text { font-size: 19px; }
  .df-reader-head,
  .df-reader-lead,
  .df-reader-index-toggle,
  .df-reader-index,
  .df-reader-entry,
  .df-reader-note,
  .df-reader-foot { margin-left: 0; margin-right: 0; padding-left: 16px; padding-right: 16px; }
  .df-reader-entry { margin-left: 16px; margin-right: 16px; }
  .df-reader-note { margin-left: 16px; margin-right: 16px; }
}
