.defense { padding:22px 20px calc(34px + env(safe-area-inset-bottom)); }
.defense-title { margin:14px 0 18px; color:#2b2422; font-size:24px; line-height:1.5; font-weight:700; }
.note,.bound { margin-top:14px; padding:14px 15px; border-left:3px solid #ded4cf; background:#fff; font-size:13px; line-height:1.9; color:#6b5d57; }
.bound { padding:10px 15px; }
.card { margin-top:14px; padding:16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.material { min-height:120px; }
.material-selected { border-color:#bdcde0; background:#e9eff6; }
.material-head { display:flex; align-items:flex-start; gap:10px; justify-content:space-between; }
.material-name { flex:1; font-size:16px; font-weight:600; line-height:1.6; }
.pick { flex:none; padding:5px 8px; color:#8c1614; border:1px solid #b9847c; border-radius:6px; font-size:11px; }
.material-selected .pick { color:#fff; background:#8c1614; border-color:#8c1614; }
.chip { display:inline-block; padding:4px 8px; margin:10px 0 4px; border-radius:5px; background:#faeee9; color:#8c1614; font-size:11px; line-height:1.7; }
.chip-warn { color:#78420e; background:#fff4e4; }
.material .chip { display:block; padding:8px 10px; font-size:12px; font-weight:600; }
.fact { margin-top:8px; font-size:12px; color:#6b5d57; line-height:1.9; }
.question { margin-top:18px; padding:16px; background:#fff; border:1px solid #ded4cf; border-radius:10px; }
.question-tag { display:block; font-size:12px; font-weight:600; color:#8c1614; }
.question-text { display:block; margin-top:10px; font-size:15px; line-height:1.9; }
.answer-input { display:block; width:100%; height:180px; margin-top:18px; padding:13px; border:1px solid #aa9990; border-radius:7px; background:#fff; font-size:14px; line-height:1.8; }
.input-foot { display:flex; justify-content:space-between; gap:8px; margin-top:7px; color:#746760; font-size:11px; line-height:1.7; }
.cheat { margin-top:20px; padding-top:14px; border-top:1px solid #bca99d; }
.cheat-title { color:#8c1614; font-size:13px; font-weight:600; }
.cheat-list { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.cheat-chip { min-height:36px; padding:8px 10px; border:1px solid #ded4cf; border-radius:6px; background:#fff; font-size:11px; }
.hint,.fail { margin-top:16px; padding:14px 15px; border-left:3px solid #9a5b1e; background:#fff4e4; color:#78420e; font-size:13px; line-height:1.9; }
.primary,.secondary { display:block; width:100%; max-width:none; min-height:48px; padding:12px 16px; margin-top:16px; border-radius:8px; background:#c41c23; color:#fff; font-size:15px; line-height:1.6; font-weight:600; text-align:center; }
.secondary { color:#8c1614; background:#fff; border:1px solid #b9847c; font-size:13px; }
.pending { margin-top:20px; padding:20px 16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.pending-title,.frame-title,.ask-label,.dim-name,.fail-title { display:block; font-size:15px; line-height:1.8; font-weight:600; color:#2b2422; }
.pending-body,.frame-body,.ask-text,.dim-body,.fail-body,.kept-text { display:block; margin-top:10px; font-size:14px; line-height:1.9; white-space:pre-wrap; }
.pending-foot,.dim-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; font-size:12px; color:#746760; }
.progress { height:4px; margin-top:18px; overflow:hidden; border-radius:3px; background:#faeee9; }
.progress-bar { width:42%; height:4px; background:#c41c23; }
.ask { margin-top:18px; padding:16px; background:#e9eff6; border:1px solid #bdcde0; border-radius:10px; }
.frame-title { color:#8c1614; }
.dim-head { margin-top:0; }
.dim-body { font-size:13px; color:#6b5d57; }
.reader-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:80; background:rgba(43,36,34,.36); }
.reader-panel { position:absolute; top:5%; right:0; bottom:0; left:0; display:flex; flex-direction:column; background:#fdf7f5; border-radius:16px 16px 0 0; overflow:hidden; }
.reader-head { display:flex; align-items:flex-start; gap:12px; padding:18px 20px 12px; background:#fff; border-bottom:1px solid #ded4cf; }
.reader-head>view { flex:1; min-width:0; }
.reader-title { font-size:18px; font-weight:700; line-height:1.6; }
.reader-close { flex:none; width:52px; min-height:44px; padding:10px; border:1px solid #b9847c; color:#8c1614; background:#fff; font-size:13px; }
.reader-index { display:flex; flex-wrap:wrap; gap:6px; padding:12px 20px; background:#fff; }
.reader-index-toggle { flex:none; min-height:44px; padding:10px 20px; background:#fff; color:#8c1614; font-size:12px; text-align:left; border-radius:0; border-bottom:1px solid #ded4cf; }
.reader-index-item { width:calc((100% - 18px) / 4); min-height:44px; padding:10px 4px; border:1px solid #b9847c; border-radius:6px; background:#fff; color:#8c1614; font-size:12px; }
.reader-scroll { flex:1; height:0; min-height:0; }
.reader-note { margin:16px 20px; padding:14px 15px; border-left:3px solid #9a5b1e; background:#fff4e4; color:#78420e; font-size:12px; line-height:1.9; }
.reader-entry { margin:14px 20px; padding:16px; border:1px solid #ded4cf; border-radius:10px; background:#fff; }
.reader-entry-head { font-size:15px; font-weight:600; line-height:1.8; }
.reader-entry-body { margin-top:10px; font-size:13px; line-height:1.9; word-break:break-all; }
.reader-footer { padding:12px 20px calc(16px + env(safe-area-inset-bottom)); background:#fff; border-top:1px solid #ded4cf; }
.reader-footer .primary { margin-top:0; }
@media(max-width:350px) { .defense { padding-left:16px; padding-right:16px; } .reader-head,.reader-index,.reader-footer { padding-left:16px; padding-right:16px; } }
