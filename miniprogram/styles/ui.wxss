button { min-width:0; max-width:100%; box-sizing:border-box; border-radius:8px; }
input,textarea { box-sizing:border-box; color:var(--text, #2b2422); font-size:14px; }
.page { min-height:100vh; padding:22px 20px calc(34px + env(safe-area-inset-bottom)); }
.ui-icon { flex:none; display:block; width:24px; height:24px; }
.ui-sr-only { position:absolute; width:1px; height:1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); }
.eyebrow,.quiet { color:var(--text-3, #746760); font-size:12px; line-height:1.75; }
.section-title { color:var(--text, #2b2422); font-size:17px; line-height:1.5; font-weight:700; }
.section-head { display:flex; align-items:baseline; justify-content:space-between; margin:24px 0 12px; gap:8px; }
.section-note { color:var(--text-3, #746760); font-size:11px; }
.section-bar { display:none; }
.home-button { display:block; width:100%; max-width:none; min-height:48px; margin:16px 0 0; padding:12px 16px; border-radius:8px; background:var(--brand, #c41c23); color:#fff; font-size:15px; line-height:1.6; font-weight:600; text-align:center; }
.home-button.secondary,.source-button { background:var(--surface, #ffffff); color:var(--brand-deep, #8c1614); border:1px solid #b9847c; }
.source-button { display:block; width:100%; min-height:48px; margin-top:14px; padding:12px; border-radius:8px; font-size:13px; line-height:1.7; text-align:center; }
.status-page { padding-top:46px; }
.status-title { color:var(--text, #2b2422); font-size:22px; line-height:1.5; margin-bottom:14px; }
.status-copy { color:var(--text-2, #6b5d57); font-size:14px; line-height:1.9; }
.status-note { margin-top:22px; padding:14px 15px; border-left:3px solid var(--line, #ded4cf); background:var(--surface, #ffffff); font-size:13px; }
.pressed { opacity:.72; }
button[disabled] { opacity:.5; }
/* AI 共享组件（设计图 04「AI VISUAL LANGUAGE」）：
   金色只表示「这是 AI 的产出、还没生效」，红色仍只表示学生要做的动作。
   这三个类被首页简报、课表提案卡与备考计划共用，改一处即三处一致。 */
.ai-tag { display:inline-flex; align-items:center; gap:4px; padding:1px 8px; border:1px solid var(--ai-line, #e7d3a0); border-radius:var(--r-pill, 999rpx); background:var(--ai-soft, #fbf4e2); color:var(--ai, #a67f1c); font-size:11px; font-weight:700; line-height:1.6; }
.ai-tag::before { content:""; flex:none; width:6px; height:6px; border-radius:50%; background:var(--ai, #a67f1c); }
.ai-src { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
/* 依据条的「依据 · 已保存课表」由 WXML 写全：WXSS 的 content 里不能出现中文
   （注释外不得有中文，见 tests/wxss.test.cjs），文案也不该散落在样式里。 */
.ai-src-item { padding:1px 7px; border:1px solid var(--line, #ded4cf); border-radius:var(--r-chip, 12rpx); background:var(--surface, #ffffff); color:var(--text-2, #6b5d57); font-size:11px; line-height:1.6; }
.ai-note { margin-top:8px; color:var(--text-3, #746760); font-size:11px; line-height:1.75; }
.ai-card { padding:14px; border:1px solid var(--ai-line, #e7d3a0); border-left:4px solid var(--ai, #a67f1c); border-radius:var(--r-card, 24rpx); background:var(--surface, #ffffff); }

/* ===== 岭南红 v2 共享件（A 维护；前缀 u2- 只服务四个主入口与 A 的页面）=====
   只提供明确前缀的新组件，不重写 B/C 正在用的 .page/.home-button/button 等旧 class。
   所有值取自 docs/design/lingnan-red-2026-11-11（390px 稿按 2rpx = 1px 换算）。 */
.u2-page { min-height:100vh; padding:22px 20px calc(30px + env(safe-area-inset-bottom)); }
.u2-kicker { color:var(--brand, #c41c23); font-size:12px; font-weight:650; line-height:1.7; }
.u2-h1 { margin:6px 0 0; color:var(--text, #2b2422); font-size:29px; line-height:1.35; font-weight:750; letter-spacing:-0.4px; }
.u2-h2 { color:var(--text, #2b2422); font-size:18px; line-height:1.45; font-weight:700; }
.u2-lead { margin-top:10px; color:var(--text-2, #6b5d57); font-size:14px; line-height:1.8; }
.u2-body { color:var(--text, #2b2422); font-size:14px; line-height:1.85; }
.u2-muted { color:var(--text-2, #6b5d57); }
.u2-sm { font-size:12px; line-height:1.75; }
.u2-xs { font-size:11px; line-height:1.7; }
.u2-num { font-variant-numeric:tabular-nums; letter-spacing:-0.4px; }
.u2-section { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:24px 0 12px; min-height:44px; }
.u2-section-first { margin-top:0; }
.u2-section-title { color:var(--text, #2b2422); font-size:18px; line-height:1.45; font-weight:700; }
.u2-section-note { color:var(--text-2, #6b5d57); font-size:11px; }
.u2-text-link { display:flex; align-items:center; justify-content:center; min-height:44px; min-width:44px; color:var(--brand, #c41c23); font-size:13px; }
.u2-card { padding:20px; border-radius:var(--r-hub, 36rpx); background:var(--surface, #ffffff); }
.u2-card-line { border:1px solid var(--line-soft, #ececef); }
.u2-card-inset { padding:14px; border-radius:var(--r-tile, 32rpx); background:var(--canvas, #f5f6f8); }
.u2-card + .u2-card { margin-top:12px; }
.u2-card-title { font-size:15px; line-height:1.5; font-weight:650; }
.u2-card-copy { margin-top:8px; color:var(--text-2, #6b5d57); font-size:13px; line-height:1.8; }
.u2-list { padding:0 16px; border-radius:var(--r-hub, 36rpx); background:var(--surface, #ffffff); }
.u2-row { display:flex; align-items:center; gap:13px; min-height:78px; padding:14px 0; }
.u2-row + .u2-row { border-top:1px solid var(--line-soft, #ececef); }
.u2-row-main { flex:1; min-width:0; }
.u2-row-title { color:var(--text, #2b2422); font-size:15px; line-height:1.5; font-weight:650; }
.u2-row-sub { margin-top:4px; color:var(--text-2, #6b5d57); font-size:12px; line-height:1.65; }
.u2-icon { display:flex; flex:none; align-items:center; justify-content:center; width:44px; height:44px; border-radius:13px; background:var(--brand-soft, #fff0ef); color:var(--brand, #c41c23); font-size:15px; font-weight:700; }
.u2-icon-plain { background:var(--chip, #f0f1f4); color:var(--text-2, #6b5d57); }
.u2-chev { flex:none; color:var(--text-3, #746760); font-size:20px; line-height:1; }
.u2-hero { padding:22px; border-radius:var(--r-hero, 44rpx); background:var(--brand, #c41c23); color:#ffffff; }
.u2-hero-top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
.u2-hero-label { font-size:12px; line-height:1.7; }
.u2-hero-time { margin:16px 0 4px; font-size:36px; line-height:1.2; font-weight:700; letter-spacing:-0.6px; }
.u2-hero-title { margin-top:4px; font-size:20px; line-height:1.4; font-weight:650; }
.u2-hero-meta { margin-top:6px; font-size:12px; line-height:1.7; opacity:.92; }
.u2-hero-foot { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:18px; padding-top:12px; border-top:1px solid #ffffff38; font-size:12px; }
.u2-hero-link { display:flex; align-items:center; min-height:44px; color:#ffffff; font-size:12px; }
.u2-tag { display:inline-flex; align-items:center; min-height:24px; padding:2px 8px; border-radius:6px; background:var(--chip, #f0f1f4); color:var(--text-2, #6b5d57); font-size:11px; line-height:1.5; }
.u2-tag-line { border:1px solid #ffffff70; background:#ffffff12; color:#ffffff; }
.u2-tag-red { background:var(--brand-soft, #fff0ef); color:var(--brand, #c41c23); }
.u2-btn { display:flex; align-items:center; justify-content:center; gap:8px; width:100%; min-height:50px; padding:12px 16px; border:1px solid transparent; border-radius:12px; font-size:15px; line-height:1.5; font-weight:650; text-align:center; }
.u2-btn-primary { background:var(--brand, #c41c23); color:#ffffff; }
.u2-btn-secondary { border-color:var(--line, #ded4cf); background:var(--surface, #ffffff); color:var(--text, #2b2422); }
.u2-btn-soft { background:var(--brand-soft, #fff0ef); color:var(--brand, #c41c23); }
.u2-actions { display:grid; gap:10px; margin:22px 0 12px; }
.u2-notice { padding:14px 15px; border-radius:12px; background:#fff5e8; color:#83501e; font-size:13px; line-height:1.75; }
.u2-notice-info { background:var(--chip, #f0f1f4); color:var(--text-2, #6b5d57); }
.u2-notice-error { background:var(--danger-soft, #fff0ef); color:#a42127; }
.u2-notice-title { font-weight:650; }
.u2-source { margin-top:14px; padding-top:13px; border-top:1px solid var(--line-soft, #ececef); color:var(--text-2, #6b5d57); font-size:12px; line-height:1.8; }
.u2-source-line + .u2-source-line { margin-top:4px; }
.u2-quote { padding:14px 16px; border-left:3px solid var(--control-line, #aa9990); border-radius:0 10px 10px 0; background:var(--canvas, #f5f6f8); color:var(--text-2, #6b5d57); font-size:13px; line-height:1.85; }
.u2-empty { padding:42px 16px 26px; text-align:center; }
.u2-empty-icon { display:flex; align-items:center; justify-content:center; width:82px; height:82px; margin:0 auto 22px; border-radius:24px; background:var(--brand-soft, #fff0ef); color:var(--brand, #c41c23); font-size:30px; }
.u2-empty-title { color:var(--text, #2b2422); font-size:18px; line-height:1.5; font-weight:700; }
.u2-empty-copy { max-width:280px; margin:12px auto 20px; color:var(--text-2, #6b5d57); font-size:13px; line-height:1.85; }
.u2-date-tile { flex:none; width:55px; height:68px; overflow:hidden; border:1px solid var(--line-soft, #ececef); border-radius:13px; background:var(--surface, #ffffff); text-align:center; }
.u2-date-tile-top { padding:3px; background:var(--brand-soft, #fff0ef); color:var(--brand, #c41c23); font-size:10px; line-height:1.5; }
.u2-date-tile-num { font-size:26px; line-height:1.5; font-weight:650; }
.u2-home-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:1px 0 20px; }
.u2-home-head-main { flex:1; min-width:0; }
.u2-home-greet { margin-top:8px; font-size:30px; line-height:1.32; font-weight:750; letter-spacing:-0.6px; }
.u2-quick { display:grid; grid-template-columns:repeat(4, 1fr); gap:6px; margin:18px 0 2px; }
.u2-quick-item { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; min-height:82px; padding:0; font-size:12px; line-height:1.4; color:var(--text, #2b2422); }
.u2-quick-icon { display:flex; align-items:center; justify-content:center; width:46px; height:46px; border:1px solid var(--line-soft, #ececef); border-radius:15px; background:var(--surface, #ffffff); color:var(--brand, #c41c23); font-size:18px; }
.u2-timeline { padding:0 16px; border-radius:var(--r-hub, 36rpx); background:var(--surface, #ffffff); }
.u2-tl-row { display:flex; align-items:flex-start; gap:13px; padding:13px 0; }
.u2-tl-row + .u2-tl-row { border-top:1px solid var(--line-soft, #ececef); }
.u2-tl-time { flex:none; min-width:47px; color:var(--text, #2b2422); font-size:13px; line-height:1.6; font-variant-numeric:tabular-nums; }
.u2-tl-section { display:block; color:var(--text-2, #6b5d57); font-size:10px; }
.u2-tl-track { flex:none; align-self:stretch; width:3px; border-radius:3px; background:#e5c6c5; }
.u2-tl-track-now { background:var(--brand, #c41c23); }
.u2-tl-track-free { background:var(--chip, #f0f1f4); }
.u2-tl-main { flex:1; min-width:0; }
.u2-tl-title { color:var(--text, #2b2422); font-size:15px; line-height:1.55; font-weight:600; }
.u2-tl-detail { margin-top:4px; color:var(--text-2, #6b5d57); font-size:12px; line-height:1.7; }
.u2-badge { display:inline-flex; align-items:center; margin-left:8px; padding:1px 7px; border-radius:999rpx; background:var(--brand-soft, #fff0ef); color:var(--brand, #c41c23); font-size:10px; font-weight:650; line-height:1.6; }
.u2-strip { display:flex; align-items:center; gap:14px; padding:18px; border-radius:var(--r-hub, 36rpx); background:var(--surface, #ffffff); }
.u2-strip-mark { flex:none; width:4px; height:42px; border-radius:4px; background:var(--brand, #c41c23); }
.u2-strip-main { flex:1; min-width:0; }

@media (max-width:350px) { .page { padding-left:16px; padding-right:16px; } .u2-page { padding-left:16px; padding-right:16px; } .u2-h1 { font-size:26px; } .u2-home-greet { font-size:27px; } .u2-card { padding:16px; } .u2-hero { padding:20px; } }