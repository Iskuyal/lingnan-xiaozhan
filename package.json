{
  "name": "wx-match",
  "version": "0.1.0",
  "private": true,
  "description": "校园工具微信小程序",
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cloudfunctions/tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.cjs",
    "verify:wechat": "node scripts/verify-wechat.cjs",
    "verify:goals": "node scripts/verify-goals.cjs",
    "probe:wechat": "node scripts/probe-wechat.cjs",
    "probe:safety-key": "node scripts/probe-safety-key.cjs",
    "probe:ai-window": "node scripts/probe-ai-window.cjs",
    "smoke:ai": "node scripts/smoke-ai.cjs",
    "smoke:settings": "node scripts/smoke-settings.cjs",
    "smoke:ai:vision": "node scripts/smoke-ai-vision.cjs",
    "eval:lost-found": "node scripts/eval-lost-found.cjs",
    "eval:department-rag": "node scripts/eval-department-rag.cjs",
    "eval:advancement": "npm run build && node scripts/eval-advancement-model.cjs",
    "verify:campus-tools": "node scripts/verify-campus-tools.cjs",
    "verify:advancement": "node scripts/verify-advancement-model.cjs",
    "poc:advancement": "npm run build && node scripts/advancement-poc.cjs",
    "check:defense-g0": "node scripts/check-defense-g0.mjs",
    "poc:defense": "node scripts/poc-project-defense.cjs --plan",
    "poc:defense:session": "npm run build && node scripts/poc-project-defense.cjs --session",
    "poc:defense:samples": "npm run build && node scripts/poc-project-defense.cjs --samples",
    "poc:defense:dev": "npm run build && node scripts/poc-project-defense.cjs --samples --set=development",
    "poc:defense:abnormal": "npm run build && node scripts/poc-project-defense.cjs --abnormal",
    "poc:defense:usage": "node scripts/poc-project-defense.cjs --usage"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "miniprogram-api-typings": "5.2.3",
    "miniprogram-automator": "0.12.1",
    "typescript": "5.9.3",
    "wx-server-sdk": "4.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "axios": "0.34.0",
    "qs": "6.16.1",
    "zod": "4.6.6",
    "lodash.set": "npm:set-value@4.1.0",
    "lodash.unset": "4.18.0",
    "miniprogram-automator": {
      "jimp": "1.6.1"
    }
  }
}
