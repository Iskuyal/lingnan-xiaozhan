{
  "name": "wx-match",
  "version": "0.1.0",
  "private": true,
  "description": "校园工具微信小程序",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p cloudfunctions/tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.cjs",
    "verify:wechat": "node scripts/verify-wechat.cjs",
    "probe:wechat": "node scripts/probe-wechat.cjs",
    "smoke:ai": "node scripts/smoke-ai.cjs",
    "smoke:settings": "node scripts/smoke-settings.cjs",
    "smoke:ai:vision": "node scripts/smoke-ai-vision.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "miniprogram-api-typings": "5.2.3",
    "miniprogram-automator": "0.12.1",
    "typescript": "5.9.3",
    "wx-server-sdk": "4.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "axios": "0.33.0",
    "lodash.set": "npm:set-value@4.1.0",
    "lodash.unset": "4.18.0",
    "miniprogram-automator": {
      "jimp": "1.6.1"
    }
  }
}
